const PLAN = D.plan, TOTAL = D.total, CEND = D.contentEnd;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');

/* plates */
const plateEls = {};
for (const p of D.plates) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + p.id;
  d.style.backgroundImage = `url(${p.uri})`;
  d.dataset.bw = p.bw; d.dataset.bh = p.bh;
  stage.appendChild(d); plateEls[p.id] = d;
}
/* overlays (cards) */
const ovlEls = D.overlays.map(o => {
  const d = document.createElement('div'); d.className = 'ovl';
  if (o.bg) d.style.background = o.bg;
  if (o.plate) {
    const b = document.createElement('div'); b.className = 'bgimg';
    const pl = D.plates.find(x => x.id === o.plate);
    b.style.backgroundImage = `url(${pl.uri})`;
    b.style.backgroundSize = pl.bw + 'px ' + pl.bh + 'px';
    b.style.backgroundPosition = '50% 50%';
    d.appendChild(b);
  }
  for (const t of o.texts || []) { const e = mkText(t); e.style.opacity = 1; d.appendChild(e); }
  stage.appendChild(d); return d;
});
function mkText(t) {
  const s = document.createElement('div');
  s.className = 'tx'; s.innerHTML = t.html;
  s.style.fontSize = t.size + 'px'; s.style.color = t.color;
  s.style.fontWeight = t.bold ? 'bold' : 'normal';
  if (t.font) s.style.fontFamily = t.font;
  if (t.spacing) s.style.letterSpacing = t.spacing + 'px';
  if (t.shadow) s.style.textShadow = t.shadow;
  if (t.bottom != null) { s.style.bottom = t.bottom + 'px'; }
  else if (t.y != null) { s.style.top = t.y + 'px'; }
  if (t.anchor === 'c') { s.style.left = t.x + 'px';
    s.style.transform = (t.bottom != null) ? 'translateX(-50%)' : 'translate(-50%,-50%)'; }
  else if (t.anchor === 'r') { s.style.right = (1080 - t.x) + 'px';
    s.style.transform = (t.bottom != null) ? 'translateX(0)' : 'translateY(-50%)'; }
  else { s.style.left = t.x + 'px';
    if (t.bottom == null) s.style.transform = 'translateY(-50%)'; }
  s._t = t;
  return s;
}
const textEls = D.texts.map(t => { const e = mkText(t); stage.appendChild(e); return e; });
const imgEls = (D.imgs || []).map(o => {
  const i = document.createElement('img'); i.className = 'wm'; i.src = o.uri;
  i.style.left = o.x + 'px'; i.style.top = o.y + 'px'; i.style.width = o.w + 'px';
  i._t = o; stage.appendChild(i); return i;
});
/* plate caption (chunk captions on a dark plate — the published
   treatment of the plate-era pieces, reproduced faithfully) */
let capEl = null, capIdx = -1;
if (D.platecap) {
  capEl = document.createElement('div'); capEl.id = 'platecap';
  const pc = D.platecap;
  capEl.style.left = pc.x + 'px'; capEl.style.width = pc.w + 'px';
  capEl.style.bottom = pc.bottom + 'px'; capEl.style.background = pc.bg;
  stage.appendChild(capEl);
}
function fade(t, w) {
  if (t < w.start || t > w.end) return 0;
  let o = 1;
  if (w.fadeIn) o = Math.min(o, (t - w.start) / w.fadeIn);
  if (w.fadeOut) o = Math.min(o, (w.end - t) / w.fadeOut);
  return Math.max(0, Math.min(1, o));
}
function renderAt(t) {
  /* plates: segments drive zoom/pan; crossfade where a seg asks */
  for (const k in plateEls) plateEls[k].style.opacity = 0;
  let si = -1;
  for (let i = 0; i < D.segs.length; i++)
    if (t >= D.segs[i].start && t < D.segs[i].end) si = i;
  if (si < 0) si = t < D.segs[0].start ? 0 : D.segs.length - 1;
  const seg = D.segs[si];
  const p = Math.min(Math.max((t - seg.start) / Math.max(seg.end - seg.start, 0.01), 0), 1);
  const show = (sg, o) => {
    const el = plateEls[sg.plate]; if (!el) return;
    const z = (sg.z0 + (sg.z1 - sg.z0) * Math.min(Math.max((t - sg.start) / Math.max(sg.end - sg.start, 0.01), 0), 1));
    const bw = parseFloat(el.dataset.bw), bh = parseFloat(el.dataset.bh);
    el.style.backgroundSize = (bw * z) + 'px ' + (bh * z) + 'px';
    const fx = sg.pan ? (sg.pan[0] + (sg.pan[1] - sg.pan[0]) * p) : 0.5;
    el.style.backgroundPosition = (fx * 100) + '% 50%';
    el.style.opacity = o;
    if (!RENDER && o > 0) el.style.pointerEvents = 'auto';
  };
  if (seg.fade && si > 0 && t < seg.start + seg.fade) {
    const u = (t - seg.start) / seg.fade;
    show(D.segs[si - 1], 1 - u); show(seg, u);
  } else show(seg, 1);
  for (const [i, o] of ovlEls.entries()) {
    const w = D.overlays[i];
    o.style.opacity = fade(t, w);
    if (!RENDER && o.style.opacity > 0) o.style.pointerEvents = 'auto';
  }
  for (const e of textEls) e.style.opacity = fade(t, e._t);
  for (const e of imgEls) e.style.opacity = fade(t, e._t);
  if (capEl) {
    const pc = D.platecap;
    let idx = -1;
    for (let i = 0; i < pc.chunks.length; i++)
      if (t >= pc.chunks[i].start && t < CEND) idx = i;
    if (t < pc.chunks[0].start) idx = -1;
    if (idx !== capIdx) {
      capIdx = idx;
      if (idx < 0) { capEl.style.opacity = 0; capEl.innerHTML = ''; }
      else {
        const ch = pc.chunks[idx];
        capEl.style.height = (ch.rows.length * pc.rowH + pc.padV) + 'px';
        capEl.style.paddingTop = pc.padTop + 'px';
        capEl.innerHTML = ch.rows.map((r, ri) =>
          `<div class="row" style="height:${pc.rowH}px${ri === 0 && pc.firstRowDy ? ';margin-top:' + pc.firstRowDy + 'px' : ''}">` +
          r.map(w => `<span style="font-size:${pc.size}px;color:${w.col};font-family:${pc.font}">${w.t}</span>`).join('') +
          `</div>`).join('');
        capEl.style.opacity = 1;
      }
    }
  }
}
window.renderAt = renderAt;

/* hover notes */
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el || !text) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display = 'block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX + 18) + 'px'; tip.style.top = (e.clientY + 16) + 'px'; });
  el.addEventListener('mouseleave', () => tip.style.display = 'none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display = 'block';
    tip.style.left = (e.clientX + 18) + 'px'; tip.style.top = (e.clientY + 16) + 'px'; });
}
for (const p of D.plates) bindNote(plateEls[p.id], (D.notes.plates || {})[p.id]);

/* chrome */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100 * audio.currentTime / TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* production-context panel (from the #decisions block) */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});

</script>
</body>
</html>
