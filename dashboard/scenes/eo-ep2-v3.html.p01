.3, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 11, "start": 43.02, "end": 43.96, "scene": "finale", "words": [{"w": "a", "start": 43.02, "cx": 232.7, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "story", "start": 43.18, "cx": 396.8, "cy": 815, "size": 118, "key": true, "col": "#92400e", "shadow": false}, {"w": "everyone", "start": 43.5, "cx": 704.1, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 11, "start": 43.96, "end": 44.402, "scene": "finale", "words": [{"w": "heard.", "start": 43.96, "cx": 540.0, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 12, "start": 44.86, "end": 45.54, "scene": "finale", "words": [{"w": "Chapter", "start": 44.86, "cx": 411.4, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "two", "start": 45.02, "cx": 647.6, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "of", "start": 45.32, "cx": 776.2, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 12, "start": 45.54, "end": 46.5, "scene": "finale", "words": [{"w": "how", "start": 45.54, "cx": 203.2, "cy": 935, "size": 88, "key": false, "col": "#2b2018", "shadow": false}, {"w": "information", "start": 45.66, "cx": 479.8, "cy": 935, "size": 88, "key": false, "col": "#2b2018", "shadow": false}, {"w": "evolved", "start": 46.16, "cx": 816.6, "cy": 935, "size": 88, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 12, "start": 46.5, "end": 47.62, "scene": "finale", "words": [{"w": "on", "start": 46.5, "cx": 415.1, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "Earth.", "start": 46.76, "cx": 597.8, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 12, "start": 47.62, "end": 48.4, "scene": "finale", "words": [{"w": "Subscribe,", "start": 47.62, "cx": 540.0, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 12, "start": 48.4, "end": 49.02, "scene": "finale", "words": [{"w": "like,", "start": 48.4, "cx": 540.0, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 12, "start": 49.02, "end": 49.941, "scene": "finale", "words": [{"w": "follow", "start": 49.02, "cx": 329.8, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "Earth", "start": 49.42, "cx": 580.5, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "One.", "start": 49.7, "cx": 790.6, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}]};
const PLATE_URIS = {"firewide": "data:image/jpeg;base64,", "hunter": "data:image/jpeg;base64,", "listen": "data:image/jpeg;base64,", "generations": "data:image/jpeg;base64,", "embers": "data:image/jpeg;base64,", "water": "data:image/jpeg;base64,", "finale": "data:image/jpeg;base64,"};
const TL = PLAN.timeline, CEND = PLAN.contentEnd, TOTAL = PLAN.total;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const CUT_T = TL[6][0] + 0.52 * (TL[6][1] - TL[6][0]);

/* ---------- v4 plate grammar (DR-GAP-FLOW) ----------
   Segments own the timeline. A plate's push-in runs on a PLATE-LOCAL
   clock: it accumulates across all of the plate's segments (pauses
   included) and resumes when the plate returns. Segment joins are
   0.4 s dissolves (incoming fades in over the held outgoing plate)
   EXCEPT the L7 transformation, which stays a cut by design:
   dissolve = time passing inside the story's world;
   cut = the world itself changing. */
const SEGS = [
  ['firewide',    0,          TL[1][0],  0],
  ['hunter',      TL[1][0],   TL[3][0],  0.4],
  ['listen',      TL[3][0],   TL[5][0],  0.4],
  ['generations', TL[5][0],   TL[6][0],  0.4],
  ['water',       TL[6][0],   CUT_T,     0.4],
  ['firewide',    CUT_T,      TL[7][0],  0],
  ['embers',      TL[7][0],   TL[10][0], 0.4],
  ['finale',      TL[10][0], TOTAL,     0.4]
];
function segAt(t) {
  for (let i = 0; i < SEGS.length; i++)
    if (t >= SEGS[i][1] && t < SEGS[i][2]) return i;
  return SEGS.length - 1;
}
function plateClock(name, t) {
  let s = 0;
  for (const sg of SEGS) {
    if (sg[0] !== name) continue;
    if (t > sg[1]) s += Math.min(t, sg[2]) - sg[1];
  }
  return s;
}
function plateZoom(name, t) { return 1 + Math.min(0.075, 0.006 * plateClock(name, t)); }

/* ---------- visual storytelling events (DR-GAP-VISUAL) ----------
   Line-scoped plate mood: the picture itself performs the beat.
   generations (L6): brightness dips through the line's middle — the
   hunter dies — and recovers as his knowledge lives.
   embers (L8-L10): the forgetting arc — the plate dims ~22 % across
   L8-L9 as the story fades, then rekindles across L10 to the
   "first backup… hard to kill" close.
   finale (L11-CEND): a gentle dawn lift. All other plates: 1.0. */
function plateMood(name, t) {
  if (name === 'generations') {
    const a = TL[5][0], b = TL[5][1];
    const u = Math.min(Math.max((t - a) / (b - a), 0), 1);
    const v = Math.min(Math.max((u - 0.30) / 0.55, 0), 1);
    return 1 - 0.16 * Math.sin(Math.PI * v);
  }
  if (name === 'embers') {
    const a = TL[7][0], mid = TL[9][0], b = TL[9][1];
    if (t <= mid) return 1 - 0.22 * Math.min(Math.max((t - a) / (mid - a), 0), 1);
    return 0.78 + 0.24 * Math.min(Math.max((t - mid) / (b - mid), 0), 1);
  }
  if (name === 'finale') {
    const a = TL[10][0];
    return 1 + 0.05 * Math.min(Math.max((t - a) / (CEND - a), 0), 1);
  }
  return 1;
}

/* ---------- build elements ---------- */
const plates = {};
for (const name of Object.keys(PLATE_URIS)) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + name;
  d.style.backgroundImage = `url(${PLATE_URIS[name]})`;
  stage.appendChild(d); plates[name] = d;
}
function lineAt(tt) {
  if (tt < TL[0][0]) return 0;
  for (let i = 0; i < 12; i++) {
    const gapEnd = (i < 11) ? TL[i+1][0] : CEND;
    if (tt >= TL[i][0] && tt < gapEnd) return i;
  }
  return 11;
}
const bug = document.createElement('div');
bug.id = 'bug'; bug.textContent = 'EARTH ONE'; bug.style.zIndex = 3;
stage.appendChild(bug);

/* labels (DR-GAP-LABEL): [text, y, size, colour, tOn, tOff, fadeIn, fadeOut]
   — explicit times derived from the v3 progress thresholds; fades, no snaps */
const LABELS4 = [
  ['100,000 YEARS AGO', 420, 84, '#f5efe0', 2.30, 5.47, 0.30, 0.25],
  ['THE RIVER THAT RUNS', 330, 80, '#f5efe0', 6.94, 10.14, 0.30, 0.25],
  ['NOTHING WRITTEN', 420, 84, '#f5efe0', 10.73, 11.32, 0.20, 0.15],
  ['IN EVERY MEMORY', 330, 80, '#f5efe0', 12.59, 14.50, 0.30, 0.25],
  ['TOLD AGAIN. AND AGAIN.', 330, 76, '#f5efe0', 19.41, 22.74, 0.30, 0.25],
  ['A FEW WATCHERS', 330, 80, '#2b2018', 23.19, CUT_T, 0.30, 0.12],
  ['EVERYONE LISTENING', 330, 80, '#f5efe0', CUT_T, 26.72, 0.30, 0.25],
  ['FORGETTING', 360, 88, '#f5efe0', 28.63, 29.22, 0.22, 0.15],
  ['THE FIRST ARCHIVE WAS A BODY.', 400, 72, '#2b2018', 40.71, 44.40, 0.30, 0.25],
  ['THE SECOND: A STORY.', 505, 84, '#92400e', 42.48, 44.40, 0.30, 0.25]
];
const labelEls = LABELS4.map(([text, y, sz, col]) => {
  const d = document.createElement('div');
  d.className = 'label'; d.textContent = text;
  d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
  d.style.zIndex = 4;
  stage.appendChild(d); return d;
});
function labelOpacity(L, t) {
  const a = Math.min(Math.max((t - L[4]) / L[6], 0), 1);
  const b = Math.min(Math.max((L[5] - t) / L[7], 0), 1);
  return a * b;
}

/* words */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = w.size + 'px'; s.style.color = w.col;
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.zIndex = 4;
    /* V-17 BACKING STANDARD (JOB DWELL-CONTRAST-FIX, 2026-10-25): the
       amber accent over a photographic plate measured 1.95–2.28 against
       the 3.0 floor (MEASURE-SWEEP) and no lighter amber passes the
       lightest plate fields — the accent word therefore carries the
       standard chip: rgba(14,10,7,.60) behind the glyphs. Measured
       worst case after treatment: 5.79 (Ep.2 cover field) — margin
       +2.79 over the floor. The ink itself does not change. */
    if (w.col === '#ffb040') {
      s.style.background = 'rgba(14,10,7,.60)';
      s.style.padding = '10px 28px';
      s.style.borderRadius = '34px';
    }
    if (w.shadow) s.style.textShadow = '3px 4px 0 rgba(30,20,14,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}

/* cards */
function makeCard(id, plate, lines) {
  const c = document.createElement('div');
  c.className = 'card'; c.id = id; c.style.zIndex = 5;
  const bg = document.createElement('div');
  bg.className = 'platecard'; bg.style.backgroundImage = `url(${PLATE_URIS[plate]})`;
  c.appendChild(bg);
  /* V-17 BACKING STANDARD (see word creation): amber card lines over
     a plate need the chip. A RUN of adjacent amber lines (the cover's
     two thesis lines sit 105 px apart — closer than one chip's
     height, so per-line pills would overlap and double-darken) gets
     ONE shared chip div behind the whole run, sized from the canvas
     measure of its widest line. A lone amber line gets a pill span. */
  const runs = [];
  lines.forEach((L, i) => {
    if (L[3] !== '#ffb040') return;
    const last = runs[runs.length - 1];
    if (last && i === last.end + 1 && L[1] - lines[last.end][1] < 1.6 * L[2]) last.end = i;
    else runs.push({start: i, end: i});
  });
  const grouped = new Set();
  const cardMeasureCtx = document.createElement('canvas').getContext('2d');
  for (const run of runs) {
    if (run.end === run.start) continue;
    const f = lines[run.start], l = lines[run.end];
    let w = 0;
    for (let i = run.start; i <= run.end; i++) {
      cardMeasureCtx.font = `${lines[i][2]}px "Patrick Hand", cursive`;
      w = Math.max(w, cardMeasureCtx.measureText(lines[i][0]).width);
      grouped.add(i);
    }
    const chip = document.createElement('div');
    chip.style.cssText = 'position:absolute; left:50%; transform:translateX(-50%);' +
      `top:${f[1] - f[2]/2 - 14}px; height:${(l[1] - f[1]) + l[2] + 28}px;` +
      `width:${Math.ceil(w) + 76}px; background:rgba(14,10,7,.60); border-radius:44px;`;
    c.appendChild(chip);
  }
  lines.forEach(([text, y, sz, col], li) => {
    const d = document.createElement('div');
    d.className = 'cardtext';
    d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
    if (col === '#ffb040' && !grouped.has(li)) {
      const s = document.createElement('span');
      s.textContent = text;
      s.style.background = 'rgba(14,10,7,.60)';
      s.style.padding = '8px 34px 12px';
      s.style.borderRadius = '44px';
      d.appendChild(s);
    } else d.textContent = text;
    c.appendChild(d);
  });
  stage.appendChild(c); return c;
}
const openCard = makeCard('opencard','firewide',[
  ['EARTH ONE',700,150,'#f5efe0'],
  ['THE STORY WAS THE',880,92,'#ffb040'],
  ['FIRST BACKUP',985,92,'#ffb040']]);
const endCard = makeCard('endcard','finale',[
  ['FOLLOW FOR THE REST',420,84,'#92400e'],
  ['OF THE STORY',530,84,'#92400e'],
  ['NEXT:',810,72,'#2b2018'],
  ['THE MESSAGE THAT',905,72,'#2b2018'],
  ['OUTLIVED ITS MAKER',1000,72,'#2b2018'],
  ['EARTH ONE',1420,64,'rgba(43,32,24,.86)']]);

/* ---------- the one timeline function: state = f(t) ---------- */
function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const k in plates) { plates[k].style.opacity = 0; plates[k].style.transform = '';
                            plates[k].style.filter = '';
                            plates[k].style.zIndex = 0; plates[k].style.pointerEvents = 'none'; }
  labelEls.forEach(e => { e.style.opacity = 0; e.style.pointerEvents = 'none'; });
  wordEls.forEach(e => e.style.opacity = 0);

  /* plates: active segment, dissolving in over the held outgoing plate */
  const si = segAt(t), sg = SEGS[si];
  const pname = sg[0], s0 = sg[1], din = sg[3];
  let under = null;
  if (din > 0 && t < s0 + din && si > 0 && SEGS[si-1][0] !== pname) under = SEGS[si-1];
  if (under) {
    const up = plates[under[0]];
    up.style.opacity = 1; up.style.zIndex = 1;
    up.style.transform = `scale(${plateZoom(under[0], under[2]).toFixed(4)})`;
    up.style.filter = `brightness(${plateMood(under[0], under[2]).toFixed(3)})`;
  }
  const plate = plates[pname];
  plate.style.opacity = under ? Math.min(1, (t - s0) / din) : 1;
  plate.style.zIndex = 2;
  plate.style.transform = `scale(${plateZoom(pname, t).toFixed(4)})`;
  plate.style.filter = `brightness(${plateMood(pname, t).toFixed(3)})`;
  if (!RENDER) plate.style.pointerEvents = 'auto';

  /* channel bug: fades in as the first line starts, gone on the end card.
     PRIDE FIX (DR-GAP-CHOREO): dark ink on the pale plates (water,
     finale) where cream is near-invisible — those plates appear only
     in the still-open segments, so no rendered segment changes. */
  bug.style.opacity = t < 1.6 ? 0 : (t < CEND ? Math.min(1, (t - 1.6) / 0.35) : 0);
  bug.style.color = (pname === 'water' || pname === 'finale') ? '#2b2018' : '#f5efe0';

  /* labels */
  LABELS4.forEach((L, i) => {
    const o = labelOpacity(L, t);
    labelEls[i].style.opacity = o;
    if (!RENDER && o > 0.5) labelEls[i].style.pointerEvents = 'auto';
  });

  /* opening card (DR-GAP-CARD): in over 0.6 s, OUT 1.15-1.65 s over the
     already-live first scene — the container stays, the snap goes */
  const oc = Math.min(1, t / 0.6) * (1 - Math.min(Math.max((t - 1.15) / 0.5, 0), 1));
  openCard.style.opacity = oc;
  openCard.style.pointerEvents = (!RENDER && oc > 0.5) ? 'auto' : 'none';

  /* end card (DR-GAP-END: 3.4 s hold kept — see record) */
  const ec = t >= CEND ? Math.min(1, (t - CEND) / 0.6) : 0;
  endCard.style.opacity = ec;
  endCard.style.pointerEvents = (!RENDER && ec > 0) ? 'auto' : 'none';

  /* words (DR-GAP-MOTION: easeOut kept, 0.20 s, 12 px rise) */
  if (t >= 1.6 && t < CEND) {
    for (const ph of PLAN.phrases) {
      if (t < ph.start || t >= ph.end) continue;
      ph.words.forEach((w, wi) => {
        const el = ph._els[wi];
        if (t < w.start) return;
        const u = Math.min((t - w.start) / 0.20, 1);
        const e = easeOut(u);
        let s = 0.55 + 0.45 * e;
        if (w.key) { const v = Math.min((t - w.start) / 0.22, 1); s *= 1 + 0.10 * Math.sin(Math.PI * v); }
        let al = Math.min(1, (t - w.start) / 0.08);
        let dy = (1 - e) * 12;
        /* DR-GAP-VISUAL: in L9 the words themselves fade as the line
           plays — "it fades in every head at once" is enacted, not
           just said; L10's words return at full strength against it. */
        const prog9 = Math.min(Math.max((t - ph.start) / Math.max(ph.end - ph.start, 0.01), 0), 1);
        if (ph.line === 9) { al *= 1 - 0.55 * prog9; s *= 1 - 0.18 * prog9; }
        /* DR-GAP-CHOREO: per-word decisions for the open lines
           (L6-L11). Every listed word's behaviour is decided, not
           defaulted; L12 is deliberately left at uniform entrance
           (the flagged CTA line — see the record). */
        const cw = w.w;
        if (ph.line === 6 && cw === 'dies;') { s *= 0.80; dy += 8; al *= 0.70; }
        else if (ph.line === 6 && cw === 'lives.') { s *= 1.18; dy -= 4; }
        else if (ph.line === 7 && cw === 'few.') { s *= 0.78; }
        else if (ph.line === 7 && cw === 'everyone.') { s *= 1.22; }
        else if (ph.line === 8 && cw === 'forgetting.') { al *= 0.75 + 0.25 * Math.sin(t * 30); }
        else if (ph.line === 10 && cw === 'One') { s *= 0.90; }
        else if (ph.line === 10 && cw === 'many,') { s *= 1.25; }
        else if (ph.line === 11 && cw === 'body.') { s *= 0.92; }
        else if (ph.line === 11 && cw === 'story') { s *= 1.15; }
        el.style.opacity = al;
        el.style.transform = `translate(-50%,-50%) translateY(${dy.toFixed(1)}px) scale(${s.toFixed(3)})`;
      });
      break;
    }
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = {"plates": {"firewide": "Scene element \u2014 the fire circle. The story's stage: many listeners around one fire is the copying mechanism itself, drawn. (DR-IMG-1)", "hunter": "Scene element \u2014 the hunter telling. Telling shown as an act: raised arms, listeners turned toward him. The river story lives here. (DR-IMG-2)", "listen": "Scene element \u2014 the listening circle, closer. Every head turned to the teller: hearing = copying, made visible. (DR-IMG-3)", "generations": "Scene element \u2014 generations at the fire. A grey elder, two young listeners: retelling across ages in one frame. (DR-IMG-4)", "water": "Scene element \u2014 Ep.1's waterhole, reused on purpose. The calf watching is the 'few' the story beats. (DR-IMG-5)", "embers": "Scene element \u2014 the dying embers. The villain, Forgetting, gets a face: a fire going out. (DR-IMG-6)", "finale": "Scene element \u2014 the dawn finale. An empty plain at morning: the knowledge now lives in people, not in the picture. (DR-IMG-7)"}, "labels": ["Label \u2014 the time anchor. Earth One states the time out loud in every episode; the label makes it visible.", "Label \u2014 the story's cargo: the river that runs when the others dry. The knowledge the episode exists to save.", "Label \u2014 the world's constraint: no writing exists yet, so the story is the only storage.", "Label \u2014 the mechanism in three words: copied into every memory that hears it.", "Label \u2014 retelling is the maintenance schedule of the first backup.", "Label \u2014 Ep.1's limit, named on Ep.1's own frame: a body teaches only the few who watch.", "Label \u2014 the advance, performed: the same knowledge, now reaching everyone listening.", "Label \u2014 the villain, named late in its beat so the mood turns before the word lands.", "Label \u2014 the bookend, first half: Ep.1's close, quoted.", "Label \u2014 the bookend's twist: a second archive now exists."], "opencard": "Opening card \u2014 channel + episode title. Cards are titles, not subtitles; V-16 bans narration text, not titles. (DR-CARD-1)", "endcard": "End card \u2014 the follow ask in plain words plus the next episode's tease. N-09: the ask is never hidden in metaphor. (DR-CARD-2)"};
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  el.addEventListener('mouseleave', () => tip.style.display='none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const k in NOTES.plates) bindNote(plates[k], NOTES.plates[k]);
labelEls.forEach((e,i)=>bindNote(e, NOTES.labels[i]));
bindNote(openCard, NOTES.opencard); bindNote(endCard, NOTES.endcard);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel (from the #decisions block) ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
