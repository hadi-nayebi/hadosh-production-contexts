: 935, "size": 98, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 10, "start": 57.02, "end": 57.712332999999994, "scene": "finale", "words": [{"w": "the", "start": 57.02, "cx": 279.4453125, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "next", "start": 57.12, "cx": 449.6484375, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "chapter.", "start": 57.28, "cx": 710.203125, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}]};
const PLATE_URIS = {"figureblow": "data:image/jpeg;base64,", "cavewall": "data:image/jpeg;base64,", "hand": "data:image/jpeg;base64,", "carriers": "data:image/jpeg;base64,", "visitors": "data:image/jpeg;base64,", "finale": "data:image/jpeg;base64,"};
const CONFIG = {"sceneForLine": ["figureblow", "cavewall", "carriers", "carriers", "cavewall", "visitors", "cavewall", "visitors", "cavewall", "finale", "finale"], "plateCut": null, "openCard": ["figureblow", [["EARTH ONE", 700, 150, "#f5efe0"], ["THE MESSAGE THAT", 880, 92, "#ffb040"], ["OUTLIVED ITS MAKER", 985, 92, "#ffb040"]], "radial-gradient(ellipse 80% 36% at 50% 43%, rgba(10,6,4,.68), rgba(10,6,4,0) 72%)"], "endCard": ["finale", [["FOLLOW FOR THE REST", 420, 84, "#92400e"], ["OF THE STORY", 530, 84, "#92400e"], ["NEXT:", 810, 72, "#2b2018"], ["A SONG REMEMBERS", 905, 72, "#2b2018"], ["WHAT WORDS FORGET", 1000, 72, "#2b2018"], ["EARTH ONE", 1420, 64, "rgba(43,32,24,.86)"]]], "labels": [[0, "40,000 YEARS AGO", 330, 84, "#f5efe0", "(p,tt,a,b)=>p>0.70"], [4, "IT WAITS IN THE DARK", 330, 76, "#f5efe0", "(p,tt,a,b)=>p>0.30"], [9, "THE FIRST ARCHIVE WAS A BODY.", 400, 72, "#2b2018", "(p,tt,a,b)=>p>0.04"], [9, "THE THIRD: A MARK ON A WALL.", 505, 84, "#92400e", "(p,tt,a,b)=>p>0.50"]], "bugCol": "rgba(245,239,224,.69)", "bugByLine": {}};
const TL = PLAN.timeline, CEND = PLAN.contentEnd, TOTAL = PLAN.total;
const NL = TL.length;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');

const plates = {};
for (const name of Object.keys(PLATE_URIS)) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + name;
  d.style.backgroundImage = `url(${PLATE_URIS[name]})`;
  stage.appendChild(d); plates[name] = d;
}
function plateAt(li, tt) {
  const cut = CONFIG.plateCut;
  if (cut && li === cut.line) {
    const [a, b] = TL[li];
    return tt < a + cut.frac * (b - a) ? cut.before : cut.after;
  }
  return CONFIG.sceneForLine[li];
}
function lineAt(tt) {
  if (tt < TL[0][0]) return 0;
  for (let i = 0; i < NL; i++) {
    const gapEnd = (i < NL - 1) ? TL[i+1][0] : CEND;
    if (tt >= TL[i][0] && tt < gapEnd) return i;
  }
  return NL - 1;
}
const bug = document.createElement('div');
bug.id = 'bug'; bug.textContent = 'EARTH ONE'; stage.appendChild(bug);

const LABELS = CONFIG.labels.map(L => [L[0], L[1], L[2], L[3], L[4], eval(L[5])]);
const labelEls = LABELS.map(([li, text, y, sz, col]) => {
  const d = document.createElement('div');
  d.className = 'label'; d.textContent = text;
  d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
  stage.appendChild(d); return d;
});

const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = w.size + 'px'; s.style.color = w.col;
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    if (w.shadow) s.style.textShadow = '3px 4px 0 rgba(30,20,14,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}

function makeCard(id, plate, lines, scrim) {
  const c = document.createElement('div');
  c.className = 'card'; c.id = id;
  const bg = document.createElement('div');
  bg.className = 'platecard'; bg.style.backgroundImage = `url(${PLATE_URIS[plate]})`;
  c.appendChild(bg);
  if (scrim) {
    const sc = document.createElement('div');
    sc.style.cssText = 'position:absolute; inset:0; background:' + scrim + ';';
    c.appendChild(sc);
  }
  for (const [text, y, sz, col] of lines) {
    const d = document.createElement('div');
    d.className = 'cardtext'; d.textContent = text;
    d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
    c.appendChild(d);
  }
  stage.appendChild(c); return c;
}
const openCard = makeCard('opencard', CONFIG.openCard[0], CONFIG.openCard[1], CONFIG.openCard[2]);
const endCard = makeCard('endcard', CONFIG.endCard[0], CONFIG.endCard[1], CONFIG.endCard[2]);

/* ---- episode-specific element layers (separate components) ---- */

const handEl = document.createElement('div');
handEl.id = 'hand';
handEl.style.cssText = 'position:absolute; left:240px; top:690px; width:600px; height:600px;' +
  'background-size:contain; background-repeat:no-repeat; background-position:center;' +
  'mix-blend-mode:screen; opacity:0; pointer-events:none;';
handEl.style.backgroundImage = `url(${PLATE_URIS['hand']})`;
stage.appendChild(handEl);

/* ---- real-photograph plate (DR-E3-IMG-7): the actual surviving
   hand stencils, framed in the house glass-plate grammar. ---- */
const REAL_URI = "data:image/jpeg;base64,";
const realEl = document.createElement('div');
realEl.id = 'realplate';
realEl.style.cssText = 'position:absolute; left:140px; top:400px; width:800px; padding:18px;' +
  'background:rgba(13,11,9,.88); border:2px solid rgba(103,232,249,.85); border-radius:24px;' +
  'box-shadow:0 18px 50px rgba(0,0,0,.55); opacity:0; pointer-events:none;';
const realImg = document.createElement('div');
realImg.style.cssText = 'width:764px; height:560px; border-radius:12px; background-size:cover;' +
  'background-position:center; box-shadow:inset 0 0 0 2px rgba(255,176,64,.75);';
realImg.style.backgroundImage = `url(${REAL_URI})`;
realEl.appendChild(realImg);
const realCap = document.createElement('div');
realCap.style.cssText = 'margin-top:14px; text-align:center; font-family:\'Patrick Hand\';';
realCap.innerHTML = '<div style="font-size:31px; color:#f5efe0; letter-spacing:1px;">THE REAL WALL — PETTAKERE CAVE, SULAWESI</div>' +
  '<div style="font-size:21px; color:rgba(245,239,224,.62); margin-top:3px;">Photo: Cahyo · CC BY-SA 4.0 · Wikimedia Commons</div>';
realEl.appendChild(realCap);
stage.appendChild(realEl);


function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const k in plates) { plates[k].style.opacity = 0; plates[k].style.transform='';
                            plates[k].style.pointerEvents = 'none'; }
  labelEls.forEach(e => { e.style.opacity = 0; e.style.pointerEvents = 'none'; });
  wordEls.forEach(e => e.style.opacity = 0);
  bug.style.opacity = 0; openCard.style.opacity = 0; endCard.style.opacity = 0;
  openCard.style.pointerEvents = 'none';
  endCard.style.pointerEvents = 'none';
  if (typeof handEl !== 'undefined') { handEl.style.opacity = 0; handEl.style.pointerEvents = 'none'; }
  if (typeof realEl !== 'undefined') { realEl.style.opacity = 0; realEl.style.pointerEvents = 'none'; }
  if (t < 1.6) {
    plates[CONFIG.openCard[0]].style.opacity = 1;
    openCard.style.opacity = Math.min(1, t/0.6);
    if (!RENDER && openCard.style.opacity > 0) openCard.style.pointerEvents = 'auto';
    return;
  }
  if (t >= CEND) {
    plates[CONFIG.endCard[0]].style.opacity = 1;
    endCard.style.opacity = Math.min(1, (t-CEND)/0.6);
    if (!RENDER && endCard.style.opacity > 0) endCard.style.pointerEvents = 'auto';
    return;
  }
  const li = lineAt(t), [a, b] = TL[li];
  const p = Math.min(Math.max((t-a)/Math.max(b-a,0.01),0),1);
  const plate = plates[plateAt(li, t)];
  plate.style.opacity = 1;
  if (!RENDER) plate.style.pointerEvents = 'auto';
  plate.style.transform = `scale(${(1 + 0.055*p).toFixed(4)})`;
  bug.style.opacity = 1;
  bug.style.color = CONFIG.bugByLine[li] || CONFIG.bugCol;
  LABELS.forEach((L, i) => { if (L[0] === li && L[5](p, t, a, b)) {
    labelEls[i].style.opacity = 1;
    if (!RENDER) labelEls[i].style.pointerEvents = 'auto'; } });
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const el = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      const al = Math.min(1, (t - w.start)/0.08);
      el.style.opacity = al;
      el.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    break;
  }
  
  if (typeof handEl !== 'undefined') {
    let ho = 0;
    if (li === 1) ho = Math.min(1, Math.max(0, (t - a) / 0.9));
    else if (li === 4 || li === 6 || li === 8) ho = 1;
    let rp = 0;
    if (li === 1) rp = Math.min(1, Math.max(0, (t - 10.82) / 0.55));
    handEl.style.opacity = ho * (1 - rp);
    handEl.style.pointerEvents = (!RENDER && ho > 0.05 && rp < 0.5) ? 'auto' : 'none';
    if (typeof realEl !== 'undefined') {
      realEl.style.opacity = rp;
      realEl.style.pointerEvents = (!RENDER && rp > 0.5) ? 'auto' : 'none';
      plates.cavewall.style.filter = rp > 0 ? `brightness(${(1 - 0.5 * rp).toFixed(3)})` : '';
    }
  }
  plates.carriers.style.filter = (li === 3) ? 'brightness(0.55)' : 'none';

}
window.renderAt = renderAt;

const NOTES = {"plates": {"figureblow": "Scene plate \u2014 the maker at work: hand pressed to the wall, red dust blown from a hollow bone, torchlight. The act the first line describes, shown not narrated. (DR-E3-IMG-1)", "cavewall": "Scene plate \u2014 the empty cave wall: stone blocks, torches at the edges, a dark alcove at centre where the hand element lives. The stage for the message that waits. (DR-E3-IMG-2)", "carriers": "Scene plate \u2014 the carriers: an elder speaking to huddled listeners around a small fire. Every message before the wall lived in people like these. Dimmed for L4, when the carriers die. (DR-E3-IMG-4)", "visitors": "Scene plate \u2014 the visitors: a child, a hunter with a spear, and an elder before the glowing hand, generations after its maker. The message speaking to strangers. (DR-E3-IMG-5)", "finale": "Scene plate \u2014 the dawn finale, the series bookend world (reused from the Observations finale): an empty plain at morning. The mark joins body and story here. (DR-E3-IMG-6)"}, "labels": ["Label \u2014 the time anchor, appearing as the first line's last words speak it: Earth One states the time out loud in every episode.", "Label \u2014 the wait named: the mark needs nobody and simply waits in the dark.", "Label \u2014 the bookend, first half: Ep.1's close, quoted.", "Label \u2014 the bookend's turn: a third archive now exists."], "extras": {"hand": "Element \u2014 the red hand stencil, a SEPARATE component: generated on its own (on black), screen-blended onto the cave-wall plate. It fades in as the shape that stays (L2) and returns for the wait, the statement, and 'stone does not forget.' At L2's final sentence it fades as the real photograph takes the frame (DR-E3-IMG-7). (DR-E3-IMG-3)", "realplate": "Element — the REAL hand stencils: a photograph of the Pettakere Cave wall, Maros, Sulawesi (Cahyo, CC BY-SA 4.0, Wikimedia Commons), framed as a glass plate. It takes the frame at L2\u2019s \u2018It is still there today\u2019 — the survivor itself, not a likeness. (DR-E3-IMG-7)"}, "opencard": "Opening card \u2014 channel + episode title. Cards are titles, not subtitles; V-16 bans narration text, not titles.", "endcard": "End card \u2014 the follow ask in plain words plus the next tease. N-09: the ask is never hidden in metaphor."};
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el || !text) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  el.addEventListener('mouseleave', () => tip.style.display='none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const k in NOTES.plates) bindNote(plates[k], NOTES.plates[k]);
labelEls.forEach((e,i)=>bindNote(e, NOTES.labels[i]));
for (const k in NOTES.extras) { const el = document.getElementById(k); if (el) bindNote(el, NOTES.extras[k]); }
bindNote(openCard, NOTES.opencard); bindNote(endCard, NOTES.endcard);

const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
