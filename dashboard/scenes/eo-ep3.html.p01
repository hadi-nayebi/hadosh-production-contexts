const PLATE_URIS = {"blow": "data:image/jpeg;base64,", "wall": "data:image/jpeg;base64,", "hand": "data:image/jpeg;base64,", "carriers": "data:image/jpeg;base64,", "visitors": "data:image/jpeg;base64,", "embers": "data:image/jpeg;base64,", "dawnland": "data:image/jpeg;base64,", "savanna": "data:image/jpeg;base64,", "photo": "data:image/jpeg;base64,"};
const CONFIG = {"sceneForLine": ["blow", "wall", "carriers", "carriers", "wall", "visitors", "wall", "dawnland", "wall", "savanna", "wall"], "plateCut": {"line": 3, "frac": 0.7868, "before": "carriers", "after": "embers"}, "openCard": ["blow", [["EARTH ONE", 380, 150, "#f5efe0"], ["THE MESSAGE THAT", 560, 92, "#ffb040"], ["OUTLIVED ITS MAKER", 672, 92, "#ffb040"]], "radial-gradient(ellipse 85% 38% at 50% 30%, rgba(10,6,4,.72), rgba(10,6,4,0) 74%)"], "endCard": ["wall", [["FOLLOW FOR THE REST", 420, 84, "#ffb040"], ["OF THE STORY", 530, 84, "#ffb040"], ["NEXT:", 810, 72, "#f5efe0"], ["A SONG REMEMBERS", 905, 72, "#f5efe0"], ["WHAT WORDS FORGET", 1000, 72, "#f5efe0"], ["EARTH ONE", 1420, 64, "rgba(245,239,224,.86)"]]], "labels": [[0, "40,000 YEARS AGO", 330, 84, "#f5efe0", "(p,tt,a,b)=>p>0.70"], [4, "IT WAITS IN THE DARK", 330, 76, "#f5efe0", "(p,tt,a,b)=>p>0.30"]], "bugCol": "rgba(245,239,224,.69)", "bugByLine": {"7": "rgba(43,32,24,.78)"}};
const TL = PLAN.timeline, CEND = PLAN.contentEnd, TOTAL = PLAN.total;
const NL = TL.length;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');

const plates = {};
for (const name of Object.keys(PLATE_URIS)) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + name;
  d.style.backgroundImage = `url(${PLATE_URIS[name]})`;
  stage.appendChild(d); plates[name] = d;
}
function plateAt(li, tt) {
  const cut = CONFIG.plateCut;
  if (cut && li === cut.line) {
    const [a, b] = TL[li];
    return tt < a + cut.frac * (b - a) ? cut.before : cut.after;
  }
  return CONFIG.sceneForLine[li];
}
function lineAt(tt) {
  if (tt < TL[0][0]) return 0;
  for (let i = 0; i < NL; i++) {
    const gapEnd = (i < NL - 1) ? TL[i+1][0] : CEND;
    if (tt >= TL[i][0] && tt < gapEnd) return i;
  }
  return NL - 1;
}
const bug = document.createElement('div');
bug.id = 'bug'; bug.textContent = 'EARTH ONE'; stage.appendChild(bug);

const LABELS = CONFIG.labels.map(L => [L[0], L[1], L[2], L[3], L[4], eval(L[5])]);
const labelEls = LABELS.map(([li, text, y, sz, col]) => {
  const d = document.createElement('div');
  d.className = 'label'; d.textContent = text;
  d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
  stage.appendChild(d); return d;
});

const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = w.size + 'px'; s.style.color = w.col;
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    if (w.shadow) s.style.textShadow = '3px 4px 0 rgba(30,20,14,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}

function makeCard(id, plate, lines, scrim) {
  const c = document.createElement('div');
  c.className = 'card'; c.id = id;
  const bg = document.createElement('div');
  bg.className = 'platecard'; bg.style.backgroundImage = `url(${PLATE_URIS[plate]})`;
  c.appendChild(bg);
  if (scrim) {
    const sc = document.createElement('div');
    sc.style.cssText = 'position:absolute; inset:0; background:' + scrim + ';';
    c.appendChild(sc);
  }
  for (const [text, y, sz, col] of lines) {
    const d = document.createElement('div');
    d.className = 'cardtext'; d.textContent = text;
    d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
    c.appendChild(d);
  }
  stage.appendChild(c); return c;
}
const openCard = makeCard('opencard', CONFIG.openCard[0], CONFIG.openCard[1], CONFIG.openCard[2]);
const endCard = makeCard('endcard', CONFIG.endCard[0], CONFIG.endCard[1], CONFIG.endCard[2]);

/* ---- episode-specific element layers (separate components) ---- */

const handEl = document.createElement('div');
handEl.id = 'hand';
handEl.style.cssText = 'position:absolute; left:200px; top:655px; width:680px; height:680px;' +
  'background-size:contain; background-repeat:no-repeat; background-position:center;' +
  'mix-blend-mode:screen; opacity:0; pointer-events:none;';
handEl.style.backgroundImage = `url(${PLATE_URIS['hand']})`;
stage.appendChild(handEl);
const photoEl = document.createElement('div');
photoEl.id = 'photo';
photoEl.style.cssText = 'position:absolute; inset:0; opacity:0; pointer-events:none;' +
  'background-size:cover; background-position:center;';
photoEl.style.backgroundImage = `url(${PLATE_URIS['photo']})`;
const photoCap = document.createElement('div');
photoCap.style.cssText = 'position:absolute; left:0; right:0; bottom:0; padding:54px 30px 20px;' +
  'background:linear-gradient(to top, rgba(8,5,3,.85), rgba(8,5,3,0)); color:#f5efe0;' +
  'font-family:\'Patrick Hand\'; font-size:31px; text-align:center; letter-spacing:.5px;';
photoCap.textContent = 'THE REAL WALL — PETTAKERE CAVE, SULAWESI · PHOTO: CAHYO · CC BY-SA 4.0 · WIKIMEDIA COMMONS';
photoEl.appendChild(photoCap);
stage.appendChild(photoEl);
const glowEl = document.createElement('div');
glowEl.id = 'glow';
glowEl.style.cssText = 'position:absolute; left:278px; top:346px; width:460px; height:460px;' +
  'background:radial-gradient(circle, rgba(255,176,64,.50), rgba(255,120,40,.16) 46%, rgba(255,120,40,0) 70%);' +
  'mix-blend-mode:screen; opacity:0; pointer-events:none;';
stage.appendChild(glowEl);
// Layer repair (QC finding, first v4 render): the extras are appended
// after the word spans, labels and bug in DOM order, so the full-bleed
// photograph hid the spoken words AND the bug for its whole window
// (frame-verified at 11.9s). Re-append the text layers above the
// extras; listeners and render references are unaffected by the move.
document.querySelectorAll('.word').forEach(el => stage.appendChild(el));
labelEls.forEach(el => stage.appendChild(el));
stage.appendChild(bug);


function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const k in plates) { plates[k].style.opacity = 0; plates[k].style.transform='';
                            plates[k].style.pointerEvents = 'none'; }
  labelEls.forEach(e => { e.style.opacity = 0; e.style.pointerEvents = 'none'; });
  wordEls.forEach(e => e.style.opacity = 0);
  bug.style.opacity = 0; openCard.style.opacity = 0; endCard.style.opacity = 0;
  openCard.style.pointerEvents = 'none';
  endCard.style.pointerEvents = 'none';
  if (typeof handEl !== 'undefined') { handEl.style.opacity = 0; handEl.style.pointerEvents = 'none'; } if (typeof photoEl !== 'undefined') { photoEl.style.opacity = 0; photoEl._o = 0; photoEl.style.pointerEvents = 'none'; } if (typeof glowEl !== 'undefined') glowEl.style.opacity = 0;
  if (t < 1.6) {
    plates[CONFIG.openCard[0]].style.opacity = 1;
    openCard.style.opacity = Math.min(1, t/0.6);
    if (!RENDER && openCard.style.opacity > 0) openCard.style.pointerEvents = 'auto';
    return;
  }
  if (t >= CEND) {
    plates[CONFIG.endCard[0]].style.opacity = 1;
    endCard.style.opacity = Math.min(1, (t-CEND)/0.6);
    if (!RENDER && endCard.style.opacity > 0) endCard.style.pointerEvents = 'auto';
    return;
  }
  const li = lineAt(t), [a, b] = TL[li];
  const p = Math.min(Math.max((t-a)/Math.max(b-a,0.01),0),1);
  const plate = plates[plateAt(li, t)];
  plate.style.opacity = 1;
  if (!RENDER) plate.style.pointerEvents = 'auto';
  plate.style.transform = `scale(${(1 + 0.055*p).toFixed(4)})`;
  bug.style.opacity = 1;
  bug.style.color = CONFIG.bugByLine[li] || CONFIG.bugCol;
  LABELS.forEach((L, i) => { if (L[0] === li && L[5](p, t, a, b)) {
    labelEls[i].style.opacity = 1;
    if (!RENDER) labelEls[i].style.pointerEvents = 'auto'; } });
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const el = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      let al = Math.min(1, (t - w.start)/0.08);
      // Word choreography (DR-E3G-CHOR): decided per-word motion.
      // Words without a tag carry their recorded as-is decision instead.
      let tx = 0, ty = 0, rot = '';
      const age = t - w.start;
      switch (w.ch) {
        case 'grow': s *= 1 + 0.30*easeOut(Math.min(age/0.30, 1)); break;
        case 'hold': s *= 1.13; break;
        case 'growhold': s *= 1 + 0.32*easeOut(Math.min(age/0.30, 1)); break;
        case 'sink': { const v = Math.min(Math.max((age - 0.10)/0.80, 0), 1);
          ty += 46*v; s *= 1 - 0.30*v; al *= 1 - 0.40*v; break; }
        case 'fade': { const v = Math.min(age/0.90, 1); al *= 1 - 0.55*v; break; }
        case 'settle': s *= 1.12 - 0.27*easeOut(Math.min(age/0.50, 1)); break;
        case 'scatter': { const v = Math.min(Math.max((age - 0.35)/0.70, 0), 1);
          ty -= 70*v; tx += 22*v; al *= 1 - 0.65*v; break; }
        case 'flip': { const v = easeOut(Math.min(age/0.35, 1));
          rot = ` rotateY(${((1 - v)*180).toFixed(1)}deg)`; break; }
        case 'flipgrow': { const v = easeOut(Math.min(age/0.35, 1));
          rot = ` rotateY(${((1 - v)*180).toFixed(1)}deg)`; s *= 1 + 0.30*v; break; }
        case 'tether': { const v = Math.min(age/0.90, 1);
          tx += 26*Math.sin(v*Math.PI); break; }
      }
      el.style.opacity = al;
      el.style.transform = `translate(-50%,-50%) translate(${tx.toFixed(1)}px,${ty.toFixed(1)}px) scale(${s.toFixed(3)})${rot}`;
    });
    break;
  }
  
  let photoO = 0;
  if (typeof photoEl !== 'undefined') {
    let po = 0;
    if (li === 1) {
      if (t >= 10.880) po = Math.min(1, (t - 10.880) / 0.45);
      if (t >= 12.299) po = Math.max(0, 1 - (t - 12.299) / 0.15);
    }
    photoO = po; photoEl._o = po;
    photoEl.style.opacity = po;
    photoEl.style.pointerEvents = (!RENDER && po > 0.05) ? 'auto' : 'none';
  }
  if (typeof handEl !== 'undefined') {
    let ho = 0;
    if (li === 1) ho = Math.min(1, Math.max(0, (t - a) / 0.9));
    else if (li === 4 || li === 6 || li === 8 || li === 10) ho = 1;
    else if (li === 9 && t >= 50.280) ho = 1;
    ho *= (1 - photoO);
    handEl.style.opacity = ho;
    handEl.style.pointerEvents = (!RENDER && ho > 0.05) ? 'auto' : 'none';
  }
  if (typeof glowEl !== 'undefined') {
    let go = 0;
    if (li === 5 && t >= 34.020) {
      const u = Math.min(1, (t - 34.020) / Math.max(0.01, b - 34.020));
      go = 0.8 * Math.sin(Math.PI * Math.min(1, u * 1.15));
    }
    glowEl.style.opacity = go;
  }
  plates.carriers.style.filter = (li === 3 && t < 22.200)
    ? `brightness(${(1 - 0.55 * Math.min(1, p / 0.55)).toFixed(3)})` : 'none';
  plates.wall.style.filter = (li === 1 && photoO > 0)
    ? `brightness(${(1 - 0.5 * photoO).toFixed(3)})` : 'none';
  if (li === 7) plates.dawnland.style.transform = `scale(${(1.13 - 0.13 * p).toFixed(4)})`;
  if (li === 9) {
    if (t >= 50.280) {
      plates.savanna.style.opacity = 0; plates.carriers.style.opacity = 0;
      plates.wall.style.opacity = 1;
      plates.wall.style.transform = `scale(${(1 + 0.055 * p).toFixed(4)})`;
      if (!RENDER) plates.wall.style.pointerEvents = 'auto';
      bug.style.color = 'rgba(245,239,224,.69)';
    } else if (t >= 48.300) {
      plates.savanna.style.opacity = 0;
      plates.carriers.style.opacity = 1;
      plates.carriers.style.transform = `scale(${(1 + 0.055 * p).toFixed(4)})`;
      if (!RENDER) plates.carriers.style.pointerEvents = 'auto';
      bug.style.color = 'rgba(245,239,224,.69)';
    } else {
      bug.style.color = 'rgba(43,32,24,.78)';
    }
  }

}
window.renderAt = renderAt;

const NOTES = {"plates": {"blow": "Scene plate \u2014 the maker at work, painterly and textured: hand pressed to rough cave rock, red dust blown from a hollow bone, the torch fully inside the frame, dark rock above for the card and the words. The act the first line describes, shown not narrated. (DR-E3G-IMG-1)", "wall": "Scene plate \u2014 a true cave wall: a solid rock face seen straight on, a smoother dark panel at centre where the hand element lives, torch glow only at the bottom edge. The stage for the message that waits. (DR-E3G-IMG-2)", "carriers": "Scene plate \u2014 the carriers: a grey-bunned elder (blank oval, series grammar) telling the story to huddled listeners around a small fire. Every message before the wall lived in people like these. The plate sinks through L4 and cuts to embers as the carriers die. (DR-E3G-IMG-4)", "visitors": "Scene plate \u2014 the visitors: a child, a spear-carrying hunter and a grey-bearded elder seen from behind, before the stencil at TRUE scale on the wall. The message speaking to strangers. (DR-E3G-IMG-6)", "embers": "Scene plate \u2014 the carriers' fire, dead: charred logs, a few embers, one thread of smoke in near-darkness. L4's second state, cut in on 'the message dies too.' (DR-E3G-IMG-5)", "dawnland": "Scene plate \u2014 the world outside, vast and pale: a huge dawn sky, a distant cliff, one tiny cave mouth with a red glint. The camera PULLS BACK through L8 while the words stay pinned \u2014 whoever wants the message must cross all this. Dark-ink scene (words + bug). (DR-E3G-IMG-8)", "savanna": "Scene plate \u2014 Ep.1's world, richly redrawn: dawn savanna, spotted deer, one acacia. Used ONLY as the bookend's first state ('the first archive was a body') \u2014 the borrowed finale no longer carries the close. (DR-E3G-IMG-9)", "photo": "Component plate \u2014 the real Pettakere photograph; see the photo component note. (DR-E3G-IMG-7)", "hand": "Element plate \u2014 the negative-stencil element's source; see the hand component note. (DR-E3G-IMG-3)"}, "labels": ["Label \u2014 the time anchor, appearing as the first line's last words speak it: Earth One states the time out loud in every episode.", "Label \u2014 the wait named: the mark needs nobody and simply waits in the dark."], "extras": {"hand": "Element \u2014 the hand stencil, a SEPARATE component: a TRUE NEGATIVE stencil this time (pale hand silhouette inside a red-ochre spray halo, generated on black), screen-blended onto the cave-wall plate. It fades in as the shape that stays (L2), yields to the real photograph at 'still there today,' and returns for the wait, the statement, 'stone does not forget,' the bookend's third state, and the bridge. (DR-E3G-IMG-3)", "photo": "Component \u2014 the REAL Pettakere Cave hand-stencil photograph (CC BY-SA 4.0, Cahyo, Wikimedia Commons), full-bleed for the length of 'It is still there today' \u2014 the episode's proof at full frame, with its attribution in the caption strip. (DR-E3G-IMG-7)", "glow": "Component \u2014 the speaking glow: a soft torchlight swell over the visitors plate's stencil, swelling exactly while 'the hand still speaks: I was here' is spoken. The mark lights up as it speaks. (DR-E3G-EL-1)"}, "opencard": "Opening card \u2014 channel + episode title. Cards are titles, not subtitles; V-16 bans narration text, not titles.", "endcard": "End card \u2014 the follow ask in plain words plus the next tease. N-09: the ask is never hidden in metaphor."};
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el || !text) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  el.addEventListener('mouseleave', () => tip.style.display='none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const k in NOTES.plates) bindNote(plates[k], NOTES.plates[k]);
labelEls.forEach((e,i)=>bindNote(e, NOTES.labels[i]));
for (const k in NOTES.extras) { const el = document.getElementById(k); if (el) bindNote(el, NOTES.extras[k]); }
bindNote(openCard, NOTES.opencard); bindNote(endCard, NOTES.endcard);

const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
if (DEC.word_decisions) {
  const wd = DEC.coverage.word_decisions;
  const byLine = {};
  for (const d of DEC.word_decisions) (byLine[d.line] = byLine[d.line] || []).push(d);
  html += `<div class="rec"><b>WORD DECISIONS — the container (every word, decided)</b><br>` +
    `<span class="fld">Coverage:</span> ${wd.decided} of ${wd.total} words carry a recorded decision — ` +
    `a choreography treatment, the accent pop, or a deliberate AS-IS with its tempo/effect reason. ` +
    `An unrecorded word would be randomness; the build asserts full coverage.<br>`;
  for (const li of Object.keys(byLine)) {
    html += `<span class="fld">L${li}:</span> ` + byLine[li].map(d =>
      (d.treatment === 'AS-IS' || d.treatment === 'ACCENT POP')
        ? d.word : `${d.word} [${d.treatment}]`).join(' · ') + '<br>';
  }
  html += `<span class="fld">Choreographed words, with reasons:</span><br>` +
    DEC.word_decisions.filter(d => d.treatment !== 'AS-IS' && d.treatment !== 'ACCENT POP')
      .map(d => `L${d.line} “${d.word}” [${d.treatment}] — ${d.reason}`).join('<br>') +
    `<br><span class="fld">Per-word records:</span> every word's treatment, tempo and reason ` +
    `are stored in this file's #decisions data (the word_decisions array).</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
