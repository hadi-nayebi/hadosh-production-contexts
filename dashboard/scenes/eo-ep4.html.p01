: false}]}, {"line": 8, "start": 52.24, "end": 52.68, "scene": "childletters", "words": [{"w": "You", "start": 52.24, "cx": 295.40625, "cy": 710, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "learned", "start": 52.34, "cx": 521.703125, "cy": 710, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "your", "start": 52.52, "cx": 766.296875, "cy": 710, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 8, "start": 52.68, "end": 53.4, "scene": "childletters", "words": [{"w": "letters", "start": 52.68, "cx": 313.234375, "cy": 600, "size": 118, "key": true, "col": "#92400e", "shadow": false}, {"w": "by", "start": 52.88, "cx": 533.6796875, "cy": 600, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "singing", "start": 53.12, "cx": 760.4453125, "cy": 600, "size": 118, "key": true, "col": "#92400e", "shadow": false}]}, {"line": 8, "start": 53.4, "end": 53.595085000000005, "scene": "childletters", "words": [{"w": "them.", "start": 53.4, "cx": 540.0, "cy": 710, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 9, "start": 54.045085, "end": 54.62, "scene": "finale", "words": [{"w": "One", "start": 54.0, "cx": 402.9921875, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "idea", "start": 54.18, "cx": 573.4921875, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "at", "start": 54.44, "cx": 710.5, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 9, "start": 54.62, "end": 54.98, "scene": "finale", "words": [{"w": "a", "start": 54.62, "cx": 432.59375, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "time,", "start": 54.68, "cx": 574.6015625, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 9, "start": 54.98, "end": 55.84, "scene": "finale", "words": [{"w": "across", "start": 54.98, "cx": 354.40625, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "the", "start": 55.44, "cx": 559.40625, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "whole", "start": 55.66, "cx": 745.0, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 9, "start": 55.84, "end": 56.48, "scene": "finale", "words": [{"w": "story", "start": 55.84, "cx": 403.2421875, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "of", "start": 56.22, "cx": 568.34375, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "this", "start": 56.36, "cx": 705.1015625, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 9, "start": 56.48, "end": 58.0, "scene": "finale", "words": [{"w": "planet", "start": 56.48, "cx": 272.6875, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "subscribe", "start": 56.8, "cx": 616.6484375, "cy": 815, "size": 118, "key": true, "col": "#92400e", "shadow": false}, {"w": "to", "start": 57.68, "cx": 883.9609375, "cy": 815, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}, {"line": 9, "start": 58.0, "end": 58.476293, "scene": "finale", "words": [{"w": "Earth", "start": 58.0, "cx": 444.0, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}, {"w": "One.", "start": 58.22, "cx": 654.15625, "cy": 935, "size": 100, "key": false, "col": "#2b2018", "shadow": false}]}]};
const PLATE_URIS = {"grandmother": "data:image/jpeg;base64,", "road": "data:image/jpeg;base64,", "dusklist": "data:image/jpeg;base64,", "water": "data:image/jpeg;base64,", "childletters": "data:image/jpeg;base64,", "finale": "data:image/jpeg;base64,"};
const CONFIG = {"sceneForLine": ["grandmother", "grandmother", "dusklist", "road", "water", "road", "grandmother", "finale", "childletters", "finale"], "plateCut": {"line": 4, "frac": 0.55, "before": "water", "after": "road"}, "openCard": ["grandmother", [["EARTH ONE", 700, 150, "#2b2018"], ["A SONG REMEMBERS", 880, 92, "#92400e"], ["WHAT WORDS FORGET", 985, 92, "#92400e"]]], "endCard": ["finale", [["FOLLOW FOR THE REST", 420, 84, "#92400e"], ["OF THE STORY", 530, 84, "#92400e"], ["NEXT:", 810, 72, "#2b2018"], ["MORE OF THE", 905, 72, "#2b2018"], ["PLANET'S STORY", 1000, 72, "#2b2018"], ["EARTH ONE", 1420, 64, "rgba(43,32,24,.86)"]]], "labels": [[0, "40,000 YEARS AGO", 420, 84, "#2b2018", "(p,tt,a,b)=>p>0.10"], [1, "IT IS A MAP", 330, 84, "#92400e", "(p,tt,a,b)=>p>0.30"], [8, "A B C", 420, 96, "#92400e", "(p,tt,a,b)=>p>0.50"]], "bugCol": "rgba(245,239,224,.69)", "bugByLine": {"0": "rgba(43,32,24,.75)", "1": "rgba(43,32,24,.75)", "3": "rgba(43,32,24,.75)", "4": "rgba(43,32,24,.75)", "5": "rgba(43,32,24,.75)", "6": "rgba(43,32,24,.75)", "7": "rgba(43,32,24,.75)", "8": "rgba(43,32,24,.75)", "9": "rgba(43,32,24,.75)"}};
const TL = PLAN.timeline, CEND = PLAN.contentEnd, TOTAL = PLAN.total;
const NL = TL.length;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');

const plates = {};
for (const name of Object.keys(PLATE_URIS)) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + name;
  d.style.backgroundImage = `url(${PLATE_URIS[name]})`;
  stage.appendChild(d); plates[name] = d;
}
function plateAt(li, tt) {
  const cut = CONFIG.plateCut;
  if (cut && li === cut.line) {
    const [a, b] = TL[li];
    return tt < a + cut.frac * (b - a) ? cut.before : cut.after;
  }
  return CONFIG.sceneForLine[li];
}
function lineAt(tt) {
  if (tt < TL[0][0]) return 0;
  for (let i = 0; i < NL; i++) {
    const gapEnd = (i < NL - 1) ? TL[i+1][0] : CEND;
    if (tt >= TL[i][0] && tt < gapEnd) return i;
  }
  return NL - 1;
}
const bug = document.createElement('div');
bug.id = 'bug'; bug.textContent = 'EARTH ONE'; stage.appendChild(bug);

const LABELS = CONFIG.labels.map(L => [L[0], L[1], L[2], L[3], L[4], eval(L[5])]);
const labelEls = LABELS.map(([li, text, y, sz, col]) => {
  const d = document.createElement('div');
  d.className = 'label'; d.textContent = text;
  d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
  stage.appendChild(d); return d;
});

const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = w.size + 'px'; s.style.color = w.col;
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    if (w.shadow) s.style.textShadow = '3px 4px 0 rgba(30,20,14,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}

function makeCard(id, plate, lines, scrim) {
  const c = document.createElement('div');
  c.className = 'card'; c.id = id;
  const bg = document.createElement('div');
  bg.className = 'platecard'; bg.style.backgroundImage = `url(${PLATE_URIS[plate]})`;
  c.appendChild(bg);
  if (scrim) {
    const sc = document.createElement('div');
    sc.style.cssText = 'position:absolute; inset:0; background:' + scrim + ';';
    c.appendChild(sc);
  }
  for (const [text, y, sz, col] of lines) {
    const d = document.createElement('div');
    d.className = 'cardtext'; d.textContent = text;
    d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
    c.appendChild(d);
  }
  stage.appendChild(c); return c;
}
const openCard = makeCard('opencard', CONFIG.openCard[0], CONFIG.openCard[1], CONFIG.openCard[2]);
const endCard = makeCard('endcard', CONFIG.endCard[0], CONFIG.endCard[1], CONFIG.endCard[2]);

/* ---- episode-specific element layers (separate components) ---- */

const notesEl = document.createElement('div');
notesEl.id = 'notes';
notesEl.style.cssText = 'position:absolute; inset:0; pointer-events:none;';
const NOTE_GLYPHS = ['\u266A','\u266B','\u266A','\u2669','\u266A'];
const noteSpans = NOTE_GLYPHS.map(g => {
  const s = document.createElement('span');
  s.textContent = g;
  s.style.cssText = 'position:absolute; font-family:\'Bug Sans\'; font-size:92px; opacity:0; transform:translate(-50%,-50%);';
  notesEl.appendChild(s); return s;
});
stage.appendChild(notesEl);
const NOTES_ROW = [[240,470],[390,455],[540,470],[690,455],[840,470]];
const NOTES_TRAIL = [[350,840],[470,975],[585,1110],[700,1240],[810,1360]];
const NOTES_DRIFT = [[350,520],[560,450],[770,540]];


function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const k in plates) { plates[k].style.opacity = 0; plates[k].style.transform='';
                            plates[k].style.pointerEvents = 'none'; }
  labelEls.forEach(e => { e.style.opacity = 0; e.style.pointerEvents = 'none'; });
  wordEls.forEach(e => e.style.opacity = 0);
  bug.style.opacity = 0; openCard.style.opacity = 0; endCard.style.opacity = 0;
  openCard.style.pointerEvents = 'none';
  endCard.style.pointerEvents = 'none';
  if (typeof noteSpans !== 'undefined') noteSpans.forEach(s => s.style.opacity = 0);
  if (t < 1.6) {
    plates[CONFIG.openCard[0]].style.opacity = 1;
    openCard.style.opacity = Math.min(1, t/0.6);
    if (!RENDER && openCard.style.opacity > 0) openCard.style.pointerEvents = 'auto';
    return;
  }
  if (t >= CEND) {
    plates[CONFIG.endCard[0]].style.opacity = 1;
    endCard.style.opacity = Math.min(1, (t-CEND)/0.6);
    if (!RENDER && endCard.style.opacity > 0) endCard.style.pointerEvents = 'auto';
    return;
  }
  const li = lineAt(t), [a, b] = TL[li];
  const p = Math.min(Math.max((t-a)/Math.max(b-a,0.01),0),1);
  const plate = plates[plateAt(li, t)];
  plate.style.opacity = 1;
  if (!RENDER) plate.style.pointerEvents = 'auto';
  plate.style.transform = `scale(${(1 + 0.055*p).toFixed(4)})`;
  bug.style.opacity = 1;
  bug.style.color = CONFIG.bugByLine[li] || CONFIG.bugCol;
  LABELS.forEach((L, i) => { if (L[0] === li && L[5](p, t, a, b)) {
    labelEls[i].style.opacity = 1;
    if (!RENDER) labelEls[i].style.pointerEvents = 'auto'; } });
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const el = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      const al = Math.min(1, (t - w.start)/0.08);
      el.style.opacity = al;
      el.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    break;
  }
  
  if (typeof noteSpans !== 'undefined') {
    let mode = null, col = '#92400e';
    if (li === 3 || li === 6) mode = NOTES_ROW;
    else if (li === 5) mode = NOTES_TRAIL;
    else if (li === 7) { mode = NOTES_DRIFT; col = '#2b2018'; }
    noteSpans.forEach((s, i) => {
      if (!mode || i >= mode.length) { s.style.opacity = 0; return; }
      const u = Math.min(Math.max((t - a - 0.25 * i) / 0.3, 0), 1);
      s.style.opacity = u;
      s.style.left = mode[i][0] + 'px'; s.style.top = mode[i][1] + 'px';
      s.style.color = col;
    });
    notesEl.style.pointerEvents = (!RENDER && mode) ? 'auto' : 'none';
  }

}
window.renderAt = renderAt;

const NOTES = {"plates": {"grandmother": "Scene plate \u2014 the grandmother singing the road: grey buns, rust tunic, two children in tunics singing back, the big rock and the bent tree on the path behind them. The song and its cargo in one frame. (DR-E4-IMG-1)", "road": "Scene plate \u2014 the road itself: winding path, the big rock, the bent tree, a huge pale sky. The map the song carries, empty of people so the notes can travel it. (DR-E4-IMG-2)", "dusklist": "Scene plate \u2014 words without a beat: three figures at dusk, one scratching his head, the fire unlit. The list is already going wrong. Note what is NOT here: the notes component is absent for this whole beat. (DR-E4-IMG-3)", "water": "Scene plate \u2014 Ep.1's waterhole, reused: the song's first cargo is the road to water, and L5 names the water over the series' own water frame before cutting back to the road for the plants. (DR-E4-IMG-4)", "childletters": "Scene plate \u2014 the twist in one frame: a child tracing shapes in the sand while the grandmother sings beside her. Letters learned by singing, drawn in the viewer's own childhood register \u2014 warmer and more faced than the prehistoric plates, on purpose. (DR-E4-IMG-5)", "finale": "Scene plate \u2014 the dawn finale, the series bookend world (reused): the song has been riding through body, story and mark; the plain at morning is where it rides on. (DR-E4-IMG-6)"}, "labels": ["Label \u2014 the time anchor at the head of the line: Earth One states the time out loud in every episode; this episode keeps the time-first opener (Ep.3's was rewritten \u2014 the contrast is logged in both script docs).", "Label \u2014 the first reveal, named as it lands: the song is a map.", "Label \u2014 the alphabet, arriving with the words 'learned your letters': the tool the viewer still uses."], "extras": {"notes": "Component \u2014 the musical notes, separate glyph elements. Their ARRANGEMENT performs the claim: absent while plain words fail (L3), standing IN A LINE when the beat holds words in order (L4, L7), trailing down the road as the song travels (L6), drifting over the dawn when the song outlives every singer (L8). (DR-E4-EL-1)"}, "opencard": "Opening card \u2014 channel + episode title. Cards are titles, not subtitles; V-16 bans narration text, not titles.", "endcard": "End card \u2014 the follow ask in plain words plus the next tease. N-09: the ask is never hidden in metaphor."};
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el || !text) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  el.addEventListener('mouseleave', () => tip.style.display='none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const k in NOTES.plates) bindNote(plates[k], NOTES.plates[k]);
labelEls.forEach((e,i)=>bindNote(e, NOTES.labels[i]));
for (const k in NOTES.extras) { const el = document.getElementById(k); if (el) bindNote(el, NOTES.extras[k]); }
bindNote(openCard, NOTES.opencard); bindNote(endCard, NOTES.endcard);

const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
