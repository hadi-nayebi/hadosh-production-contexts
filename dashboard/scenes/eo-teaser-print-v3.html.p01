const PLATE_URIS = {"pair": "data:image/jpeg;base64,", "scribe": "data:image/jpeg;base64,", "claytype": "data:image/jpeg;base64,", "metaltype": "data:image/jpeg;base64,", "press": "data:image/jpeg;base64,", "stacks": "data:image/jpeg;base64,", "shelves": "data:image/jpeg;base64,", "finale": "data:image/jpeg;base64,"};
const CONFIG = {"sceneForLine": ["pair", "scribe", "claytype", "press", "stacks", "shelves", "pair", "finale"], "plateCuts": [{"line": 2, "frac": 0.713, "before": "claytype", "after": "metaltype"}, {"line": 4, "frac": 0.535, "before": "stacks", "after": "scribe"}], "plateZoom": {"press": 0.0}, "openCard": ["pair", [["EARTH ONE", 640, 150, "#f5efe0"], ["TWO IDENTICAL", 800, 92, "#ffb040"], ["BIBLES", 905, 92, "#ffb040"]], "radial-gradient(ellipse 82% 34% at 50% 39%, rgba(10,6,4,.55), rgba(10,6,4,0) 72%)"], "endCard": ["finale", [["FOLLOW FOR THE REST", 420, 84, "#92400e"], ["OF THE STORY", 530, 84, "#92400e"], ["NEXT:", 810, 72, "#2b2018"], ["MORE OF THE", 905, 72, "#2b2018"], ["PLANET'S STORY", 1000, 72, "#2b2018"], ["EARTH ONE", 1420, 64, "rgba(43,32,24,.86)"]]], "labels": [[0, "AROUND 1455", 330, 84, "#f5efe0", "(p,tt,a,b)=>p>0.08"], [5, "BY 1500", 330, 84, "#f5efe0", "(p,tt,a,b)=>p>0.10"]], "bugCol": "rgba(245,239,224,.69)", "bugByLine": {"7": "rgba(43,32,24,.75)"}};
const TL = PLAN.timeline, CEND = PLAN.contentEnd, TOTAL = PLAN.total;
const NL = TL.length;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');

const plates = {};
for (const name of Object.keys(PLATE_URIS)) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + name;
  d.style.backgroundImage = `url(${PLATE_URIS[name]})`;
  stage.appendChild(d); plates[name] = d;
}
function plateAt(li, tt) {
  const cuts = CONFIG.plateCuts || [];
  for (const cut of cuts) {
    if (li === cut.line) {
      const [a, b] = TL[li];
      return tt < a + cut.frac * (b - a) ? cut.before : cut.after;
    }
  }
  return CONFIG.sceneForLine[li];
}
function lineAt(tt) {
  if (tt < TL[0][0]) return 0;
  for (let i = 0; i < NL; i++) {
    const gapEnd = (i < NL - 1) ? TL[i+1][0] : CEND;
    if (tt >= TL[i][0] && tt < gapEnd) return i;
  }
  return NL - 1;
}
const bug = document.createElement('div');
bug.id = 'bug'; bug.textContent = 'EARTH ONE'; stage.appendChild(bug);

const LABELS = CONFIG.labels.map(L => [L[0], L[1], L[2], L[3], L[4], eval(L[5])]);
const labelEls = LABELS.map(([li, text, y, sz, col]) => {
  const d = document.createElement('div');
  d.className = 'label'; d.textContent = text;
  d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
  stage.appendChild(d); return d;
});

const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = w.size + 'px'; s.style.color = w.col;
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    if (w.shadow) s.style.textShadow = '3px 4px 0 rgba(30,20,14,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}

function makeCard(id, plate, lines, scrim) {
  const c = document.createElement('div');
  c.className = 'card'; c.id = id;
  const bg = document.createElement('div');
  bg.className = 'platecard'; bg.style.backgroundImage = `url(${PLATE_URIS[plate]})`;
  c.appendChild(bg);
  if (scrim) {
    const sc = document.createElement('div');
    sc.style.cssText = 'position:absolute; inset:0; background:' + scrim + ';';
    c.appendChild(sc);
  }
  for (const [text, y, sz, col] of lines) {
    const d = document.createElement('div');
    d.className = 'cardtext'; d.textContent = text;
    d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
    c.appendChild(d);
  }
  stage.appendChild(c); return c;
}
const openCard = makeCard('opencard', CONFIG.openCard[0], CONFIG.openCard[1], CONFIG.openCard[2]);
const endCard = makeCard('endcard', CONFIG.endCard[0], CONFIG.endCard[1], CONFIG.endCard[2]);

/* ---- episode-specific element layers (separate components) ---- */


function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const k in plates) { plates[k].style.opacity = 0; plates[k].style.transform='';
                            plates[k].style.pointerEvents = 'none'; }
  labelEls.forEach(e => { e.style.opacity = 0; e.style.pointerEvents = 'none'; });
  wordEls.forEach(e => e.style.opacity = 0);
  bug.style.opacity = 0; openCard.style.opacity = 0; endCard.style.opacity = 0;
  openCard.style.pointerEvents = 'none';
  endCard.style.pointerEvents = 'none';
  
  if (t < 1.6) {
    plates[CONFIG.openCard[0]].style.opacity = 1;
    openCard.style.opacity = Math.min(1, t/0.6);
    if (!RENDER && openCard.style.opacity > 0) openCard.style.pointerEvents = 'auto';
    return;
  }
  if (t >= CEND) {
    plates[CONFIG.endCard[0]].style.opacity = 1;
    endCard.style.opacity = Math.min(1, (t-CEND)/0.6);
    if (!RENDER && endCard.style.opacity > 0) endCard.style.pointerEvents = 'auto';
    return;
  }
  const li = lineAt(t), [a, b] = TL[li];
  const p = Math.min(Math.max((t-a)/Math.max(b-a,0.01),0),1);
  const plateName = plateAt(li, t);
  const plate = plates[plateName];
  plate.style.opacity = 1;
  if (!RENDER) plate.style.pointerEvents = 'auto';
  const zp = (CONFIG.plateZoom && plateName in CONFIG.plateZoom) ? CONFIG.plateZoom[plateName] : 0.055;
  plate.style.transform = `scale(${(1 + zp*p).toFixed(4)})`;
  bug.style.opacity = 1;
  bug.style.color = CONFIG.bugByLine[li] || CONFIG.bugCol;
  LABELS.forEach((L, i) => { if (L[0] === li && L[5](p, t, a, b)) {
    labelEls[i].style.opacity = 1;
    if (!RENDER) labelEls[i].style.pointerEvents = 'auto'; } });
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const el = ph._els[wi];
      if (t < w.start) return;
      /* Word choreography (DR-PRINT-GAP-6): w.anim is a recorded
         per-word decision — pop is the house arrival; stamp lands
         hard like the press; drift sways; sink settles downward;
         grow holds oversize; small arrives quiet and undersize;
         still fades with no motion at all (the close, L7). */
      const age = t - w.start, anim = w.anim || 'pop';
      let s, dx = 0, dy = 0, al = Math.min(1, age/0.08);
      if (anim === 'still') { s = 1; al = Math.min(1, age/0.30); }
      else if (anim === 'small') { s = 0.85; al = Math.min(1, age/0.25); }
      else if (anim === 'stamp') { const u = Math.min(age/0.10, 1); s = 1.30 - 0.30*easeOut(u); al = Math.min(1, age/0.05); }
      else if (anim === 'grow') { const u = Math.min(age/0.45, 1); s = 0.55 + 0.60*easeOut(u); }
      else {
        const u = Math.min(age/0.16, 1);
        s = 0.55 + 0.45*easeOut(u);
        if (w.key) { const v = Math.min(age/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
        if (anim === 'drift') dx = 6*Math.sin(age*2.4)*Math.max(0, 1 - age/2.5);
        if (anim === 'sink') dy = Math.min(age*7, 10);
      }
      el.style.opacity = al;
      el.style.transform = `translate(-50%,-50%) translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) scale(${s.toFixed(3)})`;
    });
    break;
  }
  
}
window.renderAt = renderAt;

const NOTES = {"plates": {"pair": "Scene plate \u2014 the impossible object: two printed Bibles open at the same page, letter for letter the same. The whole piece is this frame's question. (DR-PRINT-IMG-1)", "scribe": "Scene plate \u2014 the wandering copy at work: a scribe copying by hand, candlelit. Every copy drifts a little; one Bible costs him three years. (DR-PRINT-IMG-2)", "claytype": "Scene plate \u2014 the fix, four centuries early: clay letter tiles set in a tray in China \u2014 Bi Sheng's movable type. (DR-PRINT-IMG-3)", "metaltype": "Scene plate \u2014 the same idea cast in metal: Korean metal type sorts in their case, tweezers beside them. (DR-PRINT-IMG-4)", "press": "Scene plate \u2014 the system that repeats: metal letters in the forme, the great screw above, and its product \u2014 one freshly printed sheet. (DR-PRINT-IMG-5)", "stacks": "Scene plate \u2014 the count: stack after stack of the same bound book. Three years of presses against three years of one scribe. (DR-PRINT-IMG-6)", "shelves": "Scene plate \u2014 the scale: by 1500 the printed book fills halls like this one. (DR-PRINT-IMG-7)", "finale": "Scene plate \u2014 the dawn finale, the series bookend world (reused): where the planet's story closes each chapter. (DR-PRINT-IMG-8)"}, "labels": ["Label \u2014 the time anchor: Earth One states the time in every piece; here it is spoken in the first breath and set into the wall as it lands.", "Label \u2014 the scale's date, set as the line speaks it: by 1500."], "extras": {}, "opencard": "Opening card \u2014 channel + episode title. Cards are titles, not subtitles; V-16 bans narration text, not titles.", "endcard": "End card \u2014 the follow ask in plain words plus the next tease. N-09: the ask is never hidden in metaphor."};
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el || !text) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  el.addEventListener('mouseleave', () => tip.style.display='none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const k in NOTES.plates) bindNote(plates[k], NOTES.plates[k]);
labelEls.forEach((e,i)=>bindNote(e, NOTES.labels[i]));
for (const k in NOTES.extras) { const el = document.getElementById(k); if (el) bindNote(el, NOTES.extras[k]); }
bindNote(openCard, NOTES.opencard); bindNote(endCard, NOTES.endcard);

const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
if (DEC.word_decisions) {
  const wd = DEC.word_decisions;
  html += `<h2 style="margin-top:22px">Word decisions — ${DEC.word_coverage.decided} of ${DEC.word_coverage.total} words</h2>` +
    '<div class="cov">Every word carries a recorded treatment (choreographed, stilled, or a deliberate as-is with its reason). A word with no record would be randomness.</div>';
  for (const d of wd) {
    html += `<div class="rec"><b>#${d.n} "${d.word}"</b> (line ${d.line}) — <b>${d.treatment}</b><br><span class="fld">Reason:</span> ${d.reason}</div>`;
  }
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
