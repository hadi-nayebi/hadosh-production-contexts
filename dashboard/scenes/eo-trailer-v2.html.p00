<style>
@font-face { font-family:'Patrick Hand'; src:url(data:font/ttf;base64,) format('truetype'); }
@font-face { font-family:'Bug Sans'; src:url(data:font/woff2;base64,) format('woff2'); }
* { margin:0; padding:0; box-sizing:border-box; }
body { background:#111; display:flex; flex-direction:column; align-items:center;
       font-family:'Patrick Hand', sans-serif; }
#stage { position:relative; width:1080px; height:1920px; overflow:hidden; flex:none;
         background:linear-gradient(180deg,#d3dedd 0%,#e2e7dc 42%,#eee3bd 58%,#eecf8d 78%,#e9ba57 100%); }
.world { position:absolute; overflow:hidden; opacity:0; }
.world img.plateimg { position:absolute; inset:0; width:100%; height:100%; }
#mapworld { left:0; top:1150px; width:1080px; height:607px; }
#stripworld { left:0; top:1120px; width:3939px; height:800px; }
#rightplate { position:absolute; left:0; top:183px; width:1080px; height:1737px; opacity:0; }
.hot { position:absolute; pointer-events:auto; }
.hot:hover { outline:2px dashed rgba(146,64,14,.55); outline-offset:-2px; }
.hot.pulse { background:radial-gradient(ellipse at center,
             rgba(255,176,64,.40) 0%, rgba(255,176,64,.17) 55%,
             rgba(255,176,64,0) 78%); }
#bug { position:absolute; left:100px; top:265px; transform:translateY(-50%);
       font-family:'Bug Sans'; font-size:27px; color:rgba(43,32,24,.69);
       letter-spacing:1px; opacity:0; }
.word { position:absolute; font-family:'Patrick Hand'; white-space:nowrap;
        opacity:0; pointer-events:none; will-change:transform,opacity; }
#pagecard { position:absolute; left:220px; top:470px; width:640px;
            background:#f8f1de; border-radius:10px; padding:30px 40px 26px;
            color:#2b2018; box-shadow:0 14px 40px rgba(43,32,24,.35);
            transform:rotate(-1.2deg); opacity:0; pointer-events:auto; }
#pagecard .tag { font-size:27px; color:#92400e; letter-spacing:2px; margin-bottom:12px; }
#pagecard .ln { font-size:43px; line-height:1.28; }
#pagecard .tag2 { font-size:24px; color:#92400e; letter-spacing:1px; margin-top:14px; }
#endcard { position:absolute; inset:0; opacity:0; pointer-events:none; }
.cardtext { position:absolute; left:0; width:1080px; text-align:center; font-family:'Patrick Hand'; }
#tooltip { position:fixed; z-index:60; max-width:430px; background:rgba(16,14,12,.93);
           color:#f5efe0; border:1px solid #ffb040; border-radius:10px;
           padding:10px 14px; font-size:19px; line-height:1.35; display:none;
           pointer-events:none; }
#chrome { width:1080px; background:#1a1a1a; color:#eee; padding:14px 18px;
          display:flex; gap:14px; align-items:center; font-size:20px; }
#chrome button { font-family:inherit; font-size:20px; padding:8px 18px; border-radius:8px;
                 border:1px solid #ffb040; background:#26221e; color:#f5efe0; cursor:pointer; }
#bar { flex:1; height:10px; background:#333; border-radius:5px; overflow:hidden; cursor:pointer; }
#fill { height:100%; width:0%; background:#ffb040; }
#ctxpanel { width:1080px; background:#14120f; color:#e8e2d4; padding:22px 28px;
            display:none; font-size:19px; line-height:1.45; }
#ctxpanel h2 { color:#ffb040; font-size:26px; margin-bottom:6px; }
#ctxpanel .cov { color:#9fd48a; margin-bottom:16px; }
#ctxpanel .rec { border-top:1px solid #333; padding:12px 0; }
#ctxpanel .rec b { color:#ffb040; }
#ctxpanel .fld { color:#bdb49e; }
body.render #chrome, body.render #ctxpanel { display:none !important; }
body.render #stage { cursor:none; }
body.render .world, body.render #rightplate, body.render #pagecard,
body.render #endcard { pointer-events:none !important; }
body.render .hot { pointer-events:none !important; }
</style>
</head>
