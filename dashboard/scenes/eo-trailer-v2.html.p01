", "strip": "data:image/jpeg;base64,", "right": "data:image/webp;base64,"};
const TL = PLAN.timeline, CEND = PLAN.contentEnd, TOTAL = PLAN.total;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const STRIP_S = 800/520;               // strip crop displayed scale
const NOTES = {"antelope": "Timeline element \u2014 the antelope: information's first home, the living body. Stop one of five on the banner's timeline; the trailer rides the banner, so the map and the movie are the same picture. (DR-IMG-1)", "fire": "Timeline element \u2014 the fire circle: the story stop. A story is copied into every listener who hears it; episode two lives here. (DR-IMG-1)", "hand": "Timeline element \u2014 the red hand on the rock: the mark stop, and this trailer's chosen vivid detail. A mark outlives its maker; this one has been speaking for tens of thousands of years, so the L4 camera holds on it. (DR-IMG-1, DR-WORD-2)", "press": "Timeline element \u2014 the printing press: the print stop. One text becomes thousands of copies; the arc's last carrier before words go electric. (DR-IMG-1)", "bubbles": "Timeline element \u2014 the speech bubbles: spoken language, information moving at the speed of sound \u2014 and the bridge to the words show. (DR-IMG-1)", "panel": "Timeline element \u2014 the five-language panel: today's stop, and the second show. One useful sentence in Turkish, Persian, English, German, and French. (DR-IMG-1)", "page": "Component \u2014 the script page. The making, shown: this video's own first lines, displayed inside the video, because the script of every piece is published with it. Steal this method. (DR-IMG-2)", "endcard": "End card \u2014 the follow ask in plain words over the returning map: the empty landscape from the opening comes back labelled with the two shows. (DR-CARD-2)", "map": "The banner as the scene: channel map, opening card, and landscape in one approved picture. Hover the timeline elements below \u2014 each carries its decision. (DR-IMG-1)"};

/* ---------- worlds ---------- */
function makeWorld(id, uri) {
  const d = document.createElement('div');
  d.className = 'world'; d.id = id;
  const img = document.createElement('img');
  img.className = 'plateimg'; img.src = uri; img.alt = '';
  d.appendChild(img); stage.appendChild(d); return d;
}
const mapWorld = makeWorld('mapworld', URIS.banner);
const stripWorld = makeWorld('stripworld', URIS.strip);
const rightPlate = document.createElement('img');
rightPlate.id = 'rightplate'; rightPlate.src = URIS.right; rightPlate.alt = '';
stage.appendChild(rightPlate);

/* hotspots: fractions of their world box */
function addHot(world, id, fx, fy, fw, fh) {
  const d = document.createElement('div');
  d.className = 'hot'; d.id = 'hot-' + id;
  d.style.left = (fx*100) + '%'; d.style.top = (fy*100) + '%';
  d.style.width = (fw*100) + '%'; d.style.height = (fh*100) + '%';
  world.appendChild(d); return d;
}
const HOTS = { map: {}, strip: {} };
HOTS.map.antelope = addHot(mapWorld, 'm-antelope', .060, .655, .110, .245);
HOTS.map.fire     = addHot(mapWorld, 'm-fire',     .245, .755, .155, .135);
HOTS.map.hand     = addHot(mapWorld, 'm-hand',     .455, .675, .175, .220);
HOTS.map.press    = addHot(mapWorld, 'm-press',    .675, .710, .100, .195);
HOTS.map.bubbles  = addHot(mapWorld, 'm-bubbles',  .845, .490, .140, .220);
HOTS.map.panel    = addHot(mapWorld, 'm-panel',    .830, .745, .135, .140);
HOTS.strip.antelope = addHot(stripWorld, 's-antelope', .060, .03, .110, .69);
HOTS.strip.fire     = addHot(stripWorld, 's-fire',     .245, .32, .155, .37);
HOTS.strip.hand     = addHot(stripWorld, 's-hand',     .455, .10, .175, .61);
HOTS.strip.press    = addHot(stripWorld, 's-press',    .675, .20, .100, .54);
HOTS.strip.panel    = addHot(stripWorld, 's-panel',    .830, .29, .135, .39);
function addHotStage(id, x, y, w, h) {
  const d = document.createElement('div');
  d.className = 'hot'; d.id = 'hot-' + id;
  d.style.left = x + 'px'; d.style.top = y + 'px';
  d.style.width = w + 'px'; d.style.height = h + 'px';
  stage.appendChild(d); return d;
}
const hotRBubbles = addHotStage('r-bubbles', 380, 470, 470, 450);
const hotRPanel   = addHotStage('r-panel',   240, 1130, 580, 450);
hotRBubbles.style.opacity = 0; hotRPanel.style.opacity = 0;

/* ---------- fixed elements ---------- */
const bug = document.createElement('div');
bug.id = 'bug'; bug.textContent = 'EARTH ONE'; stage.appendChild(bug);

const pageCard = document.createElement('div');
pageCard.id = 'pagecard';
pageCard.innerHTML = '<div class="tag">THE SCRIPT OF THIS VIDEO</div>' +
  '<div class="ln">“This is Earth One.</div>' +
  '<div class="ln">One clear idea in every</div>' +
  '<div class="ln">video, in plain words.”</div>' +
  '<div class="tag2">PUBLISHED WITH EVERY VIDEO — COPY THE MAKING</div>';
stage.appendChild(pageCard);

const endCard = document.createElement('div');
endCard.id = 'endcard';
for (const [text, y, sz, col] of [
    ['FOLLOW FOR THE REST', 430, 84, '#92400e'],
    ['OF THE STORY', 545, 84, '#92400e'],
    ["THE PLANET'S STORY", 810, 62, '#2b2018'],
    ['WORDS IN 5 LANGUAGES', 895, 62, '#2b2018']]) {
  const d = document.createElement('div');
  d.className = 'cardtext'; d.textContent = text;
  d.style.top = (y - sz/2) + 'px'; d.style.fontSize = sz + 'px'; d.style.color = col;
  endCard.appendChild(d);
}
stage.appendChild(endCard);

/* words */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = w.size + 'px'; s.style.color = w.col;
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}

/* ---------- timeline ---------- */
function lineAt(tt) {
  for (let i = 0; i < 9; i++) {
    const gapEnd = (i < 8) ? TL[i+1][0] : CEND;
    if (tt >= TL[i][0] && tt < gapEnd) return i;
  }
  return 8;
}
function smooth(u) { return u*u*(3-2*u); }
function camXAt(t) {
  const K = PLAN.camKeys;
  if (t <= K[0][0]) return K[0][1];
  for (let i = 0; i < K.length - 1; i++) {
    if (t >= K[i][0] && t <= K[i+1][0]) {
      const u = (t - K[i][0]) / Math.max(K[i+1][0] - K[i][0], .01);
      return K[i][1] + (K[i+1][1] - K[i][1]) * smooth(Math.min(u, 1));
    }
  }
  return K[K.length - 1][1];
}
function easeOut(u) { return 1 - Math.pow(1-u, 3); }

function renderAt(t) {
  mapWorld.style.opacity = 0; stripWorld.style.opacity = 0;
  rightPlate.style.opacity = 0; pageCard.style.opacity = 0;
  endCard.style.opacity = 0; bug.style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  document.querySelectorAll('.hot').forEach(e => e.classList.remove('pulse'));
  hotRBubbles.style.opacity = 0; hotRPanel.style.opacity = 0;
  mapWorld.style.transform = ''; stripWorld.style.transform = '';
  // pointer-events follow the ACTIVE view only: the three worlds overlap
  // on stage, and an invisible world must never intercept a hover meant
  // for the visible one (found by the standalone hover probes).
  const gate = (root, on) => { root.style.pointerEvents = on ? 'auto' : 'none';
    root.querySelectorAll('*').forEach(e => e.style.pointerEvents = on ? 'auto' : 'none'); };
  gate(mapWorld, false); gate(stripWorld, false);
  rightPlate.style.pointerEvents = 'none';
  hotRBubbles.style.pointerEvents = 'none'; hotRPanel.style.pointerEvents = 'none';
  pageCard.style.pointerEvents = 'none';
  if (t < 1.6) {
    mapWorld.style.opacity = Math.min(1, t/0.6);
    gate(mapWorld, true);
    return;
  }
  if (t >= CEND) {
    mapWorld.style.opacity = 1;
    endCard.style.opacity = Math.min(1, (t - CEND)/0.6);
    endCard.style.pointerEvents = endCard.style.opacity > 0.05 ? 'auto' : 'none';
    return;
  }
  endCard.style.pointerEvents = 'none';
  const li = lineAt(t), [a, b] = TL[li];
  const p = Math.min(Math.max((t - a)/Math.max(b - a, 0.01), 0), 1);
  const view = PLAN.views[li];
  bug.style.opacity = 1;
  if (view === 'map') {
    mapWorld.style.opacity = 1;
    gate(mapWorld, true);
    if (li === 6) mapWorld.style.transform = `scale(${(1 + 0.05*p).toFixed(4)})`;
    if (li === 7) mapWorld.style.transform = `scale(${(1.05 + 0.05*p).toFixed(4)})`;
    mapWorld.style.transformOrigin = '50% 50%';
  } else if (view === 'strip') {
    stripWorld.style.opacity = 1;
    gate(stripWorld, true);
    const camX = (li === 1) ? 500 + 45*p : camXAt(t);
    stripWorld.style.transform = `translateX(${(-(camX*STRIP_S - 540)).toFixed(1)}px)`;
    stripWorld.style.transform += ` scale(${(1 + 0.03*p).toFixed(4)})`;
    stripWorld.style.transformOrigin = `${camX*STRIP_S}px 400px`;
  } else if (view === 'right') {
    rightPlate.style.opacity = 1;
    rightPlate.style.pointerEvents = 'auto';
    hotRBubbles.style.opacity = 1; hotRPanel.style.opacity = 1;
    hotRBubbles.style.pointerEvents = 'auto'; hotRPanel.style.pointerEvents = 'auto';
  }
  if (li === 5) {
    pageCard.style.opacity = Math.min(1, p/0.10, (1-p)/0.08 + 0.15);
    pageCard.style.pointerEvents = pageCard.style.opacity > 0.05 ? 'auto' : 'none';
    const seq = ['antelope','fire','hand','press','panel'];
    const k = Math.min(4, Math.floor(p*5));
    HOTS.map[seq[k]].classList.add('pulse');
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const el = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      const al = Math.min(1, (t - w.start)/0.08);
      el.style.opacity = al;
      el.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    break;
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  el.addEventListener('mouseleave', () => tip.style.display='none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const w of ['map', 'strip']) for (const k in HOTS[w]) bindNote(HOTS[w][k], NOTES[k]);
bindNote(hotRBubbles, NOTES.bubbles); bindNote(hotRPanel, NOTES.panel);
bindNote(pageCard, NOTES.page);
bindNote(endCard, NOTES.endcard);
bindNote(mapWorld.querySelector('img'), NOTES.map);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
clock.textContent = '0.0 / ' + TOTAL.toFixed(1);
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel (from the #decisions block) ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
