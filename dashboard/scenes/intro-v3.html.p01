";
const stage = document.getElementById('stage');
const aud = document.getElementById('aud');
const ramp = (t,a,b)=> t<=a?0 : t>=b?1 : (t-a)/(b-a);
const W = DATA.words;
const byLine = {}; W.forEach((w,i)=>{ (byLine[w.line] = byLine[w.line]||[]).push(i); });
const lineEnd = ln => W[byLine[ln][byLine[ln].length-1]].end;
const wordAt = (ln, txt) => W.find(w=>w.line===ln && w.word===txt);
function sentences(ln){
  const groups=[]; let cur=[];
  byLine[ln].forEach(i=>{ cur.push(i); if(/[.!?]$/.test(W[i].word.replace(/—$/,''))) { groups.push(cur); cur=[]; } });
  if(cur.length) groups.push(cur);
  return groups;
}
function wordSpan(i){ const s=document.createElement('span'); s.className='w'; s.dataset.i=i; s.textContent=W[i].word; return s; }
function capScene(ln, center){
  const sc=document.createElement('div'); sc.className='scene'; sc.id='sc'+ln;
  const cap=document.createElement('div'); cap.className='cap'+(center?' center':'');
  sentences(ln).forEach(g=>{
    const gs=document.createElement('span'); gs.className='grp'; gs.dataset.start=W[g[0]].start;
    g.forEach((wi,k)=>{ gs.appendChild(wordSpan(wi)); if(k<g.length-1) gs.appendChild(document.createTextNode(' ')); });
    cap.appendChild(gs);
  });
  sc.appendChild(cap); return sc;
}
const FILE = `<svg viewBox="0 0 76 84"><path d="M14 6 H48 L64 22 V78 H14 Z" fill="#142024" stroke="#39d5e8" stroke-width="4"/><path d="M48 6 V22 H64" fill="none" stroke="#39d5e8" stroke-width="3"/><g stroke="#39d5e8" stroke-width="4"><path d="M24 42 H54"/><path d="M24 56 H54"/><path d="M24 70 H54"/></g></svg>`;
const FOLDER = `<svg viewBox="0 0 84 76"><path d="M8 18 H34 L42 28 H76 V68 H8 Z" fill="#142024" stroke="#39d5e8" stroke-width="4"/></svg>`;
const TARGET = `<svg viewBox="0 0 76 76"><circle cx="38" cy="38" r="30" fill="none" stroke="#39d5e8" stroke-width="4"/><circle cx="38" cy="38" r="15" fill="none" stroke="#39d5e8" stroke-width="3"/><circle cx="38" cy="38" r="6" fill="#ffb43a"/></svg>`;
const CHECK = `<svg viewBox="0 0 60 60"><path d="M10 32 L24 46 L50 14" fill="none" stroke="#ffb43a" stroke-width="8"/></svg>`;
function treePanel(id, chipText, rows, extra){
  const sc=document.createElement('div'); sc.className='scene'; sc.id='sc'+id;
  const p=document.createElement('div'); p.className='tpanel'; p.id='panel'+id;
  p.innerHTML = `<div class="chip" id="chip${id}"><b>●</b> ${chipText}</div><div class="conn" id="conn${id}"></div>` + (extra||'');
  rows.forEach(r=>{
    const d=document.createElement('div'); d.className='trow trow'+id; if(r.cls) d.className+=' '+r.cls;
    d.dataset.cue=r.cue; if(r.hl!==undefined) d.dataset.hl=r.hl;
    d.style.left=r.left; d.style.top=r.top; if(r.amber) d.style.color='#ffb43a';
    d.innerHTML = r.icon + '<span>'+r.text+'</span>' + (r.check?CHECK:'');
    p.appendChild(d);
  });
  sc.appendChild(p);
  sc.appendChild(capScene(id,false).firstChild); stage.appendChild(sc);
  return sc;
}
/* ---- build scenes ---- */
/* L1 */
const sc1=document.createElement('div'); sc1.className='scene'; sc1.id='sc1';
function l1el(id, idxs){ const d=document.createElement('div'); d.className='l1w'; d.id=id;
  idxs.forEach((wi,k)=>{ d.appendChild(wordSpan(wi)); if(k<idxs.length-1) d.appendChild(document.createTextNode(' ')); }); return d; }
sc1.appendChild(l1el('wel',[byLine[1][0]]));
sc1.appendChild(l1el('thisis',byLine[1].slice(1,3)));
sc1.appendChild(l1el('namerow',byLine[1].slice(3,6)));
sc1.appendChild(l1el('tog',[byLine[1][6]]));
const rule1=document.createElement('div'); rule1.id='rule1'; sc1.appendChild(rule1);
stage.appendChild(sc1);
/* L2 */
const sc2=capScene(2,true);
const glyph=document.createElement('div'); glyph.id='glyph2';
glyph.innerHTML = `<svg viewBox="0 0 340 300" style="width:100%;height:100%">
  <g fill="#142024" stroke="#39d5e8" stroke-width="5">
    <path d="M95 30 H185 L235 80 V265 H95 Z"/><path d="M185 30 V80 H235" fill="none"/>
  </g>
  <g stroke="#39d5e8" stroke-width="5"><path d="M120 140 H210"/><path d="M120 180 H210"/><path d="M120 220 H210"/></g>
  <g><rect x="185" y="185" width="140" height="95" rx="16" fill="#0e1014" stroke="#39d5e8" stroke-width="5"/>
  <text x="212" y="252" font-size="58" font-weight="800" fill="#ffb43a" font-family="inherit">&gt;_</text></g></svg>`;
sc2.appendChild(glyph); stage.appendChild(sc2);
/* L3 */
const sc3=document.createElement('div'); sc3.className='scene'; sc3.id='sc3';
sc3.innerHTML = `<div class="plabel" id="lbl3">ARTIFICIAL</div><img id="art3" src="${ART}" alt="AGI — Artificial panel">`;
sc3.appendChild(capScene(3,false).firstChild); stage.appendChild(sc3);
/* L4 */
const sc4=document.createElement('div'); sc4.className='scene'; sc4.id='sc4';
sc4.innerHTML = `<div class="plabel" id="lbl4a">ARTIFICIAL</div><div class="plabel" id="lbl4b">AUGMENTED</div>
  <img class="p4" id="art4" src="${ART400}" alt="AGI — Artificial panel">
  <div class="p4" id="augwrap"><img id="aug4" src="${AUG}" alt="AGI — Augmented panel"></div>`;
sc4.appendChild(capScene(4,false).firstChild); stage.appendChild(sc4);
/* L5 */
const TROWS5 = [
  {icon:TARGET, text:'goal: make a video', amber:true,  left:'4.65%',  top:'13.5%',  cue:wordAt(5,'goal,').start},
  {icon:FOLDER, text:'project/',          amber:false, left:'4.65%',  top:'27.5%', cue:wordAt(5,'builds').start},
  {icon:FILE,   text:'notes.md',           amber:false, left:'14.5%',  top:'43.9%', cue:wordAt(5,'notes,').start},
  {icon:FILE,   text:'plan.md',            amber:false, left:'14.5%',  top:'59.2%', cue:wordAt(5,'plans,').start},
  {icon:FOLDER, text:'drafts/',            amber:false, left:'14.5%',  top:'71.1%', cue:wordAt(5,'drafts,').start},
  {icon:FILE,   text:'finished-video.mp4', amber:false, left:'14.5%',  top:'85%',   cue:wordAt(5,'finished').start, check:true},
];
const sc5=treePanel(5,'AGENTIC LLM',TROWS5,
  `<div id="bigfiles"><svg id="bf1" style="left:31%;top:44%" viewBox="0 0 76 84">${FILE.replace(/<svg[^>]*>|<\/svg>/g,'')}</svg><svg id="bf2" style="left:56%;top:44%" viewBox="0 0 76 84">${FILE.replace(/<svg[^>]*>|<\/svg>/g,'')}</svg></div>`);
/* L6 */
const sc6=document.createElement('div'); sc6.className='scene'; sc6.id='sc6';
sc6.innerHTML = `<div id="frame6"><div class="holes"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="play"></div></div>
  <div class="step" id="st1" style="left:35.19%">1</div><div class="step" id="st2" style="left:50%">2</div><div class="step" id="st3" style="left:64.81%">3</div>`;
sc6.appendChild(capScene(6,false).firstChild); stage.appendChild(sc6);
/* L7 (words only in v3) */
const sc7=capScene(7,true); sc7.querySelector('.cap').style.top='34.4%';
stage.appendChild(sc7);
/* L8 — this video's own production tree */
const TROWS8 = [
  {icon:FOLDER, text:'intro/',        amber:true,  left:'4.65%', top:'9.7%',  cue:DATA.l8cues[0]},
  {icon:FILE,   text:'script.md',     amber:false, left:'14.5%', top:'27.5%', cue:DATA.l8cues[1]},
  {icon:FILE,   text:'words.json',    amber:false, left:'14.5%', top:'42.8%', cue:DATA.l8cues[2]},
  {icon:FILE,   text:'narration.mp3', amber:false, left:'14.5%', top:'58.1%', cue:DATA.l8cues[3]},
  {icon:FILE,   text:'build.py',      amber:false, left:'14.5%', top:'73.3%', cue:DATA.l8cues[4]},
  {icon:FILE,   text:'intro.mp4',     amber:false, left:'14.5%', top:'85%',   cue:DATA.l8cues[5], check:true},
];
const sc8=treePanel(8,'THIS VIDEO',TROWS8,'');
/* L9 — the context, open */
const TROWS9 = [
  {icon:FILE, text:'script.md',          left:'14.5%', top:'22.2%', hl:DATA.l9hl.script},
  {icon:FILE, text:'words.json · timings', left:'14.5%', top:'38.3%', hl:DATA.l9hl.timings},
  {icon:FILE, text:'build.py · code',    left:'14.5%', top:'54.4%', hl:DATA.l9hl.code},
  {icon:FILE, text:'narration.mp3',      left:'14.5%', top:'70.6%', cls:'plain'},
  {icon:FILE, text:'intro.mp4',          left:'14.5%', top:'83.9%', cls:'plain', check:true},
];
const sc9=treePanel(9,'',TROWS9,'');
document.getElementById('chip9').remove();
const p9=document.getElementById('panel9');
const t9=document.createElement('div'); t9.id='ptitle9'; t9.textContent='production context'; p9.appendChild(t9);
const ot=document.createElement('div'); ot.id='opentag'; ot.textContent='OPEN'; p9.appendChild(ot);
/* L10 — the copy move */
const sc10=document.createElement('div'); sc10.className='scene'; sc10.id='sc10';
function miniRow(icon, text, left, top){
  return `<div class="mrow" style="left:${left};top:${top}">${icon}<span>${text}</span></div>`;
}
sc10.innerHTML = `
  <div class="p10" id="p10l"><div class="p10lab">THIS VIDEO</div>
    ${miniRow(FOLDER,'context/','13.5%','25.9%')}
    ${miniRow(FILE,'script.md','25.7%','43.7%')}
    ${miniRow(FILE,'words.json','25.7%','60%')}
    ${miniRow(FILE,'build.py','25.7%','76.3%')}
  </div>
  <div id="arrow10"></div><div id="a10head"></div>
  <div class="p10" id="p10r"><div class="p10lab" style="color:#ffb43a">YOUR PROJECT</div></div>
  <div id="frame10"><div class="play"></div></div>
  <div id="vtitle10">YOUR VIDEO</div>`;
sc10.appendChild(capScene(10,false).firstChild); stage.appendChild(sc10);
/* L11 + cover */
const sc11=capScene(11,true); sc11.querySelector('.cap').style.top='34.4%';
const cover=document.createElement('div'); cover.id='cover';
cover.innerHTML = `<div class="rule"></div>
  <div class="cv" style="top:38.8%">LET'S</div>
  <div class="cv" style="top:46.6%">BUILD IT</div>
  <div class="cv" style="top:54.4%;color:#ffb43a">TOGETHER.</div>`;
sc11.appendChild(cover); stage.appendChild(sc11);

const wordEls = {}; document.querySelectorAll('.w').forEach(el=> wordEls[el.dataset.i]=el);
const scenes = {1:sc1,2:sc2,3:sc3,4:sc4,5:sc5,6:sc6,7:sc7,8:sc8,9:sc9,10:sc10,11:sc11};
function sceneAt(t){ let s=1; for(const ln of Object.keys(DATA.switch)) if(t>=DATA.switch[ln]) s=+ln; return s; }

let playing=false, baseT=0, baseStamp=0, endedAt=null;
function nowT(){
  if(!playing) return baseT;
  if(!aud.ended && aud.currentTime>0) return aud.currentTime;
  if(endedAt!==null) return Math.min(DATA.adur + (performance.now()-endedAt)/1000, DATA.dur);
  return baseT + (performance.now()-baseStamp)/1000;
}
aud.addEventListener('ended', ()=>{ endedAt = performance.now(); });
function setPlaying(p){
  playing=p;
  document.getElementById('play').textContent = p? 'Pause':'Play';
  if(p){ endedAt = aud.ended? endedAt : null; baseStamp=performance.now(); baseT=nowT(); aud.play(); }
  else { baseT=nowT(); aud.pause(); }
}
document.getElementById('play').addEventListener('click', e=>{ e.stopPropagation(); if(nowT()>=DATA.dur-0.05 && !playing){ seek(0); } setPlaying(!playing); });
stage.addEventListener('click', ()=> setPlaying(!playing));
function seek(t){
  baseT=t; baseStamp=performance.now(); endedAt=null;
  if(t < DATA.adur-0.05){ aud.currentTime=t; } else { aud.currentTime=DATA.adur-0.05; }
  if(playing) aud.play();
}
const prog=document.getElementById('prog');
prog.addEventListener('click', e=>{ const r=prog.getBoundingClientRect(); seek(DATA.dur*(e.clientX-r.left)/r.width); });

function treeUpdate(panelId, rowSel, t, withFiles){
  const panel=document.getElementById(panelId);
  const rows=[...panel.querySelectorAll(rowSel)];
  let lastY=null, firstTop=null;
  rows.forEach(r=>{
    const cue=+r.dataset.cue, a=ramp(t, cue, cue+0.18);
    if(!r.classList.contains('plain')) r.style.opacity=a;
    r.style.transform=`translateY(${(1-a)*0.52}cqh)`;
    if(a>0){ if(firstTop===null) firstTop=r.offsetTop + r.offsetHeight/2; lastY=r.offsetTop + r.offsetHeight/2; }
  });
  const conn=document.getElementById('conn'+panelId.replace('panel',''));
  if(rows.length>1 && +rows[1].dataset.cue<=t && lastY!==null){
    conn.style.top = (firstTop/panel.offsetHeight*100)+'%';
    conn.style.height = Math.max(0,(lastY-firstTop)/panel.offsetHeight*100)+'%';
  } else conn.style.height=0;
}
function update(){
  const t = nowT();
  const sc = sceneAt(t);
  for(const ln in scenes) scenes[ln].classList.toggle('show', +ln===sc);
  /* words */
  for(const i in wordEls){
    const w=W[i], el=wordEls[i];
    el.classList.toggle('on', t>=w.start);
    el.classList.toggle('active', t>=w.start && t<Math.max(w.end, w.start+0.16));
    el.classList.toggle('dim', t>lineEnd(w.line)+0.15);
  }
  /* sentence group fades (caption scenes) */
  document.querySelectorAll('.cap').forEach(cap=>{
    const grps=[...cap.querySelectorAll('.grp')];
    grps.forEach((g,gi)=>{
      let a=1;
      if(gi+1<grps.length){ const ns=+grps[gi+1].dataset.start; if(t>=ns) a=Math.max(0,1-(t-ns)/0.3); }
      g.style.opacity=a;
    });
  });
  /* L1 rule */
  const tg=W[byLine[1][6]];
  rule1.style.width = (38.9*ramp(t, tg.end, tg.end+0.5))+'%';
  /* L2 glyph */
  glyph.style.opacity = ramp(t, DATA.switch[2], DATA.switch[2]+0.5);
  /* L3 label */
  document.getElementById('lbl3').style.opacity = ramp(t, DATA.artLbl, DATA.artLbl+0.3);
  /* L4 lighting */
  const lit = ramp(t, DATA.augTrig, DATA.augTrig+0.45);
  document.getElementById('art4').style.filter = `brightness(${0.55-0.23*lit}) saturate(${0.4-0.15*lit})`;
  document.getElementById('aug4').style.filter = `brightness(${0.5+0.5*lit}) saturate(${0.5+0.5*lit})`;
  document.getElementById('augwrap').classList.toggle('lit', lit>0.5);
  document.getElementById('lbl4b').classList.toggle('lit', lit>0.5);
  /* L5 */
  document.getElementById('chip5').style.opacity = ramp(t, DATA.switch[5], DATA.switch[5]+0.4);
  const give5 = wordAt(5,'Give').start;
  const f1 = wordAt(5,'create').start, f2 = wordAt(5,'files').start;
  const bfFade = 1-ramp(t, give5, give5+0.3);
  document.getElementById('bf1').style.opacity = ramp(t, f1, f1+0.25)*bfFade;
  document.getElementById('bf2').style.opacity = ramp(t, f2, f2+0.25)*bfFade;
  treeUpdate('panel5', '.trow5', t);
  /* L6 steps */
  const cues6=[wordAt(6,'one').start, wordAt(6,'step').start, wordAt(6,'time.').start];
  cues6.forEach((c,k)=> document.getElementById('st'+(k+1)).classList.toggle('on', t>=c));
  /* L8 */
  document.getElementById('chip8').style.opacity = ramp(t, DATA.switch[8], DATA.switch[8]+0.4);
  treeUpdate('panel8', '.trow8', t);
  /* L9 */
  const a9 = ramp(t, DATA.switch[9]+0.15, DATA.switch[9]+0.45);
  document.querySelectorAll('.trow9').forEach(r=>{
    if(!r.classList.contains('plain')) r.style.opacity=a9;
    if(r.dataset.hl!==undefined && r.dataset.hl!=='') r.classList.toggle('hl', t>=+r.dataset.hl);
  });
  document.getElementById('opentag').style.opacity = ramp(t, DATA.openT, DATA.openT+0.25);
  /* L10 */
  const la = ramp(t, DATA.switch[10], DATA.switch[10]+0.35);
  document.getElementById('p10l').style.opacity = la;
  document.querySelectorAll('#p10l .mrow').forEach(r=> r.style.opacity=la);
  const ap = ramp(t, DATA.give, DATA.agentEnd-0.05);
  document.getElementById('arrow10').style.width = (10.37*ap)+'%';
  document.getElementById('a10head').style.opacity = ap>0.85? 1:0;
  const ra = ramp(t, DATA.change, DATA.change+0.4);
  document.getElementById('p10r').style.opacity = ra;
  document.getElementById('frame10').style.opacity = ra;
  document.getElementById('vtitle10').style.opacity = ra;
  /* L11 cover */
  cover.style.opacity = ramp(t, DATA.coverT, DATA.coverT+0.55);
  document.querySelector('#sc11 .cap').style.opacity = 1-ramp(t, DATA.coverT, DATA.coverT+0.35);
  /* progress */
  document.getElementById('fill').style.width = (t/DATA.dur*100)+'%';
  document.getElementById('time').textContent = t.toFixed(1)+' / '+DATA.dur.toFixed(1)+'s';
  if(playing && t>=DATA.dur){ setPlaying(false); baseT=DATA.dur; }
  requestAnimationFrame(update);
}
function hashSeek(){ const h = parseFloat((location.hash.match(/t=([0-9.]+)/)||[])[1]); seek(isNaN(h)? 0 : Math.min(h, DATA.dur)); }
window.addEventListener('hashchange', hashSeek);
hashSeek();
update();
</script>
</body>
</html>
