"line": 5, "start": 26.98, "end": 28.006, "words": [{"w": "of", "start": 26.98, "end": 27.1, "key": false, "cx": 350, "cy": 1290}, {"w": "adoption.", "start": 27.1, "end": 27.38, "key": false, "cx": 578, "cy": 1290}]}], "elements": [{"id": "intro-logo", "on": 0.0, "off": 2.2}, {"id": "intro-name", "on": 0.0, "off": 2.2}, {"id": "outro-logo", "on": 28.848, "off": 32.348}, {"id": "outro-name", "on": 28.848, "off": 32.348}, {"id": "outro-sub", "on": 28.848, "off": 32.348}, {"id": "outro-tag", "on": 28.848, "off": 32.348}, {"id": "hdr-logo", "on": 2.2, "off": 28.848}, {"id": "hdr-line1", "on": 2.2, "off": 28.848}, {"id": "hdr-line2", "on": 2.2, "off": 28.848}, {"id": "l1-head", "on": 2.2, "off": 5.156}, {"id": "l1-date", "on": 3.26, "off": 5.156}, {"id": "l2-num", "on": 4.86, "off": 7.99}, {"id": "l2-billion", "on": 5.4, "off": 7.99}, {"id": "l2-sub", "on": 6.06, "off": 7.99}, {"id": "l2-src", "on": 6.06, "off": 7.99}, {"id": "l3-head", "on": 11.5, "off": 13.274}, {"id": "l3-crowd", "on": 7.68, "off": 13.274}, {"id": "l4-head", "on": 15.68, "off": 16.774}, {"id": "l4-crowd", "on": 12.64, "off": 16.774}, {"id": "l5-box", "on": 16.46, "off": 24.308}, {"id": "l5-chip1", "on": 18.68, "off": 24.308}, {"id": "l5-chip2", "on": 19.42, "off": 24.308}, {"id": "l5-chip3", "on": 19.94, "off": 24.308}, {"id": "l6-left", "on": 24.46, "off": 28.833}, {"id": "l6-div", "on": 23.98, "off": 28.833}, {"id": "l6-right", "on": 25.66, "off": 28.833}, {"id": "l6-foot", "on": 26.52, "off": 28.833}], "notes": {"intro-logo": "Container intro \u2014 the Spartan Cortex emblem. The channel's standing opening mark, unchanged from the published container.", "intro-name": "Container intro \u2014 the Academy name under its emblem.", "outro-logo": "Container outro \u2014 the emblem again, smaller: the close is a signature, not a second opening.", "outro-name": "Container outro \u2014 the Academy name.", "outro-sub": "Container outro \u2014 the subscribe ask in plain words (N-09).", "outro-tag": "Container outro \u2014 the series tagline.", "hdr-logo": "Header furniture \u2014 mini emblem, inside the safe rect (the v2 container put furniture at the frame edges; v3 moves it inside V-14).", "hdr-line1": "Header furniture \u2014 the series promise line, right-aligned to end at x=960 (safe rect), not x=1044 as in v2.", "hdr-line2": "Header furniture \u2014 the lane name.", "l1-head": "L1 dateline headline \u2014 the lane is a report: name + date before the fact.", "l1-date": "L1 dateline \u2014 the month the fact is true in; SoA facts are dated inside the piece, always.", "l2-num": "L2 the number \u2014 the fact itself, biggest thing on screen: the hook is the number (W-02).", "l2-billion": "L2 the unit \u2014 billion, people: scale words at headline size.", "l2-sub": "L2 qualifier \u2014 'this week' is part of the fact, not fine print: weekly users, not all-time accounts.", "l2-src": "L2 source line \u2014 the fact carries its source + date on screen (SoA lane rule; the figure is double-sourced in the script doc). Altman is named WITH his context in the same breath: the man reporting the number, at the event, on the date (T-18).", "l3-head": "L3 headline \u2014 repetition is the visceral part: not a launch spike, a weekly habit.", "l3-crowd": "L3 dot crowd \u2014 70 dots as a stadium glyph for the crowd of users (a diagram, not a portrait: the V-13 diagram exception). Abstract count made visible.", "l4-head": "L4 headline \u2014 the turn: the part nobody counts, in two words.", "l4-crowd": "L4 crowd greyed \u2014 the same 70 dots gone grey except six amber: nearly everyone rents; the lit few stand for owners of their own layer (the Academy read of the fact).", "l5-box": "L5 chat box \u2014 one bordered box: the thinnest harness there is, drawn as a container with almost nothing in it.", "l5-chip1": "L5 chip 1 \u2014 instructions: inside the box, on the provider's terms (separate component, lands with its spoken word).", "l5-chip2": "L5 chip 2 \u2014 memory.", "l5-chip3": "L5 chip 3 \u2014 files.", "l6-left": "L6 split left \u2014 adoption: total. Half of the closing equation, cyan.", "l6-div": "L6 divider \u2014 the split itself: two quantities that should move together, held apart.", "l6-right": "L6 split right \u2014 ownership: zero. Amber: the gap is the message (essence: adoption is total; ownership is zero).", "l6-foot": "L6 footer \u2014 the lane name as the close's signature (W-05 return & name)."}};
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const TOTAL = PLAN.total;

/* words (generated components, same timeline) */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = PLAN.wordSize + 'px';
    s.style.color = w.key ? '#ffb040' : '#e9e5da';
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.textShadow = '3px 4px 0 rgba(0,0,0,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}
const compEls = {};
document.querySelectorAll('.comp').forEach(e => compEls[e.id] = e);
/* L4-style count chips: individual reveal times ride in PLAN.chipTimes */
const chipEls = document.querySelectorAll('.chip.cnt');
const counterEl = compEls['l4-counter'] || null;

function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const id in compEls) compEls[id].style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  chipEls.forEach(e => e.style.opacity = 0);
  for (const e of PLAN.elements) {
    if (t >= e.on && t < e.off) {
      const el = compEls[e.id];
      el.style.opacity = Math.min(1, (t - e.on)/0.25 + 0.001);
      if (!RENDER) el.style.pointerEvents = 'auto';
    }
  }
  if (PLAN.chipTimes) {
    let n = 0;
    PLAN.chipTimes.forEach((ct, i) => {
      if (t >= ct && t < PLAN.chipOff) { chipEls[i].style.opacity = 1; n++; }
    });
    if (counterEl && t >= PLAN.chipTimes[0] && t < PLAN.chipOff)
      counterEl.textContent = 'TOKENS SO FAR: ' + n;
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const elm = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      elm.style.opacity = Math.min(1, (t - w.start)/0.08);
      elm.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    break;
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = PLAN.notes;
const tip = document.getElementById('tooltip');
function bindNote(elm, text) {
  if (RENDER || !elm) return;
  elm.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  elm.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  elm.addEventListener('mouseleave', () => tip.style.display='none');
  elm.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const id in NOTES) bindNote(compEls[id], NOTES[id]);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided.</div>`;
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
