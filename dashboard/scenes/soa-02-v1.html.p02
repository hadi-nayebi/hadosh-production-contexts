 {"w": "the", "start": 32.22, "end": 32.3, "key": false, "cx": 502, "cy": 1290}, {"w": "next", "start": 32.3, "end": 32.46, "key": false, "cx": 664, "cy": 1290}]}, {"line": 6, "start": 32.46, "end": 33.297, "words": [{"w": "count.", "start": 32.46, "end": 32.68, "key": false, "cx": 530, "cy": 1410}]}], "elements": [{"id": "intro-logo", "on": 0.0, "off": 2.2}, {"id": "intro-name", "on": 0.0, "off": 2.2}, {"id": "outro-logo", "on": 36.112, "off": 39.651}, {"id": "outro-name", "on": 36.112, "off": 39.651}, {"id": "outro-sub", "on": 36.112, "off": 39.651}, {"id": "outro-tag", "on": 36.112, "off": 39.651}, {"id": "hdr-logo", "on": 2.2, "off": 36.112}, {"id": "hdr-line1", "on": 2.2, "off": 36.112}, {"id": "hdr-line2", "on": 2.2, "off": 36.112}, {"id": "l1-head", "on": 2.2, "off": 5.002}, {"id": "l1-date", "on": 3.26, "off": 5.002}, {"id": "l2-num", "on": 4.66, "off": 8.335}, {"id": "l2-unit", "on": 5.34, "off": 8.335}, {"id": "l2-sub", "on": 6.12, "off": 8.335}, {"id": "l2-src", "on": 6.12, "off": 8.335}, {"id": "l3-head", "on": 8.04, "off": 14.545}, {"id": "l3-crowd", "on": 8.04, "off": 14.545}, {"id": "l3-u30", "on": 10.06, "off": 14.545}, {"id": "l4-head", "on": 17.46, "off": 19.302}, {"id": "l4-crowd", "on": 13.88, "off": 19.302}, {"id": "l4-sub", "on": 17.46, "off": 19.302}, {"id": "l5-box", "on": 19.04, "off": 25.985}, {"id": "l5-chip1", "on": 21.6, "off": 25.985}, {"id": "l5-chip2", "on": 23.08, "off": 25.985}, {"id": "l5-chip3", "on": 24.48, "off": 25.985}, {"id": "l6-left", "on": 25.66, "off": 29.569}, {"id": "l6-div", "on": 25.66, "off": 29.569}, {"id": "l6-right", "on": 27.28, "off": 29.569}, {"id": "l6-foot", "on": 27.28, "off": 29.569}, {"id": "l7-card", "on": 29.06, "off": 34.097}, {"id": "b-next", "on": 34.097, "off": 36.112}, {"id": "b-line", "on": 34.097, "off": 36.112}, {"id": "b-icon", "on": 34.097, "off": 36.112}, {"id": "b-title", "on": 34.097, "off": 36.112}, {"id": "b-sub", "on": 34.097, "off": 36.112}, {"id": "b-tap", "on": 34.097, "off": 36.112}], "notes": {"intro-logo": "Container intro \u2014 the Spartan Cortex emblem. The channel's standing opening mark, unchanged from the published container.", "intro-name": "Container intro \u2014 the Academy name under its emblem.", "outro-logo": "Container outro \u2014 the emblem again, smaller: the close is a signature, not a second opening.", "outro-name": "Container outro \u2014 the Academy name.", "outro-sub": "Container outro \u2014 the subscribe ask in plain words (N-09).", "outro-tag": "Container outro \u2014 the series tagline.", "hdr-logo": "Header furniture \u2014 mini emblem, inside the safe rect (the v2 container put furniture at the frame edges; v3 moves it inside V-14).", "hdr-line1": "Header furniture \u2014 the series promise line, right-aligned to end at x=960 (safe rect), not x=1044 as in v2.", "hdr-line2": "Header furniture \u2014 the lane name.", "l1-head": "L1 dateline headline \u2014 the lane is a report: name + date before the fact (the lane's sanctioned format device).", "l1-date": "L1 dateline \u2014 when/where the fact is true; SoA facts are dated inside the piece, always.", "l2-num": "L2 the number \u2014 the fact itself, biggest thing on screen: the hook is the number (W-02).", "l2-unit": "L2 the population \u2014 whose number this is, at headline size.", "l2-sub": "L2 qualifier \u2014 'have used' is Pew's ever-used measure; the piece never upgrades it to 'use daily' (script \u00a78 honesty).", "l2-src": "L2 source line \u2014 the fact carries its source + survey dates on screen (SoA lane rule; T-18: source named with its context in the same breath).", "l3-head": "L3 headline \u2014 the baseline the growth is measured against.", "l3-crowd": "L3 dot crowd \u2014 70 dots, 31 lit cyan = the 44%: the count as a crowd (a diagram, not a portrait: the V-13 diagram exception; SOA-01's crowd grammar, re-earned).", "l3-u30": "L3 the generation \u2014 most of the under-30s are in: the escalation that re-earns attention after the baseline.", "l4-head": "L4 headline \u2014 the turn, landing on the spoken word 'rented': where the adoption actually lives.", "l4-crowd": "L4 crowd greyed \u2014 the same 70 dots gone grey except six amber: the handful who were handed a key (own their layer). The L6 close cashes this image.", "l4-sub": "L4 legend \u2014 the grey/amber code stated once, in words, so the crowd reads without a caption anywhere else.", "l5-box": "L5 chat box \u2014 one bordered box: where nearly every one of the 44% met the model; its subtitle is the line's own verdict.", "l5-chip1": "L5 chip 1 \u2014 instructions: inside the box, on the provider's terms (separate component, lands with its spoken word).", "l5-chip2": "L5 chip 2 \u2014 memory.", "l5-chip3": "L5 chip 3 \u2014 files. The Academy's three nouns, counted in the box they do not survive.", "l6-left": "L6 split left \u2014 entry: half the country is in, cyan.", "l6-div": "L6 divider \u2014 two quantities that should move together, held apart (the lane's closing split grammar).", "l6-right": "L6 split right \u2014 the key that was never handed over (the script's ONE vivid detail, N-03): 'almost' is the honesty device and stays on screen.", "l6-foot": "L6 footer \u2014 the piece's T-17 essence as its signature (this piece's own words, not SOA-01's close).", "l7-card": "L7 the spoken ask on a card \u2014 the lane's two jobs stated after the close (N-09), in this piece's own bridge words (script L7, verbatim).", "b-next": "Bridge \u2014 the NEXT signpost: the referral lives here, after the close, never inside the report itself (T-16). The lane's standing bridge grammar (SOA-FIX, 2026-10-24): identical on every State of Adoption piece.", "b-line": "Bridge \u2014 the pointer sentence, in the lane's rent/own terms: the punchline (ownership zero) is a condition, not a fate. Packaging, not teaching.", "b-icon": "Bridge \u2014 a toaster, the routed song's subject, drawn as a chalk schematic: a line symbol, not an illustration, so the V-13 diagram/symbol exception applies (same basis as WD-01's bridge sphere). Amber toast + lever knob.", "b-title": "Bridge \u2014 the routed piece's title, named in full so the tap is a choice, not a tease: Hadosh Academy's song (the funnel long-form, flagship channel).", "b-sub": "Bridge \u2014 the T-18 context line: what the named piece IS (a song) and what it asks (who owns the layer) in the same breath as its title.", "b-tap": "Bridge \u2014 the tap instruction (the lane's standing bridge grammar, not a catchphrase)."}};
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const TOTAL = PLAN.total;

/* words (generated components, same timeline) */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = PLAN.wordSize + 'px';
    s.style.color = w.key ? '#ffb040' : '#e9e5da';
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.textShadow = '3px 4px 0 rgba(0,0,0,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}
const compEls = {};
document.querySelectorAll('.comp').forEach(e => compEls[e.id] = e);
/* L4-style count chips: individual reveal times ride in PLAN.chipTimes */
const chipEls = document.querySelectorAll('.chip.cnt');
const counterEl = compEls['l4-counter'] || null;

function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const id in compEls) compEls[id].style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  chipEls.forEach(e => e.style.opacity = 0);
  for (const e of PLAN.elements) {
    if (t >= e.on && t < e.off) {
      const el = compEls[e.id];
      el.style.opacity = Math.min(1, (t - e.on)/0.25 + 0.001);
      if (!RENDER) el.style.pointerEvents = 'auto';
    }
  }
  if (PLAN.chipTimes) {
    let n = 0;
    PLAN.chipTimes.forEach((ct, i) => {
      if (t >= ct && t < PLAN.chipOff) { chipEls[i].style.opacity = 1; n++; }
    });
    if (counterEl && t >= PLAN.chipTimes[0] && t < PLAN.chipOff)
      counterEl.textContent = 'TOKENS SO FAR: ' + n;
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const elm = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      elm.style.opacity = Math.min(1, (t - w.start)/0.08);
      elm.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    break;
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = PLAN.notes;
const tip = document.getElementById('tooltip');
function bindNote(elm, text) {
  if (RENDER || !elm) return;
  elm.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  elm.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  elm.addEventListener('mouseleave', () => tip.style.display='none');
  elm.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const id in NOTES) bindNote(compEls[id], NOTES[id]);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided.</div>`;
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
