": "Header furniture \u2014 mini emblem, inside the safe rect (the v2 container put furniture at the frame edges; v3 moves it inside V-14).", "hdr-line1": "Header furniture \u2014 the series promise line, right-aligned to end at x=960 (safe rect), not x=1044 as in v2.", "hdr-line2": "Header furniture \u2014 the lane name.", "l1-head": "L1 dateline headline \u2014 the lane is a report: name + date before the fact (the lane's sanctioned format device).", "l1-date": "L1 dateline \u2014 when/where the fact is true; SoA facts are dated inside the piece, always.", "l2-num": "L2 the number \u2014 the adoption figure, biggest thing on screen: the hook is the number (W-02).", "l2-unit": "L2 the population \u2014 the builders: the fastest adopters are the subject, at headline size.", "l2-sub": "L2 qualifier \u2014 the survey's own combined wording ('use or plan to use'), never upgraded to 'use daily' (script Phase 0 flag 2).", "l2-src": "L2 source line \u2014 the fact carries its source on screen (SoA lane rule; T-18). One survey carries BOTH numbers in this piece \u2014 that is its credibility move.", "l2-src2": "L2 source detail \u2014 fielding window + sample size: the lane shows its working, not just its headline.", "l3-head": "L3 headline \u2014 the baseline: the number nearly doubled in two years.", "l3-counter": "L3 the climb \u2014 velocity as the visual: adoption, performed as one jump the viewer watches land.", "l3-sub": "L3 who \u2014 the builders, named in plain words.", "l3-sub2": "L3 the identity beat \u2014 they led. L6 returns this line transformed: 'adopted the model' (N-08 bookend).", "l4-head": "L4 headline \u2014 the script's ONE vivid detail (N-03): the trust figure as the industry's unpublished statistic. The tease is paid inside the same line (the number arrives at 'forty-six'), so it never becomes debt.", "l4-num": "L4 the second number \u2014 distrust, amber: the gap's colour. Same survey, same people.", "l4-sub": "L4 what the number means, in the survey's own terms (accuracy of the output \u2014 compressed, antecedent unambiguous in context; exact item wording rides in the publish description, per the script's \u00a78).", "l4-sub2": "L4 the minority \u2014 trust is the smaller number; the asymmetry is the story.", "l5-head": "L5 headline \u2014 the villain named (N-06): The Hand-Check. Distrust converted into labour.", "l5-code": "L5 the workbench \u2014 lines of model output on a card: generic illustrative code (a diagram of the checking loop, V-13 diagram exception), each line awaiting its stamp.", "l5-stamp1": "L5 stamp 1 \u2014 the hand-check performed: each output stamped as the narration names the labour (check / hand / memory / checks beats). The speed the tool promised leaks away here, one stamp at a time.", "l5-stamp2": "L5 stamp 2 \u2014 the hand-check performed: each output stamped as the narration names the labour (check / hand / memory / checks beats). The speed the tool promised leaks away here, one stamp at a time.", "l5-stamp3": "L5 stamp 3 \u2014 the hand-check performed: each output stamped as the narration names the labour (check / hand / memory / checks beats). The speed the tool promised leaks away here, one stamp at a time.", "l5-stamp4": "L5 stamp 4 \u2014 the hand-check performed: each output stamped as the narration names the labour (check / hand / memory / checks beats). The speed the tool promised leaks away here, one stamp at a time.", "l6-head": "L6 headline \u2014 'layer' is named only now: L5's list of absences built it first (N-05: the plant is the list, the payoff is the name).", "l6-model": "L6 the model \u2014 present, adopted, boxed in cyan: the half of the stack the builders DO have.", "l6-comp1": "L6 compartment 1 \u2014 memory: an outline with nothing in it. Dashed = absent, by design (script \u00a77).", "l6-comp2": "L6 compartment 2 \u2014 instructions: the second absence.", "l6-comp3": "L6 compartment 3 \u2014 checks: the third absence; the hand-check of L5 is what fills this box by hand, every time, in the developer's head instead of a system.", "l7-card": "L7 the spoken ask on a card \u2014 stated after the close (N-09), in this piece's own bridge words (script L7, verbatim).", "b-next": "Bridge \u2014 the NEXT signpost: the referral lives here, after the close, never inside the report itself (T-16). The lane's standing bridge grammar (SOA-FIX, 2026-10-24): identical on every State of Adoption piece.", "b-line": "Bridge \u2014 the pointer sentence, in the lane's rent/own terms: the punchline (ownership zero) is a condition, not a fate. Packaging, not teaching.", "b-icon": "Bridge \u2014 a toaster, the routed song's subject, drawn as a chalk schematic: a line symbol, not an illustration, so the V-13 diagram/symbol exception applies (same basis as WD-01's bridge sphere). Amber toast + lever knob.", "b-title": "Bridge \u2014 the routed piece's title, named in full so the tap is a choice, not a tease: Hadosh Academy's song (the funnel long-form, flagship channel).", "b-sub": "Bridge \u2014 the T-18 context line: what the named piece IS (a song) and what it asks (who owns the layer) in the same breath as its title.", "b-tap": "Bridge \u2014 the tap instruction (the lane's standing bridge grammar, not a catchphrase)."}};
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const TOTAL = PLAN.total;

/* words (generated components, same timeline) */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = PLAN.wordSize + 'px';
    s.style.color = w.key ? '#ffb040' : '#e9e5da';
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.textShadow = '3px 4px 0 rgba(0,0,0,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}
const compEls = {};
document.querySelectorAll('.comp').forEach(e => compEls[e.id] = e);
/* L4-style count chips: individual reveal times ride in PLAN.chipTimes */
const chipEls = document.querySelectorAll('.chip.cnt');
const counterEl = compEls['l4-counter'] || null;

function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const id in compEls) compEls[id].style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  chipEls.forEach(e => e.style.opacity = 0);
  for (const e of PLAN.elements) {
    if (t >= e.on && t < e.off) {
      const el = compEls[e.id];
      el.style.opacity = Math.min(1, (t - e.on)/0.25 + 0.001);
      if (!RENDER) el.style.pointerEvents = 'auto';
    }
  }
  if (PLAN.chipTimes) {
    let n = 0;
    PLAN.chipTimes.forEach((ct, i) => {
      if (t >= ct && t < PLAN.chipOff) { chipEls[i].style.opacity = 1; n++; }
    });
    if (counterEl && t >= PLAN.chipTimes[0] && t < PLAN.chipOff)
      counterEl.textContent = 'TOKENS SO FAR: ' + n;
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const elm = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      elm.style.opacity = Math.min(1, (t - w.start)/0.08);
      elm.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    break;
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = PLAN.notes;
const tip = document.getElementById('tooltip');
function bindNote(elm, text) {
  if (RENDER || !elm) return;
  elm.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  elm.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  elm.addEventListener('mouseleave', () => tip.style.display='none');
  elm.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const id in NOTES) bindNote(compEls[id], NOTES[id]);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided.</div>`;
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
