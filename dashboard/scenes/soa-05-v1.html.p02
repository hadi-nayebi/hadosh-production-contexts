1}, {"id": "outro-sub", "on": 34.422, "off": 37.961}, {"id": "outro-tag", "on": 34.422, "off": 37.961}, {"id": "hdr-logo", "on": 2.2, "off": 34.422}, {"id": "hdr-line1", "on": 2.2, "off": 34.422}, {"id": "hdr-line2", "on": 2.2, "off": 34.422}, {"id": "l1-head", "on": 2.2, "off": 4.996}, {"id": "l1-date", "on": 3.26, "off": 4.996}, {"id": "l2-num", "on": 4.74, "off": 8.193}, {"id": "l2-unit", "on": 6.32, "off": 8.193}, {"id": "l2-sub", "on": 4.74, "off": 8.193}, {"id": "l2-src", "on": 5.44, "off": 8.193}, {"id": "l3-head", "on": 7.82, "off": 13.493}, {"id": "l3-house-a", "on": 7.82, "off": 13.493}, {"id": "l3-house-b", "on": 11.58, "off": 13.493}, {"id": "l3-sub", "on": 10.32, "off": 13.493}, {"id": "l4-head", "on": 14.3, "off": 19.679}, {"id": "l4-house", "on": 13.16, "off": 19.679}, {"id": "l4-sub", "on": 15.34, "off": 19.679}, {"id": "l4-sub2", "on": 16.5, "off": 19.679}, {"id": "l5-line1", "on": 19.3, "off": 23.64}, {"id": "l5-line2", "on": 21.04, "off": 23.64}, {"id": "l5-line3", "on": 21.76, "off": 23.64}, {"id": "l6-head", "on": 23.5, "off": 27.107}, {"id": "l6-house", "on": 23.5, "off": 27.107}, {"id": "l6-sub", "on": 25.2, "off": 27.107}, {"id": "l7-card", "on": 26.62, "off": 32.407}, {"id": "b-next", "on": 32.407, "off": 34.422}, {"id": "b-line", "on": 32.407, "off": 34.422}, {"id": "b-icon", "on": 32.407, "off": 34.422}, {"id": "b-title", "on": 32.407, "off": 34.422}, {"id": "b-sub", "on": 32.407, "off": 34.422}, {"id": "b-tap", "on": 32.407, "off": 34.422}], "notes": {"intro-logo": "Container intro \u2014 the Spartan Cortex emblem. The channel's standing opening mark, unchanged from the published container.", "intro-name": "Container intro \u2014 the Academy name under its emblem.", "outro-logo": "Container outro \u2014 the emblem again, smaller: the close is a signature, not a second opening.", "outro-name": "Container outro \u2014 the Academy name.", "outro-sub": "Container outro \u2014 the subscribe ask in plain words (N-09).", "outro-tag": "Container outro \u2014 the series tagline.", "hdr-logo": "Header furniture \u2014 mini emblem, inside the safe rect (the v2 container put furniture at the frame edges; v3 moves it inside V-14).", "hdr-line1": "Header furniture \u2014 the series promise line, right-aligned to end at x=960 (safe rect), not x=1044 as in v2.", "hdr-line2": "Header furniture \u2014 the lane name.", "l1-head": "L1 dateline headline \u2014 the lane is a report: name + date before the fact (the lane's sanctioned format device).", "l1-date": "L1 dateline \u2014 when/where the fact is true; SoA facts are dated inside the piece, always.", "l2-num": "L2 the number \u2014 the fact itself, biggest thing on screen: the hook is the level (script DR-1: the level is the tap; the velocity is the continue).", "l2-unit": "L2 the unit \u2014 monthly users of one app, at headline size.", "l2-sub": "L2 whose number \u2014 the app, named before the count lands.", "l2-src": "L2 source line \u2014 company-reported MAU, attributed on screen with its date (SoA lane rule; the script's \u00a78 honesty flag: the number is Alphabet's own).", "l3-head": "L3 headline \u2014 the earlier level: the house at 400M before the migration arrives.", "l3-house-a": "L3 house, earlier \u2014 cross-section with the bottom two and a half floors filled (20 of 32 figures = 400M of 650M): a building filling up, not a curve (a diagram, V-13 exception). Replaced mid-line by the full house as 'arrived' lands.", "l3-house-b": "L3 house, now \u2014 every floor full: a quarter of a billion people arrived in under half a year.", "l3-sub": "L3 the migration stated \u2014 the script's ONE vivid detail (N-03): a migration, not a growth curve.", "l4-head": "L4 headline \u2014 the turn, landing on 'inside': the mechanism stated plainly before the metaphor cashes it (script \u00a72, T-17d).", "l4-house": "L4 the walls glow \u2014 the full house re-drawn with amber walls: same crowd, new fact about it. The triple 'Google's' in the line is the drumbeat this frame holds.", "l4-sub": "L4 term 2 \u2014 the rules are the landlord's.", "l4-sub2": "L4 term 3 \u2014 the memory is the landlord's too. The villain named in the script (N-06): The Landlord's Memory.", "l5-line1": "L5 the concession \u2014 praise first, so the turn is credible (N-07: the carrier is the concession).", "l5-line2": "L5 the hinge \u2014 the room: the image the close cashes.", "l5-line3": "L5 the gap in one image \u2014 type-led on purpose: this beat is verbal (a concession + a location), and the house returns at L6 with its meaning changed.", "l6-head": "L6 headline \u2014 the count returns as a tenancy (N-08 bookend: L2's users return as guests).", "l6-house": "L6 every figure amber \u2014 badged GUEST: the same house, the same crowd, each one now visibly a guest in it.", "l6-sub": "L6 the close stated \u2014 the message was already carried plainly at L4 (walls / rules / memory), so the metaphor never carries it alone (script N-09).", "l7-card": "L7 the spoken ask on a card \u2014 stated after the close (N-09), in this piece's own bridge words (script L7, verbatim).", "b-next": "Bridge \u2014 the NEXT signpost: the referral lives here, after the close, never inside the report itself (T-16). The lane's standing bridge grammar (SOA-FIX, 2026-10-24): identical on every State of Adoption piece.", "b-line": "Bridge \u2014 the pointer sentence, in the lane's rent/own terms: the punchline (ownership zero) is a condition, not a fate. Packaging, not teaching.", "b-icon": "Bridge \u2014 a toaster, the routed song's subject, drawn as a chalk schematic: a line symbol, not an illustration, so the V-13 diagram/symbol exception applies (same basis as WD-01's bridge sphere). Amber toast + lever knob.", "b-title": "Bridge \u2014 the routed piece's title, named in full so the tap is a choice, not a tease: Hadosh Academy's song (the funnel long-form, flagship channel).", "b-sub": "Bridge \u2014 the T-18 context line: what the named piece IS (a song) and what it asks (who owns the layer) in the same breath as its title.", "b-tap": "Bridge \u2014 the tap instruction (the lane's standing bridge grammar, not a catchphrase)."}};
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const TOTAL = PLAN.total;

/* words (generated components, same timeline) */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = PLAN.wordSize + 'px';
    s.style.color = w.key ? '#ffb040' : '#e9e5da';
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.textShadow = '3px 4px 0 rgba(0,0,0,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}
const compEls = {};
document.querySelectorAll('.comp').forEach(e => compEls[e.id] = e);
/* L4-style count chips: individual reveal times ride in PLAN.chipTimes */
const chipEls = document.querySelectorAll('.chip.cnt');
const counterEl = compEls['l4-counter'] || null;

function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const id in compEls) compEls[id].style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  chipEls.forEach(e => e.style.opacity = 0);
  for (const e of PLAN.elements) {
    if (t >= e.on && t < e.off) {
      const el = compEls[e.id];
      el.style.opacity = Math.min(1, (t - e.on)/0.25 + 0.001);
      if (!RENDER) el.style.pointerEvents = 'auto';
    }
  }
  if (PLAN.chipTimes) {
    let n = 0;
    PLAN.chipTimes.forEach((ct, i) => {
      if (t >= ct && t < PLAN.chipOff) { chipEls[i].style.opacity = 1; n++; }
    });
    if (counterEl && t >= PLAN.chipTimes[0] && t < PLAN.chipOff)
      counterEl.textContent = 'TOKENS SO FAR: ' + n;
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const elm = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      elm.style.opacity = Math.min(1, (t - w.start)/0.08);
      elm.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    /* no break: under C-05 carry-over ends the previous phrase may
       still be holding while this one reveals — render EVERY phrase
       whose window contains t (at most two: bands alternate). */
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = PLAN.notes;
const tip = document.getElementById('tooltip');
function bindNote(elm, text) {
  if (RENDER || !elm) return;
  elm.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  elm.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  elm.addEventListener('mouseleave', () => tip.style.display='none');
  elm.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const id in NOTES) bindNote(compEls[id], NOTES[id]);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided.</div>`;
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
