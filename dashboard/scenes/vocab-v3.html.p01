) format('truetype'); font-weight:bold; }@font-face { font-family:'Noto Arabic'; src:url(data:font/ttf;base64,) format('truetype'); font-weight:bold; }

* { margin:0; padding:0; box-sizing:border-box; }
body { background:#111; display:flex; flex-direction:column; align-items:center;
       font-family:'DejaVu Sans', sans-serif; }
#stage { position:relative; width:1080px; height:1920px; overflow:hidden; flex:none;
         background:#000; }
.plate { position:absolute; inset:0; background-repeat:no-repeat; opacity:0; }
.ovl { position:absolute; inset:0; opacity:0; pointer-events:none; }
.ovl .bgimg { position:absolute; inset:0; background-repeat:no-repeat; }
.tx { position:absolute; white-space:nowrap; opacity:0; pointer-events:none;
      line-height:1.0; }
img.wm { position:absolute; opacity:0; pointer-events:none; }
#platecap { position:absolute; border-radius:22px; opacity:0; pointer-events:none; }
#platecap .row { display:flex; justify-content:center; align-items:center;
                 gap:22px; height:74px; }
#platecap .row span { font-weight:bold; white-space:nowrap; }
#tooltip { position:fixed; z-index:60; max-width:430px; background:rgba(16,14,12,.93);
           color:#f5efe0; border:1px solid #ffb040; border-radius:10px;
           padding:10px 14px; font-size:19px; line-height:1.35; display:none;
           pointer-events:none; font-family:'DejaVu Sans', sans-serif; }
#chrome { width:1080px; background:#1a1a1a; color:#eee; padding:14px 18px;
          display:flex; gap:14px; align-items:center; font-size:20px;
          font-family:'DejaVu Sans', sans-serif; }
#chrome button { font-family:inherit; font-size:20px; padding:8px 18px; border-radius:8px;
                 border:1px solid #ffb040; background:#26221e; color:#f5efe0; cursor:pointer; }
#bar { flex:1; height:10px; background:#333; border-radius:5px; overflow:hidden; cursor:pointer; }
#fill { height:100%; width:0%; background:#ffb040; }
#ctxpanel { width:1080px; background:#14120f; color:#e8e2d4; padding:22px 28px;
            display:none; font-size:19px; line-height:1.45;
            font-family:'DejaVu Sans', sans-serif; }
#ctxpanel h2 { color:#ffb040; font-size:26px; margin-bottom:6px; }
#ctxpanel .cov { color:#9fd48a; margin-bottom:16px; }
#ctxpanel .rec { border-top:1px solid #333; padding:12px 0; }
#ctxpanel .rec b { color:#ffb040; }
#ctxpanel .fld { color:#bdb49e; }
body.render #chrome, body.render #ctxpanel { display:none !important; }
body.render #stage { cursor:none; }

#stage { background:#F5EFE0; }
</style>
</head>
<body>
<div id="stage"></div>
<div id="tooltip"></div>
<div id="chrome">
  <button id="playbtn">▶ Play</button>
  <div id="bar"><div id="fill"></div></div>
  <span id="clock">0.0 / 0.0</span>
  <button id="ctxbtn">Production context</button>
</div>
<div id="ctxpanel"></div>
<audio id="mix" preload="auto" src="data:audio/mpeg;base64,"></audio>
<script type="application/json" id="decisions">{
 "coverage": {
  "elements_recorded": 4,
  "elements_total": 4,
  "undecided": [],
  "classes": {
   "backfill": "recorded (1)",
   "script": "recorded (cited)",
   "visuals": "recorded (cited)",
   "audio": "recorded (1)"
  }
 },
 "records": [
  {
   "id": "DR-BACKFILL",
   "element": "This HTML scene itself",
   "choice": "Backfilled 2026-10-24 (JOB BOARD-SCENES-BACKFILL): the piece predates the HTML-SCENE LAW and the board could only offer a YouTube embed, which Hadi's phone walls with a bot check. The scene is rebuilt from the piece's own production data \u2014 hidden_files/vocab01/build_vocab.py's frame code (read line by line), its water photograph, and the published MP4's own audio track (the five spoken words at their reveals, plucks and pad) \u2014 so the board plays the production file itself. Faithful, not modernized: same images, same words, same order, same timings as the published video. The MP4 is NOT re-rendered from this scene.",
   "alternatives": "Leaving the YouTube embed (rejected: unwatchable for the owner); re-cutting the piece to current law (rejected here: this job restores the production file; any re-edit is governed by the piece's own lane).",
   "context": "Hadi at Action #34, 2026-10-24: 'still the rendered video from youtube cannot watch. Need html format.' HTML-SCENE LAW (both channels): every finished piece ships as one self-contained HTML scene."
  },
  {
   "id": "DR-CARD",
   "element": "The card \u2014 one word, five languages",
   "choice": "Pack 1 \u00b7 Nature & Home, card 1 of 8: WATER. The word lands in five languages on a fixed rhythm (reveals at 1.2 / 3.1 / 5.0 / 6.9 / 8.8s) \u2014 T\u00dcRK\u00c7E su, \u0641\u0627\u0631\u0633\u06cc \u0622\u0628 (\u00e2b), ENGLISH water, DEUTSCH Wasser, FRAN\u00c7AIS eau \u2014 each spoken as it appears; the end card gathers all five. Built for Hadi's mom (Turkish + Persian speaker learning English, German, French) \u2014 she is the design viewer.",
   "alternatives": "The other seven Pack 1 words (each its own card/video in the build; only WATER was published as v3).",
   "context": "Published on Earth One 2026-10-22 (Hadi approved); files/earthone-vocab-v3-context-annex.md carries the production context."
  },
  {
   "id": "DR-VISUALS",
   "element": "Visuals \u2014 photo card",
   "choice": "The build's water photograph in the card's top window with its slow push-in (1.0 \u2192 1.05 over the hold), the dark panel carrying the rows, the '1 / 8' counter, pack name, progress dots and channel mark \u2014 drawn exactly as build_vocab.py draws them. In the scene the face is baked at both zoom states and crossfaded; the rows reveal as live text on the same timings.",
   "alternatives": "\u2014",
   "context": "Earth One vocabulary lane format: one static card per word, five languages, spoken reveals."
  },
  {
   "id": "DR-AUDIO",
   "element": "Audio \u2014 the piece's published mix",
   "choice": "The published MP4's own audio track (earthone-vocab01-water.mp4), re-encoded to MP3 192k \u2014 the exact narration + music mix viewers heard, including container intro/outro audio where the wrap added it.",
   "alternatives": "Re-mixing from the build's WAV stems (same content, one more generation of processing).",
   "context": "Fidelity rule for the backfill: the scene carries what was published, not a new mix."
  }
 ]
}</script>
<script>

"use strict";
const D = {"id": "vocab-v3", "total": 15.403, "contentEnd": 13.2, "plates": [{"id": "p0", "uri": "data:image/jpeg;base64,", "bw": 1080, "bh": 1920}, {"id": "p1", "uri": "data:image/jpeg;base64,", "bw": 1080, "bh": 1920}], "segs": [{"plate": "p0", "start": 0.0, "end": 6.6, "z0": 1.0, "z1": 1.0}, {"plate": "p1", "start": 6.6, "end": 13.2, "z0": 1.0, "z1": 1.0, "fade": 6.6}, {"plate": "p1", "start": 13.2, "end": 15.4, "z0": 1.0, "z1": 1.0}], "texts": [{"t": "T\u00dcRK\u00c7E", "x": 66, "y": 985, "size": 30, "color": "#D68A2A", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "l", "start": 1.2, "end": 13.2, "fadeIn": 0.35, "html": "T\u00dcRK\u00c7E"}, {"t": "su", "x": 540, "y": 985, "size": 76, "color": "#F5EFE0", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "start": 1.2, "end": 13.2, "fadeIn": 0.35, "html": "su"}, {"t": "\u0641\u0627\u0631\u0633\u06cc", "x": 66, "y": 1105, "size": 34, "color": "#D68A2A", "bold": true, "font": "'Noto Arabic', sans-serif", "anchor": "l", "start": 3.1, "end": 13.2, "fadeIn": 0.35, "html": "\u0641\u0627\u0631\u0633\u06cc"}, {"t": "\u0622\u0628", "x": 540, "y": 1105, "size": 74, "color": "#F5EFE0", "bold": true, "font": "'Noto Arabic', sans-serif", "anchor": "c", "start": 3.1, "end": 13.2, "fadeIn": 0.35, "html": "\u0622\u0628"}, {"t": "\u00e2b", "x": 540, "y": 1171, "size": 34, "color": "#D68A2A", "font": "'DejaVu Sans', sans-serif", "anchor": "c", "start": 3.1, "end": 13.2, "fadeIn": 0.35, "html": "\u00e2b"}, {"t": "ENGLISH", "x": 66, "y": 1295, "size": 30, "color": "#D68A2A", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "l", "start": 5.0, "end": 13.2, "fadeIn": 0.35, "html": "ENGLISH"}, {"t": "water", "x": 540, "y": 1295, "size": 64, "color": "#F5EFE0", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "start": 5.0, "end": 13.2, "fadeIn": 0.35, "html": "water"}, {"t": "DEUTSCH", "x": 66, "y": 1395, "size": 30, "color": "#D68A2A", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "l", "start": 6.9, "end": 13.2, "fadeIn": 0.35, "html": "DEUTSCH"}, {"t": "Wasser", "x": 540, "y": 1395, "size": 64, "color": "#F5EFE0", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "start": 6.9, "end": 13.2, "fadeIn": 0.35, "html": "Wasser"}, {"t": "FRAN\u00c7AIS", "x": 66, "y": 1495, "size": 30, "color": "#D68A2A", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "l", "start": 8.8, "end": 13.2, "fadeIn": 0.35, "html": "FRAN\u00c7AIS"}, {"t": "eau", "x": 540, "y": 1495, "size": 64, "color": "#F5EFE0", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "start": 8.8, "end": 13.2, "fadeIn": 0.35, "html": "eau"}], "overlays": [{"start": 13.2, "end": 15.4, "bg": "#261C14", "fadeIn": 0.4, "fadeOut": 0, "texts": [{"t": "su \u00b7 \u0622\u0628", "x": 540, "y": 700, "size": 58, "color": "#F5EFE0", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "html": "su \u00b7 \u0622\u0628"}, {"t": "water \u00b7 Wasser \u00b7 eau", "x": 540, "y": 830, "size": 58, "color": "#F5EFE0", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "html": "water \u00b7 Wasser \u00b7 eau"}, {"t": "PACK 1 \u00b7 NATURE & HOME", "x": 540, "y": 1010, "size": 40, "color": "#D68A2A", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "html": "PACK 1 \u00b7 NATURE & HOME"}, {"t": "EARTH ONE", "x": 540, "y": 1100, "size": 34, "color": "#F5EFE0", "bold": true, "font": "'DejaVu Sans', sans-serif", "anchor": "c", "html": "EARTH ONE"}]}], "imgs": [{"uri": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAeQAAAAFCAYAAACUwZ9qAAAAO0lEQVR42u3VMQEAEABE0SOOVFIIIYVU8phUYHlvuvkvlwAA35U79mxLDgB4r43dqwwA8J9DBgAAgCQ5r7AEBltOYWMAAAAASUVORK5CYII=", "x": 298, "y": 1230, "w": 484, "start": 3.1, "end": 13.2}], "platecap": null, "plan": {"timeline": [13.2], "total": 15.4, "contentEnd": 13.2, "phrases": [{"line": 1, "start": 0.0, "end": 13.2, "scene": 1, "words": [{"w": "su", "start": 1.2, "cx": 540, "cy": 985, "size": 76, "key": true, "col": "#F5EFE0", "shadow": false}, {"w": "\u0622\u0628", "start": 3.1, "cx": 540, "cy": 1105, "size": 74, "key": false, "col": "#F5EFE0", "shadow": false}, {"w": "water", "start": 5.0, "cx": 540, "cy": 1295, "size": 64, "key": false, "col": "#F5EFE0", "shadow": false}, {"w": "Wasser", "start": 6.9, "cx": 540, "cy": 1395, "size": 64, "key": false, "col": "#F5EFE0", "shadow": false}, {"w": "eau", "start": 8.8, "cx": 540, "cy": 1495, "size": 64, "key": false, "col": "#F5EFE0", "shadow": false}]}]}, "notes": {"plates": {"p0": "The card face at rest: the water photograph in its window over the panel, counter, pack name, progress dots and channel mark \u2014 as build_vocab.py draws them.", "p1": "The card face at the end of the hold: the photograph has completed its slow push-in (1.0 \u2192 1.05 over the hold)."}}};
const PLAN = D.plan, TOTAL = D.total, CEND = D.contentEnd;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');

/* plates */
const plateEls = {};
for (const p of D.plates) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + p.id;
  d.style.backgroundImage = `url(${p.uri})`;
  d.dataset.bw = p.bw; d.dataset.bh = p.bh;
  stage.appendChild(d); plateEls[p.id] = d;
}
/* overlays (cards) */
const ovlEls = D.overlays.map(o => {
  const d = document.createElement('div'); d.className = 'ovl';
  if (o.bg) d.style.background = o.bg;
  if (o.plate) {
    const b = document.createElement('div'); b.className = 'bgimg';
    const pl = D.plates.find(x => x.id === o.plate);
    b.style.backgroundImage = `url(${pl.uri})`;
    b.style.backgroundSize = pl.bw + 'px ' + pl.bh + 'px';
    b.style.backgroundPosition = '50% 50%';
    d.appendChild(b);
  }
  for (const t of o.texts || []) { const e = mkText(t); e.style.opacity = 1; d.appendChild(e); }
  stage.appendChild(d); return d;
});
function mkText(t) {
  const s = document.createElement('div');
  s.className = 'tx'; s.innerHTML = t.html;
  s.style.fontSize = t.size + 'px'; s.style.color = t.color;
  s.style.fontWeight = t.bold ? 'bold' : 'normal';
  if (t.font) s.style.fontFamily = t.font;
  if (t.spacing) s.style.letterSpacing = t.spacing + 'px';
  if (t.shadow) s.style.textShadow = t.shadow;
  if (t.bottom != null) { s.style.bottom = t.bottom + 'px'; }
  else if (t.y != null) { s.style.top = t.y + 'px'; }
  if (t.anchor === 'c') { s.style.left = t.x + 'px';
    s.style.transform = (t.bottom != null) ? 'translateX(-50%)' : 'translate(-50%,-50%)'; }
  else if (t.anchor === 'r') { s.style.right = (1080 - t.x) + 'px';
    s.style.transform = (t.bottom != null) ? 'translateX(0)' : 'translateY(-50%)'; }
  else { s.style.left = t.x + 'px';
    if (t.bottom == null) s.style.transform = 'translateY(-50%)'; }
  s._t = t;
  return s;
}
const textEls = D.texts.map(t => { const e = mkText(t); stage.appendChild(e); return e; });
const imgEls = (D.imgs || []).map(o => {
  const i = document.createElement('img'); i.className = 'wm'; i.src = o.uri;
  i.style.left = o.x + 'px'; i.style.top = o.y + 'px'; i.style.width = o.w + 'px';
  i._t = o; stage.appendChild(i); return i;
});
/* plate caption (chunk captions on a dark plate — the published
   treatment of the plate-era pieces, reproduced faithfully) */
let capEl = null, capIdx = -1;
if (D.platecap) {
  capEl = document.createElement('div'); capEl.id = 'platecap';
  const pc = D.platecap;
  capEl.style.left = pc.x + 'px'; capEl.style.width = pc.w + 'px';
  capEl.style.bottom = pc.bottom + 'px'; capEl.style.background = pc.bg;
  stage.appendChild(capEl);
}
function fade(t, w) {
  if (t < w.start || t > w.end) return 0;
  let o = 1;
  if (w.fadeIn) o = Math.min(o, (t - w.start) / w.fadeIn);
  if (w.fadeOut) o = Math.min(o, (w.end - t) / w.fadeOut);
  return Math.max(0, Math.min(1, o));
}
function renderAt(t) {
  /* plates: segments drive zoom/pan; crossfade where a seg asks */
  for (const k in plateEls) plateEls[k].style.opacity = 0;
  let si = -1;
  for (let i = 0; i < D.segs.length; i++)
    if (t >= D.segs[i].start && t < D.segs[i].end) si = i;
  if (si < 0) si = t < D.segs[0].start ? 0 : D.segs.length - 1;
  const seg = D.segs[si];
  const p = Math.min(Math.max((t - seg.start) / Math.max(seg.end - seg.start, 0.01), 0), 1);
  const show = (sg, o) => {
    const el = plateEls[sg.plate]; if (!el) return;
    const z = (sg.z0 + (sg.z1 - sg.z0) * Math.min(Math.max((t - sg.start) / Math.max(sg.end - sg.start, 0.01), 0), 1));
    const bw = parseFloat(el.dataset.bw), bh = parseFloat(el.dataset.bh);
    el.style.backgroundSize = (bw * z) + 'px ' + (bh * z) + 'px';
    const fx = sg.pan ? (sg.pan[0] + (sg.pan[1] - sg.pan[0]) * p) : 0.5;
    el.style.backgroundPosition = (fx * 100) + '% 50%';
    el.style.opacity = o;
    if (!RENDER && o > 0) el.style.pointerEvents = 'auto';
  };
  if (seg.fade && si > 0 && t < seg.start + seg.fade) {
    const u = (t - seg.start) / seg.fade;
    show(D.segs[si - 1], 1 - u); show(seg, u);
  } else show(seg, 1);
  for (const [i, o] of ovlEls.entries()) {
    const w = D.overlays[i];
    o.style.opacity = fade(t, w);
    if (!RENDER && o.style.opacity > 0) o.style.pointerEvents = 'auto';
  }
  for (const e of textEls) e.style.opacity = fade(t, e._t);
  for (const e of imgEls) e.style.opacity = fade(t, e._t);
  if (capEl) {
    const pc = D.platecap;
    let idx = -1;
    for (let i = 0; i < pc.chunks.length; i++)
      if (t >= pc.chunks[i].start && t < CEND) idx = i;
    if (t < pc.chunks[0].start) idx = -1;
    if (idx !== capIdx) {
      capIdx = idx;
      if (idx < 0) { capEl.style.opacity = 0; capEl.innerHTML = ''; }
      else {
        const ch = pc.chunks[idx];
        capEl.style.height = (ch.rows.length * pc.rowH + pc.padV) + 'px';
        capEl.style.paddingTop = pc.padTop + 'px';
        capEl.innerHTML = ch.rows.map((r, ri) =>
          `<div class="row" style="height:${pc.rowH}px${ri === 0 && pc.firstRowDy ? ';margin-top:' + pc.firstRowDy + 'px' : ''}">` +
          r.map(w => `<span style="font-size:${pc.size}px;color:${w.col};font-family:${pc.font}">${w.t}</span>`).join('') +
          `</div>`).join('');
        capEl.style.opacity = 1;
      }
    }
  }
}
window.renderAt = renderAt;

/* hover notes */
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el || !text) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display = 'block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX + 18) + 'px'; tip.style.top = (e.clientY + 16) + 'px'; });
  el.addEventListener('mouseleave', () => tip.style.display = 'none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display = 'block';
    tip.style.left = (e.clientX + 18) + 'px'; tip.style.top = (e.clientY + 16) + 'px'; });
}
for (const p of D.plates) bindNote(plateEls[p.id], (D.notes.plates || {})[p.id]);

/* chrome */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100 * audio.currentTime / TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* production-context panel (from the #decisions block) */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});

</script>
</body>
</html>
