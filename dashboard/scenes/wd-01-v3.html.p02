: 545, "cy": 1290}, {"w": "pay,", "start": 27.92, "end": 28.16, "key": false, "cx": 706, "cy": 1290}]}, {"line": 4, "start": 28.5, "end": 28.9, "words": [{"w": "how", "start": 28.5, "end": 28.7, "key": false, "cx": 384, "cy": 1410}, {"w": "much", "start": 28.7, "end": 28.8, "key": false, "cx": 577, "cy": 1410}, {"w": "it", "start": 28.8, "end": 28.9, "key": false, "cx": 723, "cy": 1410}]}, {"line": 4, "start": 28.9, "end": 29.34, "words": [{"w": "can", "start": 28.9, "end": 29.0, "key": false, "cx": 392, "cy": 1290}, {"w": "hold", "start": 29.0, "end": 29.2, "key": false, "cx": 556, "cy": 1290}, {"w": "at", "start": 29.2, "end": 29.34, "key": false, "cx": 694, "cy": 1290}]}, {"line": 4, "start": 29.34, "end": 30.308, "words": [{"w": "once.", "start": 29.34, "end": 29.58, "key": false, "cx": 530, "cy": 1410}]}, {"line": 5, "start": 30.0, "end": 30.42, "words": [{"w": "So", "start": 30.0, "end": 30.2, "key": false, "cx": 382, "cy": 1290}, {"w": "that's", "start": 30.2, "end": 30.38, "key": false, "cx": 553, "cy": 1290}, {"w": "a", "start": 30.38, "end": 30.42, "key": false, "cx": 700, "cy": 1290}]}, {"line": 5, "start": 30.42, "end": 31.54, "words": [{"w": "token:", "start": 30.42, "end": 30.7, "key": true, "cx": 425, "cy": 1410}, {"w": "not", "start": 31.2, "end": 31.44, "key": false, "cx": 620, "cy": 1410}, {"w": "a", "start": 31.44, "end": 31.54, "key": false, "cx": 726, "cy": 1410}]}, {"line": 5, "start": 31.54, "end": 32.46, "words": [{"w": "word", "start": 31.54, "end": 31.78, "key": false, "cx": 378, "cy": 1290}, {"w": "a", "start": 32.22, "end": 32.3, "key": false, "cx": 512, "cy": 1290}, {"w": "chunk", "start": 32.3, "end": 32.46, "key": true, "cx": 664, "cy": 1290}]}, {"line": 5, "start": 32.46, "end": 33.4, "words": [{"w": "of", "start": 32.46, "end": 32.6, "key": false, "cx": 280, "cy": 1410}, {"w": "text,", "start": 32.6, "end": 32.98, "key": false, "cx": 423, "cy": 1410}, {"w": "counted", "start": 33.16, "end": 33.4, "key": false, "cx": 673, "cy": 1410}]}, {"line": 5, "start": 33.4, "end": 34.658, "words": [{"w": "by", "start": 33.4, "end": 33.56, "key": false, "cx": 339, "cy": 1290}, {"w": "machines.", "start": 33.56, "end": 33.9, "key": true, "cx": 585, "cy": 1290}]}], "elements": [{"id": "intro-logo", "on": 0.0, "off": 2.2}, {"id": "intro-name", "on": 0.0, "off": 2.2}, {"id": "outro-logo", "on": 38.5, "off": 41.998}, {"id": "outro-name", "on": 38.5, "off": 41.998}, {"id": "outro-sub", "on": 38.5, "off": 41.998}, {"id": "outro-tag", "on": 38.5, "off": 41.998}, {"id": "hdr-logo", "on": 2.2, "off": 38.5}, {"id": "hdr-line1", "on": 2.2, "off": 38.5}, {"id": "hdr-line2", "on": 2.2, "off": 38.5}, {"id": "l1-quick", "on": 2.2, "off": 3.995}, {"id": "l1-token", "on": 3.08, "off": 3.995}, {"id": "l2-head", "on": 3.74, "off": 9.278}, {"id": "l2-word", "on": 6.3, "off": 9.278}, {"id": "l2-chips", "on": 8.16, "off": 9.278}, {"id": "l3-letters", "on": 9.68, "off": 13.255}, {"id": "l3-words", "on": 10.86, "off": 13.255}, {"id": "l3-tokens", "on": 12.06, "off": 13.255}, {"id": "l4-head", "on": 13.66, "off": 23.259}, {"id": "l4-chips", "on": 18.7, "off": 23.259}, {"id": "l4-counter", "on": 18.7, "off": 23.259}, {"id": "l5-head", "on": 24.18, "off": 30.408}, {"id": "l5-tile1", "on": 26.34, "off": 30.408}, {"id": "l5-tile2", "on": 27.18, "off": 30.408}, {"id": "l5-tile3", "on": 27.92, "off": 30.408}, {"id": "l5-tile4", "on": 28.9, "off": 30.408}, {"id": "l6-card", "on": 30.0, "off": 35.5}, {"id": "b-next", "on": 35.5, "off": 38.5}, {"id": "b-line", "on": 35.5, "off": 38.5}, {"id": "b-sphere", "on": 35.5, "off": 38.5}, {"id": "b-dir", "on": 35.5, "off": 38.5}, {"id": "b-tap", "on": 35.5, "off": 38.5}], "notes": {"intro-logo": "Container intro \u2014 the Spartan Cortex emblem. The channel's standing opening mark, unchanged from the published container.", "intro-name": "Container intro \u2014 the Academy name under its emblem.", "outro-logo": "Container outro \u2014 the emblem again, smaller: the close is a signature, not a second opening.", "outro-name": "Container outro \u2014 the Academy name.", "outro-sub": "Container outro \u2014 the subscribe ask in plain words (N-09).", "outro-tag": "Container outro \u2014 the series tagline.", "hdr-logo": "Header furniture \u2014 mini emblem, inside the safe rect (the v2 container put furniture at the frame edges; v3 moves it inside V-14).", "hdr-line1": "Header furniture \u2014 the series promise line, right-aligned to end at x=960 (safe rect), not x=1044 as in v2.", "hdr-line2": "Header furniture \u2014 the lane name.", "l1-quick": "L1 kicker \u2014 the lane's signature cold question opens here.", "l1-token": "L1 hero word \u2014 the word being defined, giant; the amber ? is the question the short answers.", "l2-head": "L2 headline \u2014 definition by correction: the misconception dies first (S-01).", "l2-word": "L2 example word \u2014 one long word, whole, before it is cut into pieces: the concrete example carried through (T-17a).", "l2-chips": "L2 token chips \u2014 'unhappiness' cut the way the machine actually cuts it: un / h / appiness. VERIFIED 2026-10-24 against tiktoken cl100k_base (the GPT-4 tokenizer): token ids 359 / 71 / 67391; o200k_base, p50k_base and GPT-2's tokenizer agree. The pre-fix chips (un / happi / ness) were an unverified guess (Said=Shown audit finding A-8). The row is centred and width-asserted (the i2 chip row ran to x=1047; this row measures inside the safe rect).", "l3-letters": "L3 contrast row 1 \u2014 letters, struck through: not the unit.", "l3-words": "L3 contrast row 2 \u2014 words, struck through: not the unit.", "l3-tokens": "L3 contrast row 3 \u2014 tokens, cyan and large: the unit the machine actually reads.", "l4-head": "L4 rule headline \u2014 the countable rule of thumb, stated before it is performed.", "l4-chips": "L4 live count \u2014 the sentence counts itself: five chips land one per spoken word. Chips are separate components revealed in step with the count (see plan chipTimes).", "l4-counter": "L4 counter \u2014 ticks 0\u21925 as the count chips land (JS reads plan chipTimes; the count is performed, not asserted).", "l5-head": "L5 headline \u2014 the stakes sentence as a diagram title.", "l5-tile1": "L5 tile 1 of 4 \u2014 reads: what the model takes in is measured in tokens.", "l5-tile2": "L5 tile 2 of 4 \u2014 writes.", "l5-tile3": "L5 tile 3 of 4 \u2014 cost.", "l5-tile4": "L5 tile 4 of 4 \u2014 context window.", "l6-card": "L6 definition card \u2014 the earned close: the definition alone, on a card, nothing imported (T-16).", "b-next": "Bridge \u2014 the NEXT signpost: the direction pointer lives here, after the close, never inside the teaching arc (T-16).", "b-line": "Bridge \u2014 the pointer sentence, packaging not teaching.", "b-sphere": "Bridge \u2014 the direction symbol (Hadi, 2026-10-21): a wireframe sphere with an arrow inside it. Lines ARE the content here (a schematic symbol), so the diagram exception to V-13 applies.", "b-dir": "Bridge \u2014 the routed piece's title, named so the tap is a choice, not a tease.", "b-tap": "Bridge \u2014 the tap instruction."}, "chipTimes": [18.7, 18.8, 19.6, 20.42, 21.76], "chipOff": 23.259};
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const TOTAL = PLAN.total;

/* words (generated components, same timeline) */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = PLAN.wordSize + 'px';
    s.style.color = w.key ? '#ffb040' : '#e9e5da';
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.textShadow = '3px 4px 0 rgba(0,0,0,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}
const compEls = {};
document.querySelectorAll('.comp').forEach(e => compEls[e.id] = e);
/* L4-style count chips: individual reveal times ride in PLAN.chipTimes */
const chipEls = document.querySelectorAll('.chip.cnt');
const counterEl = compEls['l4-counter'] || null;

function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const id in compEls) compEls[id].style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  chipEls.forEach(e => e.style.opacity = 0);
  for (const e of PLAN.elements) {
    if (t >= e.on && t < e.off) {
      const el = compEls[e.id];
      el.style.opacity = Math.min(1, (t - e.on)/0.25 + 0.001);
      if (!RENDER) el.style.pointerEvents = 'auto';
    }
  }
  if (PLAN.chipTimes) {
    let n = 0;
    PLAN.chipTimes.forEach((ct, i) => {
      if (t >= ct && t < PLAN.chipOff) { chipEls[i].style.opacity = 1; n++; }
    });
    if (counterEl && t >= PLAN.chipTimes[0] && t < PLAN.chipOff)
      counterEl.textContent = 'TOKENS SO FAR: ' + n;
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const elm = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      elm.style.opacity = Math.min(1, (t - w.start)/0.08);
      elm.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    break;
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = PLAN.notes;
const tip = document.getElementById('tooltip');
function bindNote(elm, text) {
  if (RENDER || !elm) return;
  elm.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  elm.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  elm.addEventListener('mouseleave', () => tip.style.display='none');
  elm.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const id in NOTES) bindNote(compEls[id], NOTES[id]);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided.</div>`;
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>

