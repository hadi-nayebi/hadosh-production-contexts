7-please", "on": 29.507, "off": 33.354}, {"id": "b7-card", "on": 29.407, "off": 33.354}, {"id": "b7-peel", "on": 29.507, "off": 33.354}, {"id": "b7-dirlab", "on": 31.967, "off": 33.354}, {"id": "b7-arrow", "on": 31.967, "off": 33.354}, {"id": "b7-foot", "on": 31.347, "off": 33.354}, {"id": "b8-carda", "on": 33.304, "off": 39.296}, {"id": "b8-laba", "on": 33.364, "off": 39.296}, {"id": "b8-labb", "on": 34.784, "off": 39.296}, {"id": "b8-cardb", "on": 34.784, "off": 39.296}, {"id": "b8-arrow", "on": 36.444, "off": 39.296}, {"id": "b8-labb2", "on": 36.444, "off": 39.296}, {"id": "br-next", "on": 39.296, "off": 42.296}, {"id": "br-line", "on": 39.296, "off": 42.296}, {"id": "br-title", "on": 39.296, "off": 42.296}, {"id": "br-tap", "on": 39.296, "off": 42.296}], "notes": {"intro-logo": "Container intro \u2014 the Spartan Cortex emblem. The channel's standing opening mark, unchanged from the published container.", "intro-name": "Container intro \u2014 the Academy name under its emblem.", "outro-logo": "Container outro \u2014 the emblem again, smaller: the close is a signature, not a second opening.", "outro-name": "Container outro \u2014 the Academy name.", "outro-sub": "Container outro \u2014 the subscribe ask in plain words (N-09).", "outro-tag": "Container outro \u2014 the series tagline.", "hdr-logo": "Header furniture \u2014 mini emblem, inside the safe rect.", "hdr-line1": "Header furniture \u2014 the series promise line, right-aligned to end at x=960 (safe rect).", "hdr-line2": "Header furniture \u2014 the lane name.", "b1-qa": "B1 question mark over answer one \u2014 the cause of the difference is withheld (HS-02): both cards carry a '?'.", "b1-card-a": "B1 answer card one \u2014 grey: the vague prompt's answer, drawn as text lines (the answer IS text; lines are its honest glyph). Duller, shorter, uneven.", "b1-lab-a": "B1 label \u2014 answer one.", "b1-qb": "B1 question mark over answer two.", "b1-card-b": "B1 answer card two \u2014 amber: the directed prompt's answer. Fuller, even lines: the quality difference is visible before it is explained (V-12).", "b1-lab-b": "B1 label \u2014 answer two.", "b1-same": "B1 bridge word \u2014 'SAME AI' laid across both cards: one model produced both. The plan's centre overlap, kept.", "b2-prompt": "B2 hero word \u2014 the suspect named at headline size, at the spoken word 'prompt' (no tease debt, HS-03).", "b2-arrow": "B2 arrow \u2014 names point down at their gloss: the word is the text typed in.", "b2-box": "B2 gloss box \u2014 'the text typed in': the definition's plain-words form inside a typed-text pill.", "b3-head": "B3 headline \u2014 the count is announced before it is counted: a promise the tiles keep one by one.", "b3-tile1": "B3 tile 1 \u2014 WHAT TO DO: lands on the spoken 'what' of 'what to do'.", "b3-tile2": "B3 tile 2 \u2014 WHO IT'S FOR: lands on 'who'.", "b3-tile3": "B3 tile 3 \u2014 WHAT SHAPE: lands on the second 'what'; the count of three is complete on screen exactly as the sentence completes it.", "b4-card": "B4 the vague prompt itself, in a grey pill \u2014 the exact typed words (said = shown: the quote is performed, not paraphrased).", "b4-lines": "B4 the dump \u2014 five uneven grey lines under the prompt: length without shape, the textbook answer nobody reads.", "b4-stack": "B4 textbook stack \u2014 three book slabs: the dump's weight made visible (diagram glyph, V-13 exception).", "b4-lab": "B4 label \u2014 names the stack as the spoken line lands on 'dump.'", "b5-card": "B5 the directed prompt in full, inside the amber card \u2014 the performed proof: every constraint the sentence names (five lines / fourteen-year-old / garden example) is readable on the card it describes.", "b5-lines": "B5 five tidy lines \u2014 the answer's shape, counted: five lines because the prompt asked for five (HS-04 loop b, paid visually).", "b5-sprout": "B5 the garden example, drawn as a sprout at the spoken word 'garden' \u2014 a line symbol for the one concrete example (V-13 diagram/symbol exception).", "b5-lab": "B5 verdict label \u2014 the plan's payoff line, amber: this answer is usable, in the piece's own spoken words.", "b6-labl": "B6 left header \u2014 one use.", "b6-bubble": "B6 the prompt as one chat bubble \u2014 'this chat': it lives in a single conversation.", "b6-trail": "B6 fade trail \u2014 the bubble's dotted after-image, fading: one use, then gone (the lifespan claim drawn, not just said).", "b6-labl2": "B6 left verdict \u2014 lands on the first 'once,': the prompt's lifespan, named.", "b6-div": "B6 divider \u2014 the split itself: once vs standing, two regimes of text held apart.", "b6-labr": "B6 right header \u2014 every time.", "b6-board": "B6 the standing rule-board \u2014 amber rules on top, a row of chat bubbles beneath it: the rules stand BEHIND every chat (L6's claim in one frame; the board is a diagram of standing structure, V-13 exception).", "b6-labr2": "B6 right verdict \u2014 the standing layer's name.", "b6-labr3": "B6 gloss \u2014 the spoken sentence's second half as the frame's caption, landing on 'set'.", "b7-please": "B7 the folk fix, as a word \u2014 it sits on the vague card like a sticker.", "b7-card": "B7 the vague card, bare \u2014 the sticker is the only thing the folk fix adds to it.", "b7-peel": "B7 the peel \u2014 the sticker lifting off the card's corner: politeness comes away and nothing underneath changes.", "b7-dirlab": "B7 the real fix, named.", "b7-arrow": "B7 the steering arrow \u2014 a drawn direction on a card, everyday sense only (script DR-3: no vector model is invoked \u2014 no sphere, no axes).", "b7-foot": "B7 verdict line \u2014 lands on the second 'Adding': the dead solution dies, the fix names itself (N-05).", "b8-carda": "B8 the question card returns, grey \u2014 two lines only: a question only asks.", "b8-laba": "B8 left verdict \u2014 the mechanism's negative half.", "b8-labb": "B8 right header \u2014 the prompt, named over its card.", "b8-cardb": "B8 the prompt card returns, amber and fuller \u2014 steering ahead of the model's first written word (HS-04 loop a, paid: the L1 pair returns labelled).", "b8-arrow": "B8 down arrow \u2014 the prompt is set BEFORE the writing below it: position is the claim.", "b8-labb2": "B8 right verdict \u2014 the definition's timing clause as the frame's caption.", "br-next": "Bridge \u2014 the NEXT signpost: referrals live after the close, never inside the teaching arc (T-16).", "br-line": "Bridge \u2014 the pointer sentence (script \u00a77 card, verbatim): what you type joins the active context \u2014 the next piece's subject.", "br-title": "Bridge \u2014 the routed piece's title, named in full (WD-04, script locked) so the tap is a choice.", "br-tap": "Bridge \u2014 the tap instruction."}};
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const TOTAL = PLAN.total;

/* words (generated components, same timeline) */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = PLAN.wordSize + 'px';
    s.style.color = w.key ? '#ffb040' : '#e9e5da';
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.textShadow = '3px 4px 0 rgba(0,0,0,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}
const compEls = {};
document.querySelectorAll('.comp').forEach(e => compEls[e.id] = e);
const chipEls = document.querySelectorAll('.chip.cnt');
const counterEl = compEls['l4-counter'] || null;

function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const id in compEls) compEls[id].style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  chipEls.forEach(e => e.style.opacity = 0);
  for (const e of PLAN.elements) {
    if (t >= e.on && t < e.off) {
      const el = compEls[e.id];
      el.style.opacity = Math.min(1, (t - e.on)/0.25 + 0.001);
      if (!RENDER) el.style.pointerEvents = 'auto';
    }
  }
  if (PLAN.chipTimes) {
    let n = 0;
    PLAN.chipTimes.forEach((ct, i) => {
      if (t >= ct && t < PLAN.chipOff) { chipEls[i].style.opacity = 1; n++; }
    });
    if (counterEl && t >= PLAN.chipTimes[0] && t < PLAN.chipOff)
      counterEl.textContent = 'TOKENS SO FAR: ' + n;
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const elm = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      elm.style.opacity = Math.min(1, (t - w.start)/0.08);
      elm.style.transform = `translate(-50%,-50%) scale(${s.toFixed(3)})`;
    });
    /* no break: under C-05 carry-over ends the previous phrase may
       still be holding while this one reveals — render EVERY phrase
       whose window contains t (at most two: bands alternate). */
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = PLAN.notes;
const tip = document.getElementById('tooltip');
function bindNote(elm, text) {
  if (RENDER || !elm) return;
  elm.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  elm.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  elm.addEventListener('mouseleave', () => tip.style.display='none');
  elm.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const id in NOTES) bindNote(compEls[id], NOTES[id]);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const WDEC = JSON.parse(document.getElementById('worddecisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided.<br>Word decisions: ${WDEC.coverage.decided} of ${WDEC.coverage.total} words decided · ${WDEC.coverage.undecided} undecided.</div>`;
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
