<div class="comp imgwrap" id="l6-ring" style="left:120px;top:470px;width:580px;"><svg width="580" height="580" viewBox="0 0 580 580"><circle cx="290" cy="290" r="266" fill="none" stroke="#96969f" stroke-width="4" stroke-dasharray="12 14"/><g stroke="#ffb040" stroke-width="6" fill="none"><path d="M150 130 L290 130 L290 450 L150 450 Z"/><path d="M290 130 L404 130 Q430 130 430 168 L430 450 L290 450"/></g><g stroke="#ffb040" stroke-width="7" stroke-linecap="round"><path d="M182 216 L258 216"/><path d="M182 290 L258 290"/><path d="M182 364 L236 364"/><path d="M322 216 L398 216"/><path d="M322 290 L376 290"/></g></svg></div>
