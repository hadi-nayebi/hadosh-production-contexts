) format('truetype'); font-weight:bold; }
* { margin:0; padding:0; box-sizing:border-box; }
body { background:#0b0b0e; display:flex; flex-direction:column; align-items:center;
       font-family:'DejaVu Sans', sans-serif; }
#stage { position:relative; width:1080px; height:1920px; overflow:hidden;
         background:#111116; flex:none; }
.comp { position:absolute; opacity:0; pointer-events:none; line-height:1.25; }
.emailwin { border:3px solid #e9e5da; border-radius:18px; background:rgba(233,229,218,.03); }
.ew-h { font-size:28px; font-weight:bold; color:#96969f; padding:26px 36px 18px;
        border-bottom:2px solid #3a3a44; letter-spacing:2px; }
.ew-l { height:11px; background:#8a877e; border-radius:6px; margin:34px 36px 0; }
.sendbtn { border:3px solid #ffb040; border-radius:12px; color:#ffb040; font-size:42px;
           font-weight:bold; padding:10px 30px; background:rgba(255,176,64,.05); }
.sendbtn-full { position:absolute; right:36px; bottom:34px; background:#ffb040; color:#111116;
           border-radius:12px; font-size:42px; font-weight:bold; padding:10px 30px; }
.door5 { border:3px solid #55565f; border-radius:12px; text-align:center;
         background:rgba(150,150,159,.04); }
.door-x { font-size:64px; font-weight:bold; color:#96969f; margin-top:86px; }
.door-l { font-size:29px; font-weight:bold; color:#96969f; margin-top:64px; letter-spacing:2px; }
.bar5 { border:3px solid #ffb040; border-radius:14px; background:rgba(255,176,64,.06);
        display:flex; align-items:center; justify-content:space-between;
        padding:0 38px; font-size:50px; font-weight:bold; color:#e9e5da; }
.bar5 .chk { color:#5eead4; }
.reqcard { border:3px solid #e9e5da; border-radius:16px; text-align:center;
           background:rgba(233,229,218,.03); }
.rq-t { font-size:29px; font-weight:bold; color:#96969f; letter-spacing:3px; margin-top:34px; }
.rq-b { font-size:40px; font-weight:bold; color:#e9e5da; margin-top:22px; }
.repchip { display:inline-block; border:3px solid #5eead4; border-radius:12px; color:#5eead4;
           font-size:38px; font-weight:bold; padding:10px 26px; margin-top:14px;
           background:rgba(94,234,212,.06); }
.gatebox { border:3px solid #e9e5da; border-radius:18px; height:330px;
           display:flex; align-items:center; justify-content:center;
           background:rgba(233,229,218,.03); }
.bub { display:inline-block; width:52px; height:34px; border:3px solid #96969f;
       border-radius:12px; margin-right:12px; background:rgba(150,150,159,.06); }
.pill5 { border:3px solid #5eead4; border-radius:999px; color:#5eead4; font-size:40px;
         font-weight:bold; padding:13px 36px; background:rgba(94,234,212,.05); letter-spacing:1px; }
.word { position:absolute; font-weight:bold; white-space:nowrap; opacity:0;
        pointer-events:none; will-change:transform,opacity; }
#tooltip { position:fixed; z-index:60; max-width:430px; background:rgba(16,14,12,.93);
           color:#f5efe0; border:1px solid #ffb040; border-radius:10px;
           padding:10px 14px; font-size:19px; line-height:1.35; display:none;
           pointer-events:none; font-family:'DejaVu Sans'; }
#chrome { width:1080px; background:#1a1a1a; color:#eee; padding:14px 18px;
          display:flex; gap:14px; align-items:center; font-size:20px; }
#chrome button { font-family:inherit; font-size:20px; padding:8px 18px; border-radius:8px;
                 border:1px solid #ffb040; background:#26221e; color:#f5efe0; cursor:pointer; }
#bar { flex:1; height:10px; background:#333; border-radius:5px; overflow:hidden; cursor:pointer; }
#fill { height:100%; width:0%; background:#ffb040; }
#ctxpanel { width:1080px; background:#14120f; color:#e8e2d4; padding:22px 28px;
            display:none; font-size:19px; line-height:1.45; }
#ctxpanel h2 { color:#ffb040; font-size:26px; margin-bottom:6px; }
#ctxpanel .cov { color:#9fd48a; margin-bottom:16px; }
#ctxpanel .rec { border-top:1px solid #333; padding:12px 0; }
#ctxpanel .rec b { color:#ffb040; }
#ctxpanel .fld { color:#bdb49e; }
body.render #chrome, body.render #ctxpanel { display:none !important; }
body.render #stage { cursor:none; }
body.render .comp { pointer-events:none !important; }
</style>
</head>
<body>
<div id="stage">
<div class="comp imgwrap" id="intro-logo" style="left:370px;top:600px;width:340px;"><img src="data:image/png;base64," style="width:340px;"></div>
<div class="comp" id="intro-name" style="left:0;width:1080px;text-align:center;top:1148px;font-size:64px;color:#e9e5da;letter-spacing:6px;font-family:'DejaVu Sans';font-weight:bold;">HADOSH ACADEMY</div>
<div class="comp imgwrap" id="outro-logo" style="left:430px;top:430px;width:220px;"><img src="data:image/png;base64," style="width:220px;"></div>
<div class="comp" id="outro-name" style="left:0;width:1080px;text-align:center;top:802px;font-size:56px;color:#e9e5da;letter-spacing:5px;font-weight:bold;">HADOSH ACADEMY</div>
<div class="comp" id="outro-sub" style="left:0;width:1080px;text-align:center;top:962px;font-size:96px;color:#ffb040;font-weight:bold;">SUBSCRIBE</div>
<div class="comp" id="outro-tag" style="left:0;width:1080px;text-align:center;top:1135px;font-size:30px;color:#e9e5da;">Follow for your daily bite of agentic literacy</div>
<div class="comp imgwrap" id="hdr-logo" style="left:100px;top:252px;width:56px;"><img src="data:image/png;base64," style="width:56px;"></div>
<div class="comp" id="hdr-line1" style="right:120px;top:258px;font-size:19px;color:#96969f;text-align:right;">YOUR DAILY BITE OF AGENTIC LITERACY</div>
<div class="comp" id="hdr-line2" style="right:120px;top:288px;font-size:19px;color:#ffb040;text-align:right;font-weight:bold;">WORD DEFINITIONS</div>
<div class="comp emailwin" id="l1-window" style="left:190px;top:470px;width:700px;height:560px;"><div class="ew-h">TO: YOU</div><div class="ew-l" style="width:88%"></div><div class="ew-l" style="width:95%"></div><div class="ew-l" style="width:70%"></div><div class="ew-l" style="width:82%"></div></div>
<div class="comp sendbtn" id="l1-send" style="left:628px;top:872px;">SEND</div>
<div class="comp imgwrap" id="l1-cursor" style="left:566px;top:782px;width:92px;"><svg width="92" height="92" viewBox="0 0 92 92"><path d="M14 6 L74 44 L44 50 L58 82 L44 88 L30 56 L12 74 Z" fill="#e9e5da" stroke="#111116" stroke-width="3"/></svg></div>
<div class="comp" id="l1-state" style="left:0;width:1080px;text-align:center;top:1104px;"><div style="font-size:40px;font-weight:bold;color:#e9e5da">the perfect email —</div><div style="font-size:40px;font-weight:bold;color:#e9e5da;margin-top:8px">and nobody presses it</div></div>
<div class="comp imgwrap" id="l2-sphere" style="left:150px;top:470px;width:300px;"><svg width="300" height="300" viewBox="0 0 260 260"><circle cx="130" cy="130" r="110" fill="none" stroke="#5eead4" stroke-width="4"/><ellipse cx="130" cy="130" rx="110" ry="42" fill="none" stroke="#5eead4" stroke-width="2.5" opacity=".75"/><ellipse cx="130" cy="130" rx="42" ry="110" fill="none" stroke="#5eead4" stroke-width="2.5" opacity=".75"/></svg><svg width="300" height="120" viewBox="0 0 300 120" style="margin-top:6px"><path d="M20 20 Q150 -14 280 22" fill="none" stroke="#96969f" stroke-width="3" stroke-dasharray="1 12" stroke-linecap="round"/><path d="M20 84 Q150 118 280 82" fill="none" stroke="#96969f" stroke-width="3" stroke-dasharray="1 12" stroke-linecap="round"/><text x="150" y="18" font-size="27" fill="#96969f" text-anchor="middle" font-weight="bold">&#8220;words&#8221;</text><text x="150" y="112" font-size="27" fill="#96969f" text-anchor="middle" font-weight="bold">&#8220;more words&#8221;</text></svg></div>
<div class="comp" id="l2-modellabel" style="left:150px;width:300px;top:920px;text-align:center;font-size:34px;color:#5eead4;font-weight:bold;">THE MODEL</div>
<div class="comp door5" id="l2-door-file" style="left:520px;top:480px;width:130px;height:340px;"><div class="door-x">&#10005;</div><div class="door-l">FILE</div></div>
<div class="comp door5" id="l2-door-email" style="left:675px;top:480px;width:130px;height:340px;"><div class="door-x">&#10005;</div><div class="door-l">EMAIL</div></div>
<div class="comp door5" id="l2-door-code" style="left:830px;top:480px;width:130px;height:340px;"><div class="door-x">&#10005;</div><div class="door-l">CODE</div></div>
<div class="comp" id="l3-ringlabel" style="left:0;width:1080px;text-align:center;top:384px;font-size:36px;color:#96969f;font-weight:bold;letter-spacing:3px;">THE SYSTEM AROUND IT</div>
<div class="comp imgwrap" id="l3-ring" style="left:220px;top:440px;width:640px;"><svg width="640" height="640" viewBox="0 0 640 640"><circle cx="320" cy="320" r="296" fill="none" stroke="#96969f" stroke-width="4" stroke-dasharray="12 14"/><g transform="translate(28,258) scale(0.48)"><circle cx="130" cy="130" r="110" fill="none" stroke="#5eead4" stroke-width="7"/><ellipse cx="130" cy="130" rx="110" ry="42" fill="none" stroke="#5eead4" stroke-width="5" opacity=".75"/><ellipse cx="130" cy="130" rx="42" ry="110" fill="none" stroke="#5eead4" stroke-width="5" opacity=".75"/></g><path d="M190 320 L420 320" stroke="#ffb040" stroke-width="4" stroke-dasharray="1 13" stroke-linecap="round" fill="none"/></svg></div>
<div class="comp imgwrap" id="l3-plug" style="left:596px;top:694px;width:120px;"><svg width="120" height="120" viewBox="0 0 120 120" style="filter:drop-shadow(0 0 16px rgba(255,176,64,.85))"><path d="M60 118 C 60 98, 42 94, 42 80" fill="none" stroke="#ffb040" stroke-width="7" stroke-linecap="round"/><rect x="30" y="40" width="60" height="42" rx="12" fill="#1c1a17" stroke="#ffb040" stroke-width="5"/><rect x="42" y="14" width="9" height="30" rx="4" fill="#ffb040"/><rect x="69" y="14" width="9" height="30" rx="4" fill="#ffb040"/></svg></div>
<div class="comp" id="l3-head" style="left:0;width:1080px;text-align:center;top:1100px;"><div style="font-size:54px;font-weight:bold;color:#ffb040">A TOOL IS A CONNECTION,</div><div style="font-size:44px;font-weight:bold;color:#e9e5da;margin-top:10px">handed over</div></div>
<div class="comp" id="l4-head" style="left:0;width:1080px;text-align:center;top:392px;"><div style="font-size:38px;font-weight:bold;color:#96969f;letter-spacing:2px">THE SAME VERBS —</div><div style="font-size:38px;font-weight:bold;color:#96969f;letter-spacing:2px;margin-top:6px">GRANTED, AS COMMANDS</div></div>
<div class="comp bar5" id="l4-bar1" style="left:140px;top:540px;width:800px;height:120px;"><span>SEND THE EMAIL</span><span class="chk">&#10003;</span></div>
<div class="comp bar5" id="l4-bar2" style="left:140px;top:700px;width:800px;height:120px;"><span>READ THE FILE</span><span class="chk">&#10003;</span></div>
<div class="comp bar5" id="l4-bar3" style="left:140px;top:860px;width:800px;height:120px;"><span>SEARCH THE WEB</span><span class="chk">&#10003;</span></div>
<div class="comp" id="l5-sphere" style="left:100px;top:540px;width:260px;text-align:center;"><svg width="260" height="260" viewBox="0 0 260 260"><circle cx="130" cy="130" r="110" fill="none" stroke="#5eead4" stroke-width="4"/><ellipse cx="130" cy="130" rx="110" ry="42" fill="none" stroke="#5eead4" stroke-width="2.5" opacity=".75"/><ellipse cx="130" cy="130" rx="42" ry="110" fill="none" stroke="#5eead4" stroke-width="2.5" opacity=".75"/></svg><div style="font-size:30px;font-weight:bold;color:#5eead4;margin-top:14px;line-height:1.3">THE MODEL<br>ASKS</div></div>
<div class="comp reqcard" id="l5-request" style="left:380px;top:580px;width:400px;height:190px;"><div class="rq-t">REQUEST</div><div class="rq-b">tool: send_email</div></div>
<div class="comp" id="l5-world" style="left:795px;top:520px;width:165px;text-align:center;"><svg width="165" height="58" viewBox="0 0 200 70"><path d="M8 35 L158 35" stroke="#ffb040" stroke-width="8"/><path d="M138 10 L172 35 L138 60" fill="none" stroke="#ffb040" stroke-width="8"/></svg><div style="border:3px solid #ffb040;border-radius:10px;height:220px;margin:8px 17px 0"></div><div style="font-size:28px;font-weight:bold;color:#ffb040;margin-top:12px">THE WORLD</div></div>
<div class="comp" id="l5-report" style="left:400px;top:920px;width:440px;"><svg width="440" height="54" viewBox="0 0 440 54"><path d="M432 27 L60 27" stroke="#5eead4" stroke-width="5" stroke-dasharray="10 9"/><path d="M84 8 L54 27 L84 46" fill="none" stroke="#5eead4" stroke-width="5"/></svg><div class="repchip">REPORT &#10003;</div></div>
