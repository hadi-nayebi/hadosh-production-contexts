on": 18.868, "off": 20.523}, {"id": "l5-report", "on": 19.508, "off": 20.523}, {"id": "l6-ringlabel", "on": 22.027, "off": 25.789}, {"id": "l6-ring", "on": 20.503, "off": 25.789}, {"id": "l6-guide", "on": 23.727, "off": 25.789}, {"id": "l6-door", "on": 20.503, "off": 25.789}, {"id": "l6-state", "on": 23.727, "off": 25.789}, {"id": "l7-sphere", "on": 25.769, "off": 30.556}, {"id": "l7-gate", "on": 25.769, "off": 30.556}, {"id": "l7-beyond", "on": 25.769, "off": 30.556}, {"id": "l7-toolq", "on": 27.662, "off": 30.556}, {"id": "l7-state", "on": 27.282, "off": 30.556}, {"id": "l7-bubbles", "on": 29.842, "off": 30.556}, {"id": "l8-window", "on": 30.536, "off": 34.608}, {"id": "l8-plane", "on": 31.46, "off": 34.608}, {"id": "l8-tag", "on": 32.46, "off": 34.608}, {"id": "l9-words", "on": 34.588, "off": 38.31}, {"id": "l9-arrow", "on": 34.84, "off": 38.31}, {"id": "l9-door", "on": 36.02, "off": 38.31}, {"id": "l9-line", "on": 36.02, "off": 38.31}, {"id": "b-next", "on": 38.31, "off": 41.349}, {"id": "b-line", "on": 38.31, "off": 41.349}, {"id": "b-ring", "on": 38.31, "off": 41.349}, {"id": "b-dir", "on": 38.31, "off": 41.349}, {"id": "b-tap", "on": 38.31, "off": 41.349}], "notes": {"intro-logo": "Container intro \u2014 the Spartan Cortex emblem. The channel's standing opening mark, unchanged from the published container.", "intro-name": "Container intro \u2014 the Academy name under its emblem.", "outro-logo": "Container outro \u2014 the emblem again, smaller: the close is a signature, not a second opening.", "outro-name": "Container outro \u2014 the Academy name.", "outro-sub": "Container outro \u2014 the subscribe ask in plain words (N-09).", "outro-tag": "Container outro \u2014 the series tagline.", "hdr-logo": "Header furniture \u2014 mini emblem, inside the safe rect (the v2 container put furniture at the frame edges; the lane standard moves it inside V-14).", "hdr-line1": "Header furniture \u2014 the series promise line, right-aligned to end at x=960 (safe rect).", "hdr-line2": "Header furniture \u2014 the lane name.", "l1-window": "B1 email window \u2014 the finished email: header 'TO: YOU' and four written lines, complete. The result exists; only the act is missing (HS-07 B1; visual plan panel 1).", "l1-send": "B1 SEND button \u2014 amber outline, UNPRESSED for the whole beat: the gap the piece exists to explain. It never fills, never moves (the plan's 'hover \u2014 hold').", "l1-cursor": "B1 cursor \u2014 the pointer hovers over SEND and holds: somebody COULD press it; the model cannot. A typeset arrow glyph (lettering-class), not a drawn figure.", "l1-state": "B1 state line \u2014 the plan's beat caption, carried in the scene as the beat's label (the WD-01 label pattern).", "l2-sphere": "B2 the model \u2014 the lane's wireframe sphere, emitting dotted trails labelled 'words' / 'more words': everything it makes is words (the plan panel 2). A schematic symbol \u2014 the V-13 diagram exception.", "l2-modellabel": "B2 model label \u2014 the sphere is named in the same breath it appears (T-18).", "l2-door-file": "B2 door 1 of 3 \u2014 FILE, shut, marked with an X as 'opening files' is denied: the limit is shown per verb, not asserted in bulk.", "l2-door-email": "B2 door 2 of 3 \u2014 EMAIL, shut: 'send' is denied here so L8's sending is earned (the verb mirror, HS-04).", "l2-door-code": "B2 door 3 of 3 \u2014 CODE, shut: the denial set completes (files / email / code = L2's three verbs, in order).", "l3-ringlabel": "B3 ring label \u2014 L3's 'the system around it' named over its own picture (T-18; the harness in plain clothes, K-01).", "l3-ring": "B3 the ring \u2014 a dashed circle (the system) around the small model sphere, with a dotted connection path running from the sphere toward the connector: the hand-over, drawn mid-flight (plan panel 3).", "l3-plug": "B3 the connector \u2014 the tool itself as one glowing amber plug (body, two prongs, cable) at the end of the dotted path: it lands with the spoken word 'connection' (the piece's GROW word). First build drew an arc-and-dot port that read as a magnet on the rendered frame; replaced with the unambiguous plug glyph (frame-checked fix, 2026-10-25).", "l3-head": "B3 headline \u2014 the definition as the beat's title, under its own diagram (the plan carries it inside the panel).", "l4-head": "B4 header \u2014 the mirror announced: L2's denied verbs return as commands (HS-04 loop b).", "l4-bar1": "B4 command bar 1 \u2014 SEND THE EMAIL lights with its spoken command: L1's withheld act, granted (barTimes pattern from WD-01's count chips).", "l4-bar2": "B4 command bar 2 \u2014 READ THE FILE: L2's 'opening files', granted.", "l4-bar3": "B4 command bar 3 \u2014 SEARCH THE WEB lights last: the granted set completes in the line's own order.", "l5-sphere": "B5 the model, asking \u2014 sphere + its role label for this beat (plan panel 5).", "l5-request": "B5 request card \u2014 the model holds up a card bearing the tool's NAME ('tool: send_email'): L5's 'asks for the tool by name' made literal, and the piece's recorded correction of its own simplification (K-01, script \u00a78.3).", "l5-world": "B5 the world \u2014 the request's arrow reaches a door panel labelled THE WORLD at the spoken word 'acts,': where tool actions land.", "l5-report": "B5 report chip \u2014 a dashed cyan return arrow brings back REPORT \u2713 at 'reports back': the act is verifiable, which is L5's answer to the villain's unverifiable 'done!' (HS-04 loop c).", "l6-ringlabel": "B6 ring label \u2014 the boundary beat's title: know-how is CARRIED (by the system), never wielded (plan panel 6).", "l6-ring": "B6 the booklet \u2014 an open book drawn INSIDE the system's dashed ring: a skill lives in the harness's keeping (canon \u00a72), pictured as carried pages. It has no path out of the ring \u2014 that absence is the ruling (L6, PROVISIONAL).", "l6-guide": "B6 the guide path \u2014 a dotted line from the booklet's ring to the model's sphere: guidance travels; the booklet itself never leaves the ring and touches nothing in the world.", "l6-door": "B6 the world door, untouched \u2014 present the whole beat with a dash, not an X: nothing is denied here; the skill simply never reaches it (the plan's 'touches nothing itself').", "l6-state": "B6 state line \u2014 the boundary in one breath, under its own diagram (the plan's panel caption, carried as the beat's label).", "l7-sphere": "B7 the live connection \u2014 sphere + a solid amber line running right, toward the world: everything works until it reaches the gate.", "l7-gate": "B7 the gate \u2014 a locked panel standing ON the connection line, labelled PERMISSION: canon's 'executed only as permitted' as a physical obstruction (plan panel 7).", "l7-beyond": "B7 beyond the gate \u2014 the same line, grey and broken into stubs: the connection does not continue. What the gate stops is shown, not narrated.", "l7-toolq": "B7 the withheld tool \u2014 a dashed, questioning chip appears at 'No tool handed over': the tool that isn't there, drawn as an absence with a question mark.", "l7-state": "B7 state line \u2014 the gate's consequence as the beat's label (the plan's panel caption).", "l7-bubbles": "B7 back to words \u2014 three small empty word-bubbles drift from the sphere at the line's last word: with no tool, the model is back to making words (L2's state, returned).", "l8-window": "B8 the same email window as B1 \u2014 same component geometry on purpose (N-08 bookend): the viewer must recognise L1's frame so the one change reads instantly.", "l8-plane": "B8 the send, performed \u2014 a paper plane leaves the window's corner on a dotted trail at the spoken word 'sends,': the act L1 withheld, happening (typeset glyph class, as the cursor).", "l8-tag": "B8 the tag \u2014 'A TOOL ACTED' in a cyan pill under the window at 'a tool acted': authorship reassigned in the picture, in the line's own words.", "l9-words": "B9 words \u2014 the model's whole output in one chalk circle, lower-case and plain: what a tool starts from (plan panel 9).", "l9-arrow": "B9 the arrow \u2014 labelled TOOL, arriving with the verb 'turns': the mechanism of the whole piece in one glyph.", "l9-door": "B9 the open door \u2014 a door standing OPEN in the world at the word 'actions': B2's shut doors, answered. The piece's last image is an opening, not a wall.", "l9-line": "B9 close line \u2014 the definition's destination named under its own diagram (the plan's panel caption).", "b-next": "Bridge \u2014 the NEXT signpost: the harness pointer lives here, after the close, never inside the teaching arc (T-16; script \u00a77 verbatim).", "b-line": "Bridge \u2014 the pointer question, packaging not teaching (script \u00a77).", "b-ring": "Bridge \u2014 the system ring around the model sphere: the harness as this piece has pictured 'the system around it' all along \u2014 the route target drawn in the piece's own grammar.", "b-dir": "Bridge \u2014 the routed destination, named in full so the tap is a choice, not a tease (script \u00a77).", "b-tap": "Bridge \u2014 the tap instruction (the lane's standing bridge grammar)."}};
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');
const TOTAL = PLAN.total;

/* words (generated components, same timeline) */
const wordEls = [];
for (const ph of PLAN.phrases) {
  ph._els = ph.words.map(w => {
    const s = document.createElement('span');
    s.className = 'word'; s.textContent = w.w;
    s.style.fontSize = PLAN.wordSize + 'px';
    s.style.color = w.key ? '#ffb040' : '#e9e5da';
    s.style.left = w.cx + 'px'; s.style.top = w.cy + 'px';
    s.style.textShadow = '3px 4px 0 rgba(0,0,0,.45)';
    stage.appendChild(s); wordEls.push(s); return s;
  });
}
const compEls = {};
document.querySelectorAll('.comp').forEach(e => compEls[e.id] = e);

function easeOut(u){ return 1 - Math.pow(1-u, 3); }
function renderAt(t) {
  for (const id in compEls) compEls[id].style.opacity = 0;
  wordEls.forEach(e => e.style.opacity = 0);
  for (const e of PLAN.elements) {
    if (t >= e.on && t < e.off) {
      const el = compEls[e.id];
      el.style.opacity = Math.min(1, (t - e.on)/0.25 + 0.001);
      if (!RENDER) el.style.pointerEvents = 'auto';
    }
  }
  for (const ph of PLAN.phrases) {
    if (t < ph.start || t >= ph.end) continue;
    ph.words.forEach((w, wi) => {
      const elm = ph._els[wi];
      if (t < w.start) return;
      const u = Math.min((t - w.start)/0.16, 1);
      let s = 0.55 + 0.45*easeOut(u);
      let op = Math.min(1, (t - w.start)/0.08);
      let tx = 0, ty = 0, ry = 0;
      const u2 = Math.min(Math.max((t - w.start)/Math.max(w.dur, 0.05), 0), 1);
      if (w.key) { const v = Math.min((t - w.start)/0.22, 1); s *= 1 + 0.10*Math.sin(Math.PI*v); }
      switch (w.ch) {
        case 'grow': case 'growhold':
          s *= 1 + 0.30*easeOut(Math.min((t - w.start)/0.25, 1)); break;
        case 'hold': s = 1; break;
        case 'sink': ty += 26*u2; s *= 1 - 0.15*u2; op *= 1 - 0.45*u2; break;
        case 'fade': op *= 1 - 0.55*u2; break;
        case 'settle': s *= 1.12 - 0.20*u2; break;
        case 'flip': { const v = Math.min((t - w.start)/0.22, 1); ry = (1 - easeOut(v))*90; break; }
        case 'tether': tx += 18*Math.sin(Math.PI*Math.min(u2*1.15, 1)); break;
        case 'scatter': ty -= 14*u2; tx += (wi % 2 ? 10 : -10)*u2; op *= 1 - 0.30*u2; break;
      }
      elm.style.opacity = op;
      elm.style.transform = `translate(-50%,-50%) translate(${tx.toFixed(1)}px,${ty.toFixed(1)}px) scale(${s.toFixed(3)}) rotateY(${ry.toFixed(1)}deg)`;
    });
    break;
  }
}
window.renderAt = renderAt;

/* ---------- interactivity: hover notes ---------- */
const NOTES = PLAN.notes;
const tip = document.getElementById('tooltip');
function bindNote(elm, text) {
  if (RENDER || !elm) return;
  elm.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display='block'; });
  elm.addEventListener('mousemove', e => { tip.style.left = (e.clientX+18)+'px'; tip.style.top = (e.clientY+16)+'px'; });
  elm.addEventListener('mouseleave', () => tip.style.display='none');
  elm.addEventListener('click', e => { tip.textContent = text; tip.style.display='block';
    tip.style.left=(e.clientX+18)+'px'; tip.style.top=(e.clientY+16)+'px'; });
}
for (const id in NOTES) bindNote(compEls[id], NOTES[id]);

/* ---------- player chrome ---------- */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100*audio.currentTime/TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* ---------- production-context panel ---------- */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided · word decisions ${DEC.coverage.word_decisions.decided} of ${DEC.coverage.word_decisions.total} words.</div>`;
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}<br>` +
    `<span class="fld">Why:</span> ${r.why}<br>` +
    `<span class="fld">What would change it:</span> ${r.change}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
</script>
</body>
</html>
