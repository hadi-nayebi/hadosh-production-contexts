7, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "your", "start": 37.258, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "digital", "start": 37.434, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "CORTEX:", "start": 37.742, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}]}, {"line": 1, "start": 38.44, "end": 38.92, "scene": "", "words": [{"w": "AUGMENTED.", "start": 38.44, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}]}, {"line": 1, "start": 39.81, "end": 40.58, "scene": "", "words": [{"w": "Same", "start": 39.81, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "six", "start": 40.047, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "parts.", "start": 40.225, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 40.97, "end": 41.53, "scene": "", "words": [{"w": "One", "start": 40.97, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "difference:", "start": 41.09, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 41.93, "end": 42.61, "scene": "", "words": [{"w": "who", "start": 41.93, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "owns", "start": 42.057, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "the", "start": 42.227, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "layer.", "start": 42.355, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}]}, {"line": 1, "start": 43.58, "end": 44.42, "scene": "", "words": [{"w": "So", "start": 43.58, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "the", "start": 43.709, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "question", "start": 43.903, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 44.42, "end": 45.27, "scene": "", "words": [{"w": "was", "start": 44.42, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "never", "start": 44.633, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "only", "start": 44.987, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 45.27, "end": 46.11, "scene": "", "words": [{"w": "when", "start": 45.27, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "AGI", "start": 45.494, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "arrives.", "start": 45.662, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 46.87, "end": 47.6, "scene": "", "words": [{"w": "It's", "start": 46.87, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "where", "start": 47.024, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "we", "start": 47.216, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "started:", "start": 47.293, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 48.04, "end": 48.76, "scene": "", "words": [{"w": "what", "start": 48.04, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "kind", "start": 48.262, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "of", "start": 48.483, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "AGI", "start": 48.594, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 48.76, "end": 49.66, "scene": "", "words": [{"w": "do", "start": 48.76, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "we", "start": 48.872, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "want", "start": 48.985, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "to", "start": 49.21, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}, {"w": "build?", "start": 49.322, "cx": 540, "cy": 1600, "size": 64, "key": false, "col": "#ffffff"}]}, {"line": 1, "start": 50.54, "end": 51.37, "scene": "", "words": [{"w": "Tell", "start": 50.54, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "me", "start": 50.724, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "yours,", "start": 50.817, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}, {"w": "below.", "start": 51.093, "cx": 540, "cy": 1600, "size": 64, "key": true, "col": "#ffffff"}]}]}, "notes": {"plates": {"p0": "Container intro card (shared/intro_l2.mp4) \u2014 the Spartan Cortex emblem draw-in; the scene samples the card's own frames (motion approximated by crossfaded frames).", "p1": "Container intro card (shared/intro_l2.mp4) \u2014 the Spartan Cortex emblem draw-in; the scene samples the card's own frames (motion approximated by crossfaded frames).", "p2": "Container intro card (shared/intro_l2.mp4) \u2014 the Spartan Cortex emblem draw-in; the scene samples the card's own frames (motion approximated by crossfaded frames).", "p3": "Container intro card (shared/intro_l2.mp4) \u2014 the Spartan Cortex emblem draw-in; the scene samples the card's own frames (motion approximated by crossfaded frames).", "p4": "Container intro card (shared/intro_l2.mp4) \u2014 the Spartan Cortex emblem draw-in; the scene samples the card's own frames (motion approximated by crossfaded frames).", "p5": "Container intro card (shared/intro_l2.mp4) \u2014 the Spartan Cortex emblem draw-in; the scene samples the card's own frames (motion approximated by crossfaded frames).", "p6": "Visual beat \u2014 sc11_question.png from the shared Workshop build; shown 1.8\u20134.6s with the build's zoompan move.", "p7": "Visual beat \u2014 sc01_robotapart.png from the shared Workshop build; shown 4.6\u20137.0s with the build's zoompan move.", "p8": "Visual beat \u2014 sc02_monolith.png from the shared Workshop build; shown 7.0\u20139.5s with the build's zoompan move.", "p9": "Visual beat \u2014 state0.png from the shared Workshop build; shown 12.7\u201315.8s with the build's zoompan move.", "p10": "Visual beat \u2014 state1.png from the shared Workshop build; shown 15.8\u201319.4s with the build's zoompan move.", "p11": "Visual beat \u2014 state2.png from the shared Workshop build; shown 19.4\u201321.9s with the build's zoompan move.", "p12": "Visual beat \u2014 state3.png from the shared Workshop build; shown 21.9\u201324.1s with the build's zoompan move.", "p13": "Visual beat \u2014 state4.png from the shared Workshop build; shown 24.1\u201327.4s with the build's zoompan move.", "p14": "Visual beat \u2014 state5.png from the shared Workshop build; shown 27.4\u201329.4s with the build's zoompan move.", "p15": "Visual beat \u2014 state6.png from the shared Workshop build; shown 29.4\u201332.2s with the build's zoompan move.", "p16": "Visual beat \u2014 sc07_poster_left.png from the shared Workshop build; shown 32.2\u201336.1s with the build's zoompan move.", "p17": "Visual beat \u2014 sc09_helmet.png from the shared Workshop build; shown 36.1\u201339.6s with the build's zoompan move.", "p18": "Visual beat \u2014 sc05_cortex.png from the shared Workshop build; shown 39.6\u201341.5s with the build's zoompan move.", "p19": "Visual beat \u2014 sc04_ring.png from the shared Workshop build; shown 43.4\u201346.7s with the build's zoompan move.", "p20": "Visual beat \u2014 sc10_finale.png from the shared Workshop build; shown 50.4\u201353.2s with the build's zoompan move.", "p21": "Container outro card (files/container-assets/outro.mp4) \u2014 the scene samples the card's own frames (motion approximated by crossfaded frames).", "p22": "Container outro card (files/container-assets/outro.mp4) \u2014 the scene samples the card's own frames (motion approximated by crossfaded frames).", "p23": "Container outro card (files/container-assets/outro.mp4) \u2014 the scene samples the card's own frames (motion approximated by crossfaded frames).", "p24": "Container outro card (files/container-assets/outro.mp4) \u2014 the scene samples the card's own frames (motion approximated by crossfaded frames).", "p25": "Container outro card (files/container-assets/outro.mp4) \u2014 the scene samples the card's own frames (motion approximated by crossfaded frames)."}}};
const PLAN = D.plan, TOTAL = D.total, CEND = D.contentEnd;
const stage = document.getElementById('stage');
const RENDER = new URLSearchParams(location.search).has('render');
if (RENDER) document.body.classList.add('render');

/* plates */
const plateEls = {};
for (const p of D.plates) {
  const d = document.createElement('div');
  d.className = 'plate'; d.id = 'plate-' + p.id;
  d.style.backgroundImage = `url(${p.uri})`;
  d.dataset.bw = p.bw; d.dataset.bh = p.bh;
  stage.appendChild(d); plateEls[p.id] = d;
}
/* overlays (cards) */
const ovlEls = D.overlays.map(o => {
  const d = document.createElement('div'); d.className = 'ovl';
  if (o.bg) d.style.background = o.bg;
  if (o.plate) {
    const b = document.createElement('div'); b.className = 'bgimg';
    const pl = D.plates.find(x => x.id === o.plate);
    b.style.backgroundImage = `url(${pl.uri})`;
    b.style.backgroundSize = pl.bw + 'px ' + pl.bh + 'px';
    b.style.backgroundPosition = '50% 50%';
    d.appendChild(b);
  }
  for (const t of o.texts || []) { const e = mkText(t); e.style.opacity = 1; d.appendChild(e); }
  stage.appendChild(d); return d;
});
function mkText(t) {
  const s = document.createElement('div');
  s.className = 'tx'; s.innerHTML = t.html;
  s.style.fontSize = t.size + 'px'; s.style.color = t.color;
  s.style.fontWeight = t.bold ? 'bold' : 'normal';
  if (t.font) s.style.fontFamily = t.font;
  if (t.spacing) s.style.letterSpacing = t.spacing + 'px';
  if (t.shadow) s.style.textShadow = t.shadow;
  if (t.bottom != null) { s.style.bottom = t.bottom + 'px'; }
  else if (t.y != null) { s.style.top = t.y + 'px'; }
  if (t.anchor === 'c') { s.style.left = t.x + 'px';
    s.style.transform = (t.bottom != null) ? 'translateX(-50%)' : 'translate(-50%,-50%)'; }
  else if (t.anchor === 'r') { s.style.right = (1080 - t.x) + 'px';
    s.style.transform = (t.bottom != null) ? 'translateX(0)' : 'translateY(-50%)'; }
  else { s.style.left = t.x + 'px';
    if (t.bottom == null) s.style.transform = 'translateY(-50%)'; }
  s._t = t;
  return s;
}
const textEls = D.texts.map(t => { const e = mkText(t); stage.appendChild(e); return e; });
const imgEls = (D.imgs || []).map(o => {
  const i = document.createElement('img'); i.className = 'wm'; i.src = o.uri;
  i.style.left = o.x + 'px'; i.style.top = o.y + 'px'; i.style.width = o.w + 'px';
  i._t = o; stage.appendChild(i); return i;
});
/* plate caption (chunk captions on a dark plate — the published
   treatment of the plate-era pieces, reproduced faithfully) */
let capEl = null, capIdx = -1;
if (D.platecap) {
  capEl = document.createElement('div'); capEl.id = 'platecap';
  const pc = D.platecap;
  capEl.style.left = pc.x + 'px'; capEl.style.width = pc.w + 'px';
  capEl.style.bottom = pc.bottom + 'px'; capEl.style.background = pc.bg;
  stage.appendChild(capEl);
}
function fade(t, w) {
  if (t < w.start || t > w.end) return 0;
  let o = 1;
  if (w.fadeIn) o = Math.min(o, (t - w.start) / w.fadeIn);
  if (w.fadeOut) o = Math.min(o, (w.end - t) / w.fadeOut);
  return Math.max(0, Math.min(1, o));
}
function renderAt(t) {
  /* plates: segments drive zoom/pan; crossfade where a seg asks */
  for (const k in plateEls) plateEls[k].style.opacity = 0;
  let si = -1;
  for (let i = 0; i < D.segs.length; i++)
    if (t >= D.segs[i].start && t < D.segs[i].end) si = i;
  if (si < 0) si = t < D.segs[0].start ? 0 : D.segs.length - 1;
  const seg = D.segs[si];
  const p = Math.min(Math.max((t - seg.start) / Math.max(seg.end - seg.start, 0.01), 0), 1);
  const show = (sg, o) => {
    const el = plateEls[sg.plate]; if (!el) return;
    const z = (sg.z0 + (sg.z1 - sg.z0) * Math.min(Math.max((t - sg.start) / Math.max(sg.end - sg.start, 0.01), 0), 1));
    const bw = parseFloat(el.dataset.bw), bh = parseFloat(el.dataset.bh);
    el.style.backgroundSize = (bw * z) + 'px ' + (bh * z) + 'px';
    const fx = sg.pan ? (sg.pan[0] + (sg.pan[1] - sg.pan[0]) * p) : 0.5;
    el.style.backgroundPosition = (fx * 100) + '% 50%';
    el.style.opacity = o;
    if (!RENDER && o > 0) el.style.pointerEvents = 'auto';
  };
  if (seg.fade && si > 0 && t < seg.start + seg.fade) {
    const u = (t - seg.start) / seg.fade;
    show(D.segs[si - 1], 1 - u); show(seg, u);
  } else show(seg, 1);
  for (const [i, o] of ovlEls.entries()) {
    const w = D.overlays[i];
    o.style.opacity = fade(t, w);
    if (!RENDER && o.style.opacity > 0) o.style.pointerEvents = 'auto';
  }
  for (const e of textEls) e.style.opacity = fade(t, e._t);
  for (const e of imgEls) e.style.opacity = fade(t, e._t);
  if (capEl) {
    const pc = D.platecap;
    let idx = -1;
    for (let i = 0; i < pc.chunks.length; i++)
      if (t >= pc.chunks[i].start && t < CEND) idx = i;
    if (t < pc.chunks[0].start) idx = -1;
    if (idx !== capIdx) {
      capIdx = idx;
      if (idx < 0) { capEl.style.opacity = 0; capEl.innerHTML = ''; }
      else {
        const ch = pc.chunks[idx];
        capEl.style.height = (ch.rows.length * pc.rowH + pc.padV) + 'px';
        capEl.style.paddingTop = pc.padTop + 'px';
        capEl.innerHTML = ch.rows.map(r =>
          `<div class="row" style="height:${pc.rowH}px">` +
          r.map(w => `<span style="font-size:${pc.size}px;color:${w.col};font-family:${pc.font}">${w.t}</span>`).join('') +
          `</div>`).join('');
        capEl.style.opacity = 1;
      }
    }
  }
}
window.renderAt = renderAt;

/* hover notes */
const tip = document.getElementById('tooltip');
function bindNote(el, text) {
  if (RENDER || !el || !text) return;
  el.addEventListener('mouseenter', e => { tip.textContent = text; tip.style.display = 'block'; });
  el.addEventListener('mousemove', e => { tip.style.left = (e.clientX + 18) + 'px'; tip.style.top = (e.clientY + 16) + 'px'; });
  el.addEventListener('mouseleave', () => tip.style.display = 'none');
  el.addEventListener('click', e => { tip.textContent = text; tip.style.display = 'block';
    tip.style.left = (e.clientX + 18) + 'px'; tip.style.top = (e.clientY + 16) + 'px'; });
}
for (const p of D.plates) bindNote(plateEls[p.id], (D.notes.plates || {})[p.id]);

/* chrome */
const audio = document.getElementById('mix');
const playbtn = document.getElementById('playbtn');
const fill = document.getElementById('fill');
const clock = document.getElementById('clock');
let playing = false;
function loop() {
  if (playing) {
    renderAt(audio.currentTime);
    fill.style.width = (100 * audio.currentTime / TOTAL) + '%';
    clock.textContent = audio.currentTime.toFixed(1) + ' / ' + TOTAL.toFixed(1);
    if (audio.currentTime >= TOTAL - 0.05) { playing = false; playbtn.textContent = '▶ Play'; }
  }
  requestAnimationFrame(loop);
}
playbtn.addEventListener('click', () => {
  if (playing) { audio.pause(); playing = false; playbtn.textContent = '▶ Play'; }
  else { audio.play(); playing = true; playbtn.textContent = '⏸ Pause'; }
});
document.getElementById('bar').addEventListener('click', e => {
  const r = e.currentTarget.getBoundingClientRect();
  audio.currentTime = TOTAL * (e.clientX - r.left) / r.width;
  renderAt(audio.currentTime);
});
renderAt(0); requestAnimationFrame(loop);
const h = parseFloat((location.hash.match(/#t=([\d.]+)/) || [])[1]);
if (!isNaN(h)) { audio.currentTime = h; renderAt(h); }

/* production-context panel (from the #decisions block) */
const DEC = JSON.parse(document.getElementById('decisions').textContent);
const panel = document.getElementById('ctxpanel');
let html = '<h2>Production context — Decision Records (QC Q-0)</h2>';
html += `<div class="cov">Decision coverage: ${DEC.coverage.elements_recorded} of ${DEC.coverage.elements_total} elements recorded · ${DEC.coverage.undecided.length} undecided. ` +
        'Every element below was chosen from context, not produced at random; the record is written with the piece.</div>';
for (const r of DEC.records) {
  html += `<div class="rec"><b>${r.id} — ${r.element}</b><br>` +
    `<span class="fld">Choice:</span> ${r.choice}<br>` +
    `<span class="fld">Alternatives:</span> ${r.alternatives}<br>` +
    `<span class="fld">Context:</span> ${r.context}</div>`;
}
panel.innerHTML = html;
document.getElementById('ctxbtn').addEventListener('click', () => {
  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});

</script>
</body>
</html>
