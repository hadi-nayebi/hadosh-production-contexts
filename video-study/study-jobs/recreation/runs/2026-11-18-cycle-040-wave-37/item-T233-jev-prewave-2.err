    84	console.log("PAIRED-TIMING shifted P4 instant expr pressStart+pressDurMs default="+(pressStart+CFG.pressDurMs)+" swapped="+(pressStart+TM.pressDurMs)+" swapAt default="+sch.swapAt+" swapped="+tmSch.swapAt);
    85	chk("SWAP timing paired", fixedDefault.pressRaw===1 && Math.abs(fixedSwap.pressRaw - 0.625)<1e-9 && (pressStart+TM.pressDurMs)===3600 && tmSch.swapAt===3725, "");
    86	// SWAP timing: FULL P4 predicate executed at the shifted instant under the swapped CONFIG
    87	const tmP4 = T.stateAt(TM, pressStart + TM.pressDurMs);
    88	chk("SWAP timing P4-at-shifted-instant", tmP4.pressRaw===1 && tmP4.occluderOpacity===1 && tmP4.cubeVisible===0 && tmP4.inputOpacity===1 && tmP4.coverCoversSubject===true, "at 3600 under pressDurMs=1600: pressRaw="+tmP4.pressRaw+" occ="+tmP4.occluderOpacity+" cubeVisible="+tmP4.cubeVisible+" inputOpacity="+tmP4.inputOpacity+" covers="+tmP4.coverCoversSubject);
    89	// SWAP palette
    90	const PL = JSON.parse(JSON.stringify(CFG)); PL.palette.cube = "#2e7ec8";
