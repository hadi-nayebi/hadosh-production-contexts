const s4000 = T.stateAt(C, 4000);
chk("C4000@4000", s4000.strokeIdx === 2 && s4000.step === 7 &&
  s4000.objects.filter(o => o.cs === 2).every(o => approx(o.integrity, 0.12)) && s4000.readableCount === 9,
