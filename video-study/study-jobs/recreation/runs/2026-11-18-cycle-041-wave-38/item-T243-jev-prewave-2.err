function ease(name, x){ x = Math.min(1, Math.max(0, x)); return name === "easeInOut" ? x*x*(3-2*x) : x; }
function clamp01(x){ return Math.min(1, Math.max(0, x)); }
function schedule(cfg){
  const gridStart = 0;
  const strikes1Start = gridStart + cfg.gridDurMs;
  const dropStart = strikes1Start + cfg.strikes1DurMs;
  const labelsStart = dropStart + cfg.dropDurMs;
  const hold1End = labelsStart + cfg.labelsDurMs;
  const tasksStart = hold1End + cfg.hold1DurMs;
  const sweep3Start = tasksStart + cfg.tasksDurMs;
  const finalStart = sweep3Start + cfg.sweep3DurMs;
  const completeAtMs = finalStart + cfg.finalDurMs;
  const durationMs = completeAtMs + cfg.holdMs;
  return { gridStart, strikes1Start, dropStart, labelsStart, hold1End, tasksStart, sweep3Start, finalStart, completeAtMs, durationMs };
}
function validateConfig(cfg){
