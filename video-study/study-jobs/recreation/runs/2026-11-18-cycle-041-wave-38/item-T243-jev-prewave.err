if (typeof document !== "undefined" && document.getElementById("stage")){
  const stage = document.getElementById("stage");
  const btnPlay = document.getElementById("btnPlay");
  const btnRestart = document.getElementById("btnRestart");
  let startStamp = performance.now(), pausedAt = null;
  function frame(now){
    const elapsed = pausedAt !== null ? pausedAt : (now - startStamp) % (schedule(CONFIG).durationMs + 800);
    const tt = Math.min(elapsed, schedule(CONFIG).durationMs);
    stage.innerHTML = renderSVG(CONFIG, tt);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  btnPlay.addEventListener("click", () => {
    if (pausedAt === null){ pausedAt = (performance.now() - startStamp) % (schedule(CONFIG).durationMs + 800); btnPlay.textContent = "Play"; }
    else { startStamp = performance.now() - pausedAt; pausedAt = null; btnPlay.textContent = "Pause"; }
  });
  btnRestart.addEventListener("click", () => { startStamp = performance.now(); pausedAt = null; btnPlay.textContent = "Pause"; });
}
