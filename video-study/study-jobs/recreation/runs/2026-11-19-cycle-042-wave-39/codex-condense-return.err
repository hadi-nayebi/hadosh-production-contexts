nl -ba ../../guards/jev-prewave.md | sed -n '12,17p'
rg -n '§2b|RETURN-TO-OBSERVE|REVISE' item-T244-observe-plan.md" in /home/hatch/workspace/goals/diy-building-and-real-learning/hidden_files/study-jobs/recreation/runs/2026-11-19-cycle-042-wave-39
