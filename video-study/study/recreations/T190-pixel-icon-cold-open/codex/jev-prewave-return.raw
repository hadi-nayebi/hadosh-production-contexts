function sc(v){ return Math.round(v * CONFIG.beatScale); }
function bez(p){
  const b = CONFIG.turnBezier, x1=b[0], y1=b[1], x2=b[2], y2=b[3];
  let lo=0, hi=1, t=p;
  for(let i=0;i<24;i++){ t=(lo+hi)/2; const u=1-t;
    const x=3*u*u*t*x1 + 3*u*t*t*x2 + t*t*t;
    if(x<p) lo=t; else hi=t; }
  const u=1-t; return 3*u*u*t*y1 + 3*u*t*t*y2 + t*t*t;
}
function captionEntryAt(t){
  for(const c of CONFIG.captions){ if(t >= sc(c.fromMs) && t < sc(c.toMs)) return c; }
  return null;
}
function captionAt(t){ const e = captionEntryAt(t); return e ? e.text : ""; }
function captionLayout(text){
  let fontPx = CONFIG.captionFontPx;
  const avail = CONFIG.stageWPx - 2 * CONFIG.captionPadPx;
  if(!text) return { lines: [], fontPx, lineWidthPx: 0 };
  let charW = fontPx * CONFIG.captionCharWidthFactor;
  if(text.length * charW <= avail) return { lines: [text], fontPx, lineWidthPx: text.length * charW };
  const words = text.split(" ");
  let best = null;
  for(let i=1;i<words.length;i++){
    const a = words.slice(0,i).join(" "), b = words.slice(i).join(" ");
    const w = Math.max(a.length, b.length) * charW;
    if(!best || w < best.w) best = { lines:[a,b], w };
  }
  if(best.w > avail){
    fontPx = Math.floor(fontPx * avail / best.w * 10) / 10;
    charW = fontPx * CONFIG.captionCharWidthFactor;
    best = { lines: best.lines, w: Math.max(best.lines[0].length, best.lines[1].length) * charW };
  }
  return { lines: best.lines, fontPx, lineWidthPx: best.w };
}
function sceneScalePeakMs(s){
  return Math.round((s.turnOutStartMs + (s.scalePeakAt != null ? s.scalePeakAt : CONFIG.scalePeakAt) * (s.turnOutEndMs - s.turnOutStartMs)) * CONFIG.beatScale);
}
function mapDims(map){ return { cols: map[0].length, rows: map.length, wPx: map[0].length * CONFIG.pixelUnitPx, hPx: map.length * CONFIG.pixelUnitPx }; }
function boundsFor(map, angleDeg, scale){
  const d = mapDims(map);
  const a = angleDeg * Math.PI / 180, cos = Math.cos(a), sin = Math.sin(a);
  const cx = CONFIG.stageWPx / 2, cy = CONFIG.iconCenterYPx, P = CONFIG.perspectivePx;
  let left = Infinity, right = -Infinity, top = Infinity, bottom = -Infinity;
  for(const sx of [-1, 1]){ for(const sy of [-1, 1]){
    const x = sx * d.wPx * scale / 2, y = sy * d.hPx * scale / 2;
    const proj = P / (P - x * sin);
    const px = cx + x * cos * proj, py = cy + y * proj;
    if(px < left) left = px; if(px > right) right = px;
    if(py < top) top = py; if(py > bottom) bottom = py;
  } }
  return { left, right, top, bottom, wPx: right - left, hPx: bottom - top };
}
function stateAt(t){
  const cap = captionAt(t);
  if(t >= sc(CONFIG.endMs)) return { phase:"CUT", sceneId:null, map:null, mapName:null, angleDeg:0, scale:1, caption:cap, bounds:null };
  if(t < sc(CONFIG.captionOnlyMs)) return { phase:"CAPTION-ONLY", sceneId:null, map:null, mapName:null, angleDeg:0, scale:1, caption:cap, bounds:null };
  for(const s of CONFIG.scenes){
    const tIn0 = sc(s.turnStartMs), tIn1 = sc(s.readableMs);
    const hasProfile = !!s.mapProfile;
    const prof0 = hasProfile ? sc(s.profileTurnStartMs) : Infinity;
    const prof1 = hasProfile ? sc(s.profileReadableMs) : Infinity;
    const out0 = sc(s.turnOutStartMs), out1 = sc(s.turnOutEndMs);
    if(t >= tIn0 && t < tIn1){
      const p = (t - tIn0) / Math.max(1, tIn1 - tIn0);
      const angle = -CONFIG.turnDeg * CONFIG.turnDir * (1 - bez(p));
      const scale = 1 + ((s.scalePeak != null ? s.scalePeak : CONFIG.scalePeak) - 1) * Math.sin(Math.PI * p);
      return { phase:"TURN", sceneId:s.id, map:s.mapFront, mapName:"mapFront", angleDeg:angle, scale, caption:cap, bounds:boundsFor(s.mapFront, angle, scale) };
    }
    if(hasProfile && t >= prof0 && t < prof1){
      const p = (t - prof0) / Math.max(1, prof1 - prof0);
      const first = p < 0.5;
      const angle = first ? CONFIG.turnDeg * CONFIG.turnDir * bez(p * 2) : -CONFIG.turnDeg * CONFIG.turnDir * (1 - bez((p - 0.5) * 2));
      const scale = 1 + ((s.scalePeak != null ? s.scalePeak : CONFIG.scalePeak) - 1) * Math.sin(Math.PI * p);
      const map = first ? s.mapFront : s.mapProfile;
      return { phase:"TURN", sceneId:s.id, map, mapName: first ? "mapFront" : "mapProfile", angleDeg:angle, scale, caption:cap, bounds:boundsFor(map, angle, scale) };
    }
    if(hasProfile && t >= prof1 && t < sc(CONFIG.endMs)){
      return { phase:"HOLD", sceneId:s.id, map:s.mapProfile, mapName:"mapProfile", angleDeg:0, scale:1, caption:cap, bounds:boundsFor(s.mapProfile, 0, 1) };
    }
    if(!hasProfile && t >= tIn1 && t < out0){
      return { phase:"HOLD", sceneId:s.id, map:s.mapFront, mapName:"mapFront", angleDeg:0, scale:1, caption:cap, bounds:boundsFor(s.mapFront, 0, 1) };
    }
    if(!hasProfile && t >= out0 && t < out1){
      const p = (t - out0) / Math.max(1, out1 - out0);
      const angle = CONFIG.turnDeg * CONFIG.turnDir * bez(p);
      const pa = (s.scalePeakAt != null ? s.scalePeakAt : CONFIG.scalePeakAt);
      const q = p <= pa ? p / (2 * pa) : 0.5 + (p - pa) / (2 * (1 - pa));
      const sc2 = 1 + ((s.scalePeak != null ? s.scalePeak : CONFIG.scalePeak) - 1) * Math.sin(Math.PI * q);
      return { phase:"TURN", sceneId:s.id, map:s.mapFront, mapName:"mapFront", angleDeg:angle, scale:sc2, caption:cap, bounds:boundsFor(s.mapFront, angle, sc2) };
    }
    if(hasProfile && t >= tIn1 && t < prof0){
      return { phase:"HOLD", sceneId:s.id, map:s.mapFront, mapName:"mapFront", angleDeg:0, scale:1, caption:cap, bounds:boundsFor(s.mapFront, 0, 1) };
    }
  }
  return { phase:"CUT", sceneId:null, map:null, mapName:null, angleDeg:0, scale:1, caption:cap, bounds:null };
}
</script>
<script id="render">
"use strict";
(function(){
  const stage = document.getElementById("stage");
  const icon = document.getElementById("icon");
  const capEl = document.getElementById("caption");
  stage.style.width = CONFIG.stageWPx + "px";
  stage.style.height = CONFIG.stageHPx + "px";
  stage.style.background = CONFIG.bg;
  capEl.style.height = CONFIG.captionSafeBandPx + "px";
  capEl.style.bottom = "0px";
  capEl.style.display = "flex";
  capEl.style.alignItems = "flex-end";
  capEl.style.justifyContent = "center";
  capEl.style.paddingBottom = CONFIG.captionBottomPx + "px";
  capEl.style.boxSizing = "border-box";
  capEl.style.fontSize = CONFIG.captionFontPx + "px";
  capEl.style.lineHeight = String(CONFIG.captionLineHeightFactor);
  capEl.style.color = CONFIG.ink;
  capEl.style.fontFamily = CONFIG.fontStack;
  let curMapKey = null;
  function drawMap(map){
    const key = map ? map.join("\n") : "";
    if(key === curMapKey) return;
    curMapKey = key;
    icon.innerHTML = "";
    if(!map) return;
    const d = mapDims(map);
    icon.style.gridTemplateColumns = "repeat(" + d.cols + ", " + CONFIG.pixelUnitPx + "px)";
    icon.style.width = d.wPx + "px";
    icon.style.marginLeft = (-d.wPx / 2) + "px";
    icon.style.top = (CONFIG.iconCenterYPx - d.hPx / 2) + "px";
    for(const row of map){ for(const ch of row){
      const cell = document.createElement("span");
      cell.className = "cell";
      cell.style.width = CONFIG.pixelUnitPx + "px";
      cell.style.height = CONFIG.pixelUnitPx + "px";
      cell.style.background = ch === "#" ? CONFIG.ink : "transparent";
      icon.appendChild(cell);
    } }
  }
  function render(t){
    const st = stateAt(t);
    drawMap(st.map);
    icon.style.transform = "perspective(" + CONFIG.perspectivePx + "px) rotateY(" + st.angleDeg + "deg) scale(" + st.scale + ")";
    icon.style.transformOrigin = CONFIG.pivot;
    const lay = captionLayout(st.caption);
    capEl.textContent = lay.lines.join("\n");
    capEl.style.color = CONFIG.ink;
  }
  let startStamp = null, pausedAt = 0, playing = true, externalT = null;
  function frame(now){
    if(externalT != null){ render(externalT); requestAnimationFrame(frame); return; }
    if(playing){
      if(startStamp == null) startStamp = now - pausedAt;
      const t = (now - startStamp) % Math.max(1, sc(CONFIG.endMs));
      render(t);
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  document.getElementById("playBtn").addEventListener("click", function(){
    playing = !playing;
    if(!playing){ pausedAt = performance.now() - startStamp; this.textContent = "Play"; }
    else { startStamp = null; this.textContent = "Pause"; }
  });
  document.getElementById("restartBtn").addEventListener("click", function(){ startStamp = null; pausedAt = 0; externalT = null; });
  window.__T190 = { CONFIG, stateAt, captionAt, captionLayout, sceneScalePeakMs, setExternalTime: function(ms){ externalT = ms; }, clearExternalTime: function(){ externalT = null; } };
})();
</script>
</body>
</html>
# fit-table — T190 pixel-icon cold open (guard-measured-fit, A6 pre-wave leg; cured form after jev-prewave HOLD finding 2)

Method: PIL glyph measurement with DejaVu Sans Mono as the Courier-class monospace stand-in (fleet precedent T57: stand-in font, post-fit wrapped geometry, PIXEL-UNVERIFIED — no browser route from this seat). Font: DejaVuSansMono.ttf at CONFIG `captionFontPx` 28; measured advance 16.8594 px → factor 0.6021 (CONFIG carries 0.6023). Each row is a POST-LAYOUT measurement: the line as the build's `captionLayout` actually lays it out (word-boundary two-line split minimizing the longest line; fit-shrink of fontPx when the best split still exceeds avail), rendered to a bitmap and measured (ink bbox). Container avail = stageWPx 640 − 2×captionPadPx 6 = 628 px. Ink height also printed at the 360 px stage (×360/640). Raw measurement output is filed verbatim in build-record.md.

| element (layout line) | container | measured ink bounds | container bounds | margin (binding side) |
|---|---|---|---|---|
| L1 line 1 "MORE THAN 430 MILLION PEOPLE" | caption band | 470 px wide · ink height 20 px (11.25 @360) | 628 px avail · band 64 px | 158 px |
| L1 line 2 "WITH DISABLING HEARING LOSS" | caption band | 453 px · 20 px (11.25 @360) | 628 px · band 64 px | 175 px |
| L2 line 1 "RELY ON CAPTIONS TO" | caption band | 318 px · 20 px (11.25 @360) | 628 px · band 64 px | 310 px |
| L2 line 2 "WATCH MOVIES AND SHOWS" | caption band | 369 px · 20 px (11.25 @360) | 628 px · band 64 px | 259 px |
| BLANK (6000–8000 ms) | caption band | no ink (scheduled blank) | — | — |
| L3 line 1 "HOWEVER, THE CURRENT CAPTIONING" | caption band | 521 px · 24 px (13.50 @360) | 628 px · band 64 px | 107 px |
| L3 line 2 "SYSTEM HAS SEVERAL SHORTCOMINGS" | caption band | 520 px · 20 px (11.25 @360) | 628 px · band 64 px | 108 px |
| L4 line 1 "THAT CAN MAKE THE VIEWING" | caption band | 421 px · 20 px (11.25 @360) | 628 px · band 64 px | 207 px |
| L4 line 2 "EXPERIENCE FRUSTRATING" | caption band | 368 px · 20 px (11.25 @360) | 628 px · band 64 px | 260 px |
| L5 "FOR DEAF AUDIENCES" (1 line) | caption band | 299 px · 20 px (11.25 @360) | 628 px · band 64 px | 329 px |
| swap L3 line 1 (71-char case, fitted fontPx 27.4) | caption band | 625 px · 24 px (13.50 @360) | 628 px · band 64 px | 3 px |
| swap L3 line 2 (fitted fontPx 27.4) | caption band | 525 px · 20 px (11.25 @360) | 628 px · band 64 px | 103 px |

Legibility floor (~11 px at 360 px stage): every measured line's ink height at 360 px is 11.25–13.50 px — PASS (floor met, thin margin +0.25 px on caps-only lines; the readability lens prices legibility in motion, which this leg does not own).
Two-line stack: 2 × 28 × 1.1 (CONFIG line-height factor) = 61.6 px ≤ 64 px band — fits with 2.4 px margin.
Hierarchy: single caption slot, one size per caption (fit-shrink varies it by ≤0.6 px across captions) — no hierarchy claimed, none to measure.

Icon geometry (renderer-matching projected bounds, HOLD cure 2 — `boundsFor` projects the map corners through CONFIG perspective + rotateY exactly as the renderer transforms them): at the camera scale peak (9500 ms) top −48.3 px (intentional top-edge crop, census f010) · bottom 264.3 px vs band limit 296 px. Whole-timeline sweep on a 100 ms grid (139 samples): max bottom 279.8 px, 0 band violations; min top −63.8 px (turn excursions only).

