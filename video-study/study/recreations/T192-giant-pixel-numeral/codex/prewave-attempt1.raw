   159	/* ============ state function (own-check assertions evaluate this) ============ */
   160	function stateAt(t){
   161	  const phase = phaseAt(t);
   162	  let locked = 0, topBorrowed = 0, topTotal = 0, looseVisible = 0, rainBelow = 0;
   163	  const frontNorm = Math.min(1, Math.max(0, (t - T.formationStartMs)/T.formationDurationMs));
   164	  const frontY = minY + frontNorm * spanY;
   165	  let aboveTotal = 0, aboveLocked = 0;
   166	  for(const tg of targets){ if(tg.rowNorm < 0.25){ topTotal++; } if(tg.rowNorm <= frontNorm*0.8) aboveTotal++; }
   167	  for(const p of particles){
   168	    if(p.kind === "borrower"){
   169	      const st = borrowerState(p, t);
   170	      if(st.state === "locked") locked++;
   171	      if(p.target.rowNorm < 0.25 && t >= p.borrowStart) topBorrowed++;
   172	      if(p.target.rowNorm <= frontNorm*0.8 && st.state === "locked") aboveLocked++;
   173	      if(st.state !== "locked"){
   174	        const op = (st.state === "stream" || st.state === "borrowing") ? looseOpacity("borrower", phase) : st.opacity;
   175	        const eff = (phase === "HOLD" && st.state !== "released") ? op : st.opacity;
   176	        if(phase === "HOLD" ? eff > 0.02 : st.opacity > 0.02) looseVisible++;
   177	        if(st.pos.y > frontY && st.opacity > 0.02) rainBelow++;
   178	      }
   179	    } else {
   180	      const op = looseOpacity(p.kind, phase);
   181	      if(op > 0.02) looseVisible++;
   182	      const pos = streamPos(p, t);
   183	      if(pos.y > frontY && op > 0.02) rainBelow++;
   184	    }
   185	  }
   186	  return { t:t, phase:phase, occupancy: targets.length ? locked/targets.length : 0, locked:locked,
   187	    targetCount: targets.length, topBandBorrowedFraction: topTotal ? topBorrowed/topTotal : 0,
   188	    rowsAboveFrontOccupancy: aboveTotal ? aboveLocked/aboveTotal : 1,
   189	    rainBelowFrontCount: rainBelow, visibleLooseCount: looseVisible, lineOpacity: lineOpacityAt(t),
   190	    counts:{ targets: targets.length, reserve: reserveCount, surplus: surplusCount, pool: poolTotal } };
