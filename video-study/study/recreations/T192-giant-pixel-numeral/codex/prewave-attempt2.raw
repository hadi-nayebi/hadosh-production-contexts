   219	    ctx.font = CONFIG.line.fontWeight + " " + (CONFIG.line.sizeFraction*H) + "px " + CONFIG.line.fontFamily;
   220	    ctx.textAlign = "center"; ctx.textBaseline = "middle";
   221	    ctx.fillText(CONFIG.text.line, W/2, CONFIG.line.yFraction*H);
