   112	/* ============ flow field: ONE constant field; stream position is a pure function of t ============ */
   113	function streamPos(p, tMs){
   114	  const dt = tMs/1000;
   115	  let x = (p.s.sx + VX*dt) % W; if(x<0)x+=W;
   116	  let y = (p.s.sy + VY*dt) % H; if(y<0)y+=H;
   117	  return { x:x, y:y };
   118	}
   119	function streamPosRaw(p, tMs){ const dt=tMs/1000; return { x: p.s.sx + VX*dt, y: p.s.sy + VY*dt }; }
   120	function ease(u){ return 1-(1-u)*(1-u); }
   121	function phaseAt(t){
   122	  if(t < T.formationStartMs - T.clusterLeadMs) return "PRE";
   123	  if(t < T.formationStartMs + T.formationDurationMs) return "FORM";
   124	  if(t < T.exitStartMs) return "HOLD";
   125	  if(t < T.exitStartMs + T.exitDurationMs) return "RELEASE";
   126	  return "DONE";
   127	}
   128	function lineOpacityAt(t){
   129	  const start = T.formationStartMs - CONFIG.line.fadeMs;
   130	  if(t <= start) return 0;
   131	  if(t >= T.formationStartMs) return 1;
   132	  return (t - start) / CONFIG.line.fadeMs;
   133	}
   134	function borrowerState(p, t){
   135	  if(t < p.borrowStart) return { state:"stream", pos: streamPos(p,t), opacity: P.reserveOpacity };
   136	  if(t < p.lockAt){
   137	    const u = (t - p.borrowStart) / P.travelMs, e = ease(u), sp = streamPos(p, p.borrowStart);
