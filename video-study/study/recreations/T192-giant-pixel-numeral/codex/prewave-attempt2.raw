   241	  seek: function(ms){ baseT = Math.max(0, ms); baseStamp = null; lastT = baseT % CYCLE_MS; render(lastT); },
   242	  setPaused: function(p){ if(p){ baseT = lastT; } baseStamp = null; isPaused = !!p; },
