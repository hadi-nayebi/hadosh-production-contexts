   140	             opacity: P.reserveOpacity + (P.borrowOpacity - P.reserveOpacity)*u };
   141	  }
   142	  if(t < p.releaseStart) return { state:"locked", pos:{ x:p.target.x, y:p.target.y }, opacity: P.borrowOpacity };
   143	  if(t < p.releaseStart + P.releaseMs){
   144	    const dt = (t - p.releaseStart)/1000;
   145	    return { state:"released", pos:{ x:p.target.x + VX*dt, y:p.target.y + VY*dt },
   146	             opacity: P.borrowOpacity + (P.reserveOpacity - P.borrowOpacity)*((t-p.releaseStart)/P.releaseMs) };
   147	  }
