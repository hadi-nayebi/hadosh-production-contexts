    57	/* ============ A1.2 runtime sampling of config-rendered text ============ */
    58	function sampleTargets(){
    59	  const off = document.createElement("canvas"); off.width = W; off.height = H;
    60	  const o = off.getContext("2d");
    61	  let fontPx = 300;
    62	  o.font = CONFIG.numeral.fontWeight + " " + fontPx + "px " + CONFIG.numeral.fontFamily;
    63	  const w0 = Math.max(1, o.measureText(CONFIG.text.numeral).width);
    64	  fontPx = fontPx * (CONFIG.numeral.widthFraction * W) / w0;
    65	  const maxFontByHeight = (CONFIG.numeral.heightFractionMax * H) / CONFIG.numeral.capHeightRatio;
    66	  if(fontPx > maxFontByHeight) fontPx = maxFontByHeight;
    67	  o.font = CONFIG.numeral.fontWeight + " " + fontPx + "px " + CONFIG.numeral.fontFamily;
    68	  o.fillStyle = "#ffffff"; o.textAlign = "center"; o.textBaseline = "middle";
    69	  o.fillText(CONFIG.text.numeral, W/2, CONFIG.numeral.centerYFraction * H);
