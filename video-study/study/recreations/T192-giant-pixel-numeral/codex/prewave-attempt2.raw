    15	<div class="controls">
    16	  <button id="playBtn" type="button">Play</button>
    17	  <button id="restartBtn" type="button">Restart</button>
    18	</div>
    19	<div class="wrap">
    20	  <div class="side"><h2>ORIGINAL — Caption with Intention @ 0:22–0:27</h2>
    21	    <video id="orig" src="segment.mp4" playsinline muted></video></div>
    22	  <div class="side"><h2>RECREATION — T192 giant pixel numeral, parameterized</h2>
    23	    <iframe id="rec" src="recreation.html" title="recreation"></iframe></div>
    24	</div>
    25	<script>
    26	"use strict";
    27	/* ONE synchronized control set. Single clock mapping (plan, as amended):
    28	   recreationMs = videoMs - 500  (video 0 = source 21.5s; recreation 0 = source 22.0s).
    29	   The recreation iframe renders from its own rAF loop started on load; Play/Restart
    30	   drive the video and reload the recreation so both clocks share the start act. */
    31	var orig = document.getElementById("orig");
    32	var rec = document.getElementById("rec");
    33	var playBtn = document.getElementById("playBtn");
    34	function recApi(){ try { return rec.contentWindow && rec.contentWindow.__T192; } catch(e){ return null; } }
    35	function slaveRec(){
    36	  var a = recApi(); if(!a) return;
    37	  var ms = orig.currentTime*1000 - 500; /* single mapping: recreationMs = videoMs - 500 */
    38	  if(ms < 0) ms = 0;
    39	  a.seek(ms);
    40	  a.setPaused(orig.paused);
    41	}
    42	function restartBoth(){
    43	  orig.currentTime = 0.5; /* recreation zero */
    44	  var a = recApi(); if(a){ a.seek(0); a.setPaused(false); }
    45	  orig.play();
    46	  playBtn.textContent = "Pause";
    47	}
    48	playBtn.addEventListener("click", function(){
    49	  if(orig.paused){ orig.play(); playBtn.textContent = "Pause"; }
    50	  else { orig.pause(); playBtn.textContent = "Play"; }
    51	  slaveRec();
    52	});
    53	document.getElementById("restartBtn").addEventListener("click", restartBoth);
    54	orig.addEventListener("timeupdate", slaveRec);
    55	orig.addEventListener("seeked", slaveRec);
    56	orig.addEventListener("pause", slaveRec);
    57	orig.addEventListener("ended", function(){ playBtn.textContent = "Play"; slaveRec(); });
    58	rec.addEventListener("load", slaveRec);
    59	</script></body></html>

