   637	     5	<meta name="viewport" content="width=device-width, initial-scale=1">
   638	     6	<title>T196 — pre-lighting, parameterized recreation</title>
   639	     7	<style>
   640	     8	  html,body{margin:0;padding:0;background:#111;}
   641	     9	  #stage{position:relative;width:100%;aspect-ratio:16/9;background:#000;overflow:hidden;}
   642	    10	  #box{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;}
   643	    11	  .card{position:absolute;inset:0;display:none;align-items:center;justify-content:center;text-align:center;flex-wrap:wrap;align-content:center;}
   644	    12	  .card.active{display:flex;}
   645	    13	  .w{display:inline-block;margin:0 .18em;}
   646	    14	  #hud{position:absolute;left:8px;bottom:6px;color:#888;font:12px monospace;}
   647	    15	  #ctl{display:flex;gap:8px;padding:8px;background:#181818;}
   648	    16	  #ctl button{font:14px sans-serif;padding:10px 16px;}
   649	    17	</style>
   650	    18	</head>
   651	    19	<body>
   652	    20	<div id="stage"><div id="box"><div id="slot"></div></div><div id="hud"></div></div>
   653	    21	<div id="ctl"><button id="playBtn" type="button">Play / Pause</button><button id="restartBtn" type="button">Restart</button></div>
   654	    22	<script>
   655	    23	"use strict";
   656	    24	/* ================= CONFIG — every parameter-table key (Plan §2, as amended Cycle 035) ================= */
   657	    25	const CONFIG = {
   658	    26	  windowStartS: 47.76,
   659	    27	  headHandleS: 0.5,
   660	    28	  timingScale: 1.0,
   661	    29	  finalHoldMs: 1920,
   662	    30	  epsilonMs: 1,
   663	    31	  bg: "#000000",
   664	    32	  unspoken: { color: "#f5f5f5", opacity: 1, weight: 400, scale: 1 },
   665	    33	  spoken:   { color: "#ffe600", opacity: 1, weight: 400, scale: 1 },
   666	    34	  contrastFloor: 7,
   667	    35	  pairDeltaEMin: 30,
   668	    36	  stageBox: { widthPct: 88, heightPct: 62 },
   669	    37	  font: { family: "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
   670	    38	          minSizePx: 20, maxSizePx: 64, lineHeight: 1.25, wrap: "wrap-in-box",
   671	    39	          overflow: "shrink-to-min-then-fail-fit" },
   672	    40	  cards: [
   673	    41	    { id: "c1", onsetMs: 1032, words: [
   674	    42	      { w: "This", onsetMs: 480 }, { w: "system", onsetMs: 1160 }, { w: "brings", onsetMs: 1380 },
   675	    43	      { w: "in", onsetMs: 1620 }, { w: "varying", onsetMs: 1780 } ] },
   676	    44	    { id: "c2", onsetMs: 2080, words: [
   677	    45	      { w: "types", onsetMs: 2020 }, { w: "sizes,", onsetMs: 2320 }, { w: "weights", onsetMs: 3000 },
   678	    46	      { w: "and", onsetMs: 4220 }, { w: "animation,", onsetMs: 4380 } ] },
   679	    47	    { id: "c3", onsetMs: 5032, words: [
   680	    48	      { w: "so", onsetMs: 5060 }, { w: "you", onsetMs: 5160 }, { w: "can", onsetMs: 5280 },
   681	    49	      { w: "feel", onsetMs: 5400 }, { w: "when", onsetMs: 5800 }, { w: "my", onsetMs: 6140 },
   682	    50	      { w: "voice", onsetMs: 6340 }, { w: "gets", onsetMs: 6640 }, { w: "louder", onsetMs: 6880 },
   683	    51	      { w: "or", onsetMs: 8000 }, { w: "softer", onsetMs: 8640 } ] }
   684	    52	  ]
   685	    53	};
   686	    54	/* ================= Engine — everything derived from CONFIG ================= */
   687	    55	function derive(cfg){
   688	    56	  const ts = cfg.timingScale;
   689	    57	  const cards = cfg.cards.map(c => ({
   690	    58	    id: c.id, onsetMs: c.onsetMs * ts,
   691	    59	    words: c.words.map(w => ({ w: w.w, onsetMs: w.onsetMs * ts }))
   692	    60	  }));
   693	    61	  let lastFlip = 0;
   694	    62	  for (const c of cards) for (const w of c.words) lastFlip = Math.max(lastFlip, w.onsetMs);
   695	    63	  const totalMs = lastFlip + cfg.finalHoldMs * ts;
   696	    64	  return { cards, totalMs, lastFlip };
   697	    65	}
   698	    66	function activeCardAt(derived, t){
   699	    67	  let act = null;
   700	    68	  for (const c of derived.cards) if (t >= c.onsetMs) act = c;
   701	    69	  return act;
   702	    70	}
   703	    71	/* Pure state function: spoken iff word.onsetMs < t (explicit tie rule). Terminal state (t >= totalMs) clamps to the final card fully spoken. */
   704	    72	function stateAt(cfg, t){
   705	    73	  const d = derive(cfg);
   706	    74	  const tc = Math.min(Math.max(t, 0), d.totalMs);
   707	    75	  const act = activeCardAt(d, tc);
   708	    76	  if (!act) return { t: tc, totalMs: d.totalMs, activeCardId: null, cards: d.cards.map(c => ({ id: c.id, visible: false, words: c.words.map(w => ({ w: w.w, present: true, visible: false, spoken: false })) })) };
   709	    77	  return { t: tc, totalMs: d.totalMs, activeCardId: act.id,
   710	    78	    cards: d.cards.map(c => ({ id: c.id, visible: c.id === act.id,
   711	    79	      words: c.words.map(w => ({ w: w.w, present: true, visible: c.id === act.id, spoken: w.onsetMs < tc })) })) };
   712	    80	}
   713	    81	/* ================= Rendering — prebuilt spans, one stage slot, atomic handoff ================= */
   714	    82	const stage = document.getElementById("stage");
   715	    83	const box = document.getElementById("box");
   716	    84	const slot = document.getElementById("slot");
   717	    85	const hud = document.getElementById("hud");
   718	    86	box.style.width = CONFIG.stageBox.widthPct + "%";
   719	    87	box.style.height = CONFIG.stageBox.heightPct + "%";
   720	    88	slot.style.position = "relative"; slot.style.width = "100%"; slot.style.height = "100%";
   721	    89	const cardEls = {};
   722	    90	function buildDom(cfg){
   723	    91	  slot.textContent = "";
   724	    92	  for (const c of cfg.cards){
   725	    93	    const el = document.createElement("div");
   726	    94	    el.className = "card"; el.dataset.card = c.id;
   727	    95	    el.style.fontFamily = cfg.font.family; el.style.lineHeight = cfg.font.lineHeight;
   728	    96	    const spans = [];
   729	    97	    for (const wd of c.words){
   730	    98	      const s = document.createElement("span");
   731	    99	      s.className = "w"; s.textContent = wd.w; s.dataset.onset = wd.onsetMs;
   732	   100	      el.appendChild(s); spans.push(s);
   733	   101	    }
   734	   102	    slot.appendChild(el);
   735	   103	    cardEls[c.id] = { el, spans };
   736	   104	  }
   737	   105	}
   738	   106	function fitCard(cfg, cardId){
   739	   107	  const stageW = stage.clientWidth || 360;
   740	   108	  const boxW = stageW * cfg.stageBox.widthPct / 100;
   741	   109	  const boxH = (stageW * 9 / 16) * cfg.stageBox.heightPct / 100;
   742	   110	  const rec = cardEls[cardId]; if (!rec) return null;
   743	   111	  let size = cfg.font.maxSizePx;
   744	   112	  const probe = (px) => {
   745	   113	    rec.el.style.fontSize = px + "px";
   746	   114	    let inkW = 0, inkH = 0;
   747	   115	    for (const s of rec.spans){ inkW += s.offsetWidth; inkH = Math.max(inkH, s.offsetHeight); }
   748	   116	    const lines = Math.max(1, Math.ceil(inkW / boxW));
   749	   117	    return { inkW, inkH, lines, totalH: lines * px * cfg.font.lineHeight, fits: inkW <= boxW * lines && lines * px * cfg.font.lineHeight <= boxH && inkW <= boxW * 3 };
   750	   118	  };
   751	   119	  let m = probe(size);
   752	   120	  while (size > cfg.font.minSizePx && (m.totalH > boxH || m.inkW / m.lines > boxW)) { size -= 2; m = probe(size); }
   753	   121	  const fits = m.totalH <= boxH && size >= cfg.font.minSizePx;
   754	   122	  return { cardId, fontSizePx: size, inkW: Math.round(m.inkW), inkH: Math.round(m.inkH), lines: m.lines, boxW: Math.round(boxW), boxH: Math.round(boxH), fits };
   755	   123	}
   756	   124	function render(cfg, t){
   757	   125	  const st = stateAt(cfg, t);
   758	   126	  for (const c of st.cards){
   759	   127	    const rec = cardEls[c.id]; if (!rec) continue;
   760	   128	    rec.el.classList.toggle("active", c.visible);
   761	   129	    c.words.forEach((w, i) => {
   762	   130	      const sp = rec.spans[i]; if (!sp) return;
   763	   131	      const sty = w.spoken ? cfg.spoken : cfg.unspoken;
   764	   132	      sp.style.color = sty.color; sp.style.opacity = sty.opacity;
   765	   133	      sp.style.fontWeight = sty.weight; sp.style.transform = "scale(" + sty.scale + ")";
   766	   134	    });
   767	   135	  }
   768	   136	  hud.textContent = "t=" + Math.round(st.t) + "ms / " + Math.round(st.totalMs) + "ms · card " + (st.activeCardId || "—");
   769	   137	  return st;
   770	   138	}
   771	   139	/* ================= Playback — timestamp-derived state (seek/restart derive identically) ================= */
   772	   140	let playing = false, startStamp = 0, baseMs = 0;
   773	   141	function nowMs(){ return playing ? baseMs + (performance.now() - startStamp) : baseMs; }
   774	   142	function tick(){ render(CONFIG, nowMs()); if (playing) requestAnimationFrame(tick); }
   775	   143	document.getElementById("playBtn").addEventListener("click", () => {
   776	   144	  playing = !playing;
   777	   145	  if (playing) { startStamp = performance.now(); requestAnimationFrame(tick); }
   778	   146	  else { baseMs = nowMs(); render(CONFIG, baseMs); }
   779	   147	});
   780	   148	document.getElementById("restartBtn").addEventListener("click", () => {
   781	   149	  baseMs = 0; startStamp = performance.now(); render(CONFIG, 0);
   782	   150	});
   783	   151	buildDom(CONFIG);
   784	   152	for (const c of CONFIG.cards) fitCard(CONFIG, c.id);
   785	   153	render(CONFIG, 0);
   786	   154	window.__T196 = { CONFIG, derive, stateAt, render, fitCard };
   787	   155	</script>
   788	   156	</body>
   789	   157	</html>
   790	     1	# T196 — Measured-fit leg (A6, guard-measured-fit) · attempt 1 · Cycle 035
