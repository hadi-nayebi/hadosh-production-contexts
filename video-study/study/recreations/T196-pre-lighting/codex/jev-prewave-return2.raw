     1	<!DOCTYPE html>
     2	<html lang="en">
     3	<head>
     4	<meta charset="utf-8">
     5	<meta name="viewport" content="width=device-width, initial-scale=1">
     6	<title>T196 — pre-lighting, parameterized recreation</title>
     7	<style>
     8	  html,body{margin:0;padding:0;background:#111;}
     9	  #stage{position:relative;width:100%;aspect-ratio:16/9;background:#000;overflow:hidden;}
    10	  #box{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;}
    11	  .card{position:absolute;inset:0;display:none;align-items:center;justify-content:center;text-align:center;flex-wrap:wrap;align-content:center;}
    12	  .card.active{display:flex;}
    13	  .w{display:inline-block;margin:0 .18em;}
    14	  #hud{position:absolute;left:8px;bottom:6px;color:#888;font:12px monospace;}
    15	  #ctl{display:flex;gap:8px;padding:8px;background:#181818;}
    16	  #ctl button{font:14px sans-serif;padding:10px 16px;}
    17	</style>
    18	</head>
    19	<body>
    20	<div id="stage"><div id="box"><div id="slot"></div></div><div id="hud"></div></div>
    21	<div id="ctl"><button id="playBtn" type="button">Play / Pause</button><button id="restartBtn" type="button">Restart</button></div>
    22	<script>
    23	"use strict";
    24	/* ================= CONFIG — every parameter-table key (Plan §2, as amended Cycle 035) ================= */
    25	const CONFIG = {
    26	  windowStartS: 47.76,
    27	  headHandleS: 0.5,
    28	  timingScale: 1.0,
    29	  finalHoldMs: 1920,
    30	  epsilonMs: 1,
    31	  bg: "#000000",
    32	  unspoken: { color: "#f5f5f5", opacity: 1, weight: 400, scale: 1 },
    33	  spoken:   { color: "#ffe600", opacity: 1, weight: 400, scale: 1 },
    34	  contrastFloor: 7,
    35	  pairDeltaEMin: 30,
    36	  stageBox: { widthPct: 88, heightPct: 62 },
    37	  font: { family: "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    38	          minSizePx: 20, maxSizePx: 64, lineHeight: 1.25, wrap: "wrap-in-box",
    39	          overflow: "shrink-to-min-then-fail-fit" },
    40	  cards: [
    41	    { id: "c1", onsetMs: 1032, words: [
    42	      { w: "This", onsetMs: 480 }, { w: "system", onsetMs: 1160 }, { w: "brings", onsetMs: 1380 },
    43	      { w: "in", onsetMs: 1620 }, { w: "varying", onsetMs: 1780 } ] },
    44	    { id: "c2", onsetMs: 2080, words: [
    45	      { w: "types", onsetMs: 2020 }, { w: "sizes,", onsetMs: 2320 }, { w: "weights", onsetMs: 3000 },
    46	      { w: "and", onsetMs: 4220 }, { w: "animation,", onsetMs: 4380 } ] },
    47	    { id: "c3", onsetMs: 5032, words: [
    48	      { w: "so", onsetMs: 5060 }, { w: "you", onsetMs: 5160 }, { w: "can", onsetMs: 5280 },
    49	      { w: "feel", onsetMs: 5400 }, { w: "when", onsetMs: 5800 }, { w: "my", onsetMs: 6140 },
    50	      { w: "voice", onsetMs: 6340 }, { w: "gets", onsetMs: 6640 }, { w: "louder", onsetMs: 6880 },
    51	      { w: "or", onsetMs: 8000 }, { w: "softer", onsetMs: 8640 } ] }
    52	  ]
    53	};
    54	/* ================= Engine — everything derived from CONFIG ================= */
    55	function derive(cfg){
    56	  const ts = cfg.timingScale;
    57	  const cards = cfg.cards.map(c => ({
    58	    id: c.id, onsetMs: c.onsetMs * ts,
    59	    words: c.words.map(w => ({ w: w.w, onsetMs: w.onsetMs * ts }))
    60	  }));
    61	  let lastFlip = 0;
    62	  for (const c of cards) for (const w of c.words) lastFlip = Math.max(lastFlip, w.onsetMs);
    63	  const totalMs = lastFlip + cfg.finalHoldMs * ts;
    64	  return { cards, totalMs, lastFlip };
    65	}
    66	function activeCardAt(derived, t){
    67	  let act = null;
    68	  for (const c of derived.cards) if (t >= c.onsetMs) act = c;
    69	  return act;
    70	}
    71	/* Pure state function: spoken iff word.onsetMs < t (explicit tie rule). Terminal state (t >= totalMs) clamps to the final card fully spoken. */
    72	function stateAt(cfg, t){
    73	  const d = derive(cfg);
    74	  const tc = Math.min(Math.max(t, 0), d.totalMs);
    75	  const act = activeCardAt(d, tc);
    76	  if (!act) return { t: tc, totalMs: d.totalMs, activeCardId: null, cards: d.cards.map(c => ({ id: c.id, visible: false, words: c.words.map(w => ({ w: w.w, present: true, visible: false, spoken: false })) })) };
    77	  return { t: tc, totalMs: d.totalMs, activeCardId: act.id,
    78	    cards: d.cards.map(c => ({ id: c.id, visible: c.id === act.id,
    79	      words: c.words.map(w => ({ w: w.w, present: true, visible: c.id === act.id, spoken: w.onsetMs < tc })) })) };
    80	}
    81	/* ================= Rendering — prebuilt spans, one stage slot, atomic handoff ================= */
    82	const stage = document.getElementById("stage");
    83	stage.style.background = CONFIG.bg;
    84	const box = document.getElementById("box");
    85	const slot = document.getElementById("slot");
    86	const hud = document.getElementById("hud");
    87	box.style.width = CONFIG.stageBox.widthPct + "%";
    88	box.style.height = CONFIG.stageBox.heightPct + "%";
    89	slot.style.position = "relative"; slot.style.width = "100%"; slot.style.height = "100%";
    90	const cardEls = {};
    91	function buildDom(cfg){
    92	  slot.textContent = "";
    93	  for (const c of cfg.cards){
    94	    const el = document.createElement("div");
    95	    el.className = "card"; el.dataset.card = c.id;
    96	    el.style.fontFamily = cfg.font.family; el.style.lineHeight = cfg.font.lineHeight;
    97	    const spans = [];
    98	    for (const wd of c.words){
    99	      const s = document.createElement("span");
   100	      s.className = "w"; s.textContent = wd.w; s.dataset.onset = wd.onsetMs;
   101	      el.appendChild(s); spans.push(s);
   102	    }
   103	    slot.appendChild(el);
   104	    cardEls[c.id] = { el, spans };
   105	  }
   106	}
   107	function fitCard(cfg, cardId){
   108	  const stageW = stage.clientWidth || 360;
   109	  const boxW = stageW * cfg.stageBox.widthPct / 100;
   110	  const boxH = (stageW * 9 / 16) * cfg.stageBox.heightPct / 100;
   111	  const rec = cardEls[cardId]; if (!rec) return null;
   112	  let size = cfg.font.maxSizePx;
   113	  /* Probe contract = fit-table contract: the card is measured while laid out
   114	     (display:flex, visibility:hidden — never display:none, whose spans report
   115	     zero widths), each word's ink includes its CSS word margins
   116	     (0.18em each side), and wrapping is greedy per word inside boxW. */
   117	  const probe = (px) => {
   118	    const el = rec.el;
   119	    const prevDisplay = el.style.display, prevVis = el.style.visibility;
   120	    el.style.display = "flex"; el.style.visibility = "hidden";
   121	    el.style.fontSize = px + "px";
   122	    const marginPx = 0.36 * px;
   123	    let inkW = 0, inkH = 0, lines = 1, lineW = 0;
   124	    for (const s of rec.spans){
   125	      const wW = s.offsetWidth + marginPx;
   126	      inkW += wW; inkH = Math.max(inkH, s.offsetHeight);
   127	      if (lineW > 0 && lineW + wW > boxW) { lines += 1; lineW = wW; } else { lineW += wW; }
   128	    }
   129	    el.style.display = prevDisplay; el.style.visibility = prevVis;
   130	    const totalH = lines * px * cfg.font.lineHeight;
   131	    return { inkW, inkH, lines, totalH, fits: totalH <= boxH };
   132	  };
   133	  let m = probe(size);
   134	  while (size > cfg.font.minSizePx && !m.fits) { size -= 2; m = probe(size); }
   135	  const fits = m.fits && size >= cfg.font.minSizePx;
   136	  return { cardId, fontSizePx: size, inkW: Math.round(m.inkW), inkH: Math.round(m.inkH), lines: m.lines, boxW: Math.round(boxW), boxH: Math.round(boxH), fits };
   137	}
   138	function render(cfg, t){
   139	  const st = stateAt(cfg, t);
   140	  for (const c of st.cards){
   141	    const rec = cardEls[c.id]; if (!rec) continue;
   142	    rec.el.classList.toggle("active", c.visible);
   143	    c.words.forEach((w, i) => {
   144	      const sp = rec.spans[i]; if (!sp) return;
   145	      const sty = w.spoken ? cfg.spoken : cfg.unspoken;
   146	      sp.style.color = sty.color; sp.style.opacity = sty.opacity;
   147	      sp.style.fontWeight = sty.weight; sp.style.transform = "scale(" + sty.scale + ")";
   148	    });
   149	  }
   150	  hud.textContent = "t=" + Math.round(st.t) + "ms / " + Math.round(st.totalMs) + "ms · card " + (st.activeCardId || "—");
   151	  return st;
   152	}
   153	/* ================= Playback — timestamp-derived state (seek/restart derive identically) ================= */
   154	let playing = false, startStamp = 0, baseMs = 0;
   155	function nowMs(){ return playing ? baseMs + (performance.now() - startStamp) : baseMs; }
   156	function tick(){ render(CONFIG, nowMs()); if (playing) requestAnimationFrame(tick); }
   157	document.getElementById("playBtn").addEventListener("click", () => {
   158	  playing = !playing;
   159	  if (playing) { startStamp = performance.now(); requestAnimationFrame(tick); }
   160	  else { baseMs = nowMs(); render(CONFIG, baseMs); }
   161	});
   162	document.getElementById("restartBtn").addEventListener("click", () => {
   163	  baseMs = 0; startStamp = performance.now(); render(CONFIG, 0);
   164	});
   165	buildDom(CONFIG);
   166	for (const c of CONFIG.cards) fitCard(CONFIG, c.id);
   167	render(CONFIG, 0);
   168	window.__T196 = { CONFIG, derive, stateAt, render, fitCard };
   169	</script>
   170	</body>
   171	</html>
     1	# T196 — Plan Amendment · Cycle 035 Wave 32 (filed BEFORE any build script, per A9.2 + wave RUN §2b)
     2	
     3	Source: jev-plan-exit REVISE (T196) + jev-observe-exit charges, consumed in wave RUN §2b. This amendment amends the Cycle-034 item record's Plan; the build executes the Plan AS AMENDED. The Cycle-034 record is not retro-edited (A8).
     4	
     5	## A1 — CP3b source-fidelity result (separate from the schedule assertions)
     6	CP3b is a SOURCE-FIDELITY checkpoint, reported separately from CP3a's schedule result:
     7	- Census state at source 55.0 s (ev/t055): prefix through "gets" spoken; "louder or softer" WHITE + unscaled.
     8	- Build state at the corresponding instant (build 7,240 ms = source 55.0): the ASR-anchored schedule has "louder" (onset 6,880 ms) ALREADY SPOKEN.
     9	- **Expected departure (priced, D3):** SOURCE-FIDELITY at CP3b = DEPARTURE-EXPECTED. The build follows the ASR onset series (the only complete onset series); the source's visual flip for "louder" lags ASR by >360 ms. CP3b does NOT pass as fidelity and does NOT fail the schedule: it is recorded as a named, priced departure. No revised visual onset is adopted for "louder" alone, because a single-word visual onset without the full per-word visual series would invent precision the census does not carry (D3 stays an explicit ASR-based approximation until visual flip times are measured).
    10	
    11	## A2 — Flip checks evaluate at onset + ε
    12	Every flip assertion evaluates at `onsetMs + ε`, ε = 1 ms (CONFIG-derived where the onset is CONFIG). CP5a's strict `spoken iff onset < t` at exactly t = 8,640 ms is untestable as filed (at t = onset the tie rule yields UNSPOKEN); CP5a therefore evaluates at 8,641 ms. The tie rule itself (`spoken iff onsetMs < t`) is unchanged and is asserted separately at the exact onset instant (state = unspoken).
    13	
    14	## A3 — End sample / terminal state
    15	CP5b evaluates at `totalMs − ε` (10,559 ms), inside card 3's half-open interval. Explicit terminal state: for t ≥ totalMs the stage holds card 3 fully spoken (the phase machine clamps to the final state); this terminal state is specified here and implemented as clamp, not as an interval extension.
    16	
    17	## A4 — Comparison uses ONE clock
    18	The comparison expression uses file-local `currentTime` only, with the head handle: **core build zero ≡ video 0.5 s**. The segment is cut with a 0.5 s head handle (source 47.26 s) and a 0.5 s tail handle (source 58.82 s), duration 11.56 s. Mapping: `buildMs = (video.currentTime − 0.5) × 1000` (at timingScale 1). The 47.76 s source timestamp never appears in the comparison's clock expression; it appears only in the label and in this record.
    19	
    20	## A5 — The 28 ms all-white interval: LOGIC vs PAINTED-FRAME outcomes kept separate
    21	CP1 reports two outcomes: (a) LOGIC — the state function at t = 5,032 ms yields card 3 with 11/11 spans present + unspoken (asserted mechanically); (b) PAINTED-FRAME — whether a painted frame in [5,032, 5,060) actually displayed the all-white card during continuous playback. This seat has no browser binary (PIXEL-UNVERIFIED, T132 precedent): PAINTED-FRAME = NOT EXERCISABLE IN THIS SEAT, recorded as such, never merged into the LOGIC result.
    22	
    23	## A6 — D2 act (observe-exit charge)
    24	Before card 2's visual anchor is frozen, a frame-measurement refresh is run inside the 49–50 s bracket (frames at 49.60 / 49.70 / 49.78 / 49.90 / 50.00 s extracted from source.mp4 and viewed). The measured result is recorded in build-record.md; the anchor is frozen only from that measurement (or the bracket is narrowed and the residual named).
    25	
    26	## A7 — D3 status
    27	D3 stays an explicit ASR-based approximation until per-word visual flip times are measured. No visual onset is claimed for any individual word.
    28	
    29	## A8 — Swap verification: three exact replacement cards + onset tables
    30	Swap words (film wording replaced wholesale; expectations derived from these tables, no harness edits):
    31	| Card | onsetMs | Words (word @ onsetMs) |
    32	|---|---|---|
    33	| S1 | 0 | Presence @0 · precedes @300 · emphasis @700 · entirely @1200 |
    34	| S2 | 2000 | Every @2000 · word @2300 · waits @2700 · visible @3200 |
    35	| S3 | 4500 | State @4500 · changes @4900 · nothing @5500 · appears @5900 · here @6600 |
    36	Derived expectations: counts 4/4/5 = 13 words; totalMs = last onset 6,600 + finalHoldMs 1,920 = 8,520 ms; card S1 word 1 tie at entry (onset 0, t=0 → unspoken at exact 0, spoken at 0+ε).
    37	Timing swap: `timingScale` 1.25 → every onset ×1.25, totalMs 10,650 ms; assertion instants re-derive from swapped CONFIG.
    38	Palette swap: `spoken.color` #ffe600 → #00e676.
    39	
    40	## A9 — Pair-difference metric + threshold (palette-swap check)
    41	Metric: **CIE76 ΔE in CIELAB** between spoken and unspoken colors, computed in the harness from the CONFIG hex values. Threshold: **ΔE ≥ 30** for BOTH the default palette and the swapped palette. (In addition, each state color's WCAG contrast ratio vs bg must be ≥ 7:1, per the Plan's contrastFloor.)
    42	
    43	## A10 — Stage-box percentages bound (fit check)
    44	CONFIG gains `stageBox: { widthPct: 88, heightPct: 62 }` — the stage box is 88% of stage width and 62% of stage height, reserved before first paint. The fit check measures against exactly these percentages at the 360 px stage (box = 316.8 × 223.2 px at 16:9 stage height 360×9/16=202.5 → box height 125.55 px; the harness computes from the actual stage geometry, these percentages are the bound values).
    45	
    46	## A11 — Cross-item record (observe-exit, from T197)
    47	This build's window (§1) records a new header ("Character Identification") first appearing at source 57.167 s, inside T197's window. The build-record records what this item's window evidence shows at 57.167 s (census frame t057.6 + pf057/pf058 bracket) so the seat can reconcile the two items' accounts.
     1	# T196 — Measured-fit leg (A6, guard-measured-fit) · attempt 1 · Cycle 035
     2	
     3	Stage 360 px wide (16:9 → stage height 202.5 px). Stage box bound by amendment A10: `stageBox` 88% × 62% → box 316.8 × 125.55 px. Measurement model: per-glyph advance widths (Helvetica/Arial-class metrics, fractions of em) summed over each card's actual CONFIG words + the CSS word margin (0.18 em × 2 per word); greedy word wrap inside the box; the build's own `fitCard` shrink loop (maxSizePx 64 → minSizePx 20, step 2) applies the same contract in-browser — REFILED at the Cycle-035 completion cure (jev-prewave HOLD cure): fitCard now probes each card laid out (display:flex, visibility:hidden — never display:none), includes the 0.36 em per-word margins in each word's ink, and wraps greedily per word, exactly this table's contract. Ink height = cap-height-class ink ≈ 0.72 × font size. PIXEL-UNVERIFIED seat (no browser binary): geometry is measured from glyph metrics, not from a rendered frame — printed limitation, carried to scores.md.
     4	
     5	| Element | Container | Fitted size | Measured ink (full line, unwrapped) | Lines after wrap | Ink height | Total height vs box 125.55 px | Margin (binding side) |
     6	|---|---|---|---|---|---|---|---|
     7	| Card c1 "This system brings in varying" (5 spans) | stage box 316.8 × 125.55 | 40 px | 543 px | 2 | 28.8 px | 100.0 px ≤ 125.55 ✓ | 25.55 px vertical |
     8	| Card c2 "types sizes, weights and animation," (5 spans) | stage box 316.8 × 125.55 | 32 px | 525 px | 2 | 23.0 px | 80.0 px ≤ 125.55 ✓ | 45.55 px vertical |
     9	| Card c3 "so you can feel when my voice gets louder or softer" (11 spans) | stage box 316.8 × 125.55 | 32 px | 767 px | 3 | 23.0 px | 120.0 px ≤ 125.55 ✓ | 5.55 px vertical |
    10	| HUD readout (non-subject, chrome) | stage bottom-left | 12 px monospace | — | 1 | ~8.6 px | n/a | n/a (not subject text) |
    11	
    12	Legibility floor (~11 px ink at 360 px stage): all subject rows 23.0–28.8 px — above floor ✓.
    13	Hierarchy: no size hierarchy is claimed between subject elements (D5 holds size constant across states and cards fit independently); state separation is color-only by construction, so the hue-only-hierarchy HIT class does not apply — the separation is instead discharged by the computed contrast floor + ΔE pair check in build-record.md (19.26 / 16.57 vs bg; ΔE 90.5 ≥ 30).
    14	
    15	**HIT list: EMPTY — PASS for this leg (0 hits).**
     1	# T196 — Config-census leg (A6, guard-config-census v3.1) · attempt 1 · Cycle 035
     2	
     3	File: recreation.html (8,255 B, SHA-256 d7dfe9409c55b1e351c29e8b358632f7072733ded8c46bea026054c0fdee0953). REFILED at the Cycle-035 completion cure (jev-prewave HOLD cure): the stage element's background is now applied from `CONFIG.bg` in the script (the CSS `#000` is only the pre-script fallback), and fitCard's probe contract was rewritten (see §2 note).
     4	
     5	## 1. All-literal scan (outside the CONFIG block)
     6	Hex colors outside CONFIG: `#111` (page background chrome), `#181818` (control-bar chrome), `#888` (HUD chrome gray), `#000` (stage fallback, restates CONFIG bg). All four are page chrome, not subject-shaping: the subject's colors (bg #000000, unspoken #f5f5f5, spoken #ffe600) live only in CONFIG. Classification: structural/chrome — exempt, printed per guard §1.
     7	Numeric literals outside CONFIG: CSS chrome sizes (8px/6px paddings, 12px HUD font, 14–16px button font, 50%/100% layout identities, 16/9 aspect identity), the word margin `0.18em` in the `.w` CSS rule, the fit loop step `2`, and the comparison-free constants `9/16` in fitCard's stage-height derivation. Classifications:
     8	- `0.18em` word margin — geometry of the subject line BUT identical for every word/state and already reflected in the fit measurement; it does not shape state, timing, or content. Classified structural-fixed — CARRIED as a noted borderline (a future re-attempt may promote it to CONFIG as `wordMarginEm`); not a HIT under this leg's class (it promises no CONFIG control it fails to exert, and no lens can price it against the subject's state behavior).
