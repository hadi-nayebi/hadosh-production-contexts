    72	var EASINGS = {
    73	  "easeInOut": function(p){ return p < 0.5 ? 2*p*p : 1 - Math.pow(-2*p + 2, 2)/2; },
    74	  "linear": function(p){ return p; },
    75	  "easeOut": function(p){ return 1 - Math.pow(1 - p, 3); },
    76	  "easeIn": function(p){ return p*p*p; }
    77	};
    78	function resolveEnv(cfg, w){
    79	  if (w.envelopeRef) {
    80	    var s = cfg.sharedEnvelopes[w.envelopeRef];
    81	    return { envOnsetMs: s.envOnsetMs, rampUpMs: s.rampMs, rampDownMs: 0, peakHoldMs: 0, sizePeak: s.sizePeak, weightPeak: s.weightPeak, persist: !!s.persist };
    82	  }
    83	  return { envOnsetMs: w.envOnsetMs, rampUpMs: w.rampUpMs, rampDownMs: w.rampDownMs, peakHoldMs: w.peakHoldMs || 0, sizePeak: w.sizePeak, weightPeak: w.weightPeak, persist: !!w.persist };
    84	}
    85	function lineReleaseMs(cfg, line){
    86	  var speechEnd = line.speechEndMs || 0, transientEnd = 0, i, w, e;
    87	  for (i = 0; i < line.words.length; i++) {
    88	    w = line.words[i]; e = resolveEnv(cfg, w);
    89	    var end = e.persist ? cfg.coreMs : e.envOnsetMs + e.rampUpMs + e.peakHoldMs + e.rampDownMs;
    90	    if ((e.sizePeak !== 1.0 || e.weightPeak !== cfg.baseWeight) && end > transientEnd) transientEnd = end;
    91	  }
    92	  return Math.max(speechEnd, transientEnd) + cfg.lineExitMs + cfg.lineGapMs;
    93	}
    94	function computeOwnership(cfg){
    95	  var clamps = [], releases = [], prevRelease = 0, li, wi;
    96	  for (li = 0; li < cfg.lines.length; li++) {
    97	    var line = cfg.lines[li], rel = lineReleaseMs(cfg, line);
    98	    releases.push(rel);
    99	    if (li > 0) {
   100	      for (wi = 0; wi < line.words.length; wi++) {
   101	        var w = line.words[wi], e = resolveEnv(cfg, w);
   102	        if ((e.sizePeak !== 1.0 || e.weightPeak !== cfg.baseWeight) && e.envOnsetMs < prevRelease && cfg.ownershipPolicy === "clamp-and-print") {
   103	          clamps.push({ word: w.text, requestedOnset: e.envOnsetMs, clampedOnset: prevRelease, releaseMs: prevRelease });
   104	        }
   105	      }
   106	    }
   107	    prevRelease = rel;
   108	  }
   109	  return { releases: releases, clamps: clamps };
   110	}
   111	function effectiveEnvOnset(cfg, ownership, lineIdx, w){
   112	  var e = resolveEnv(cfg, w), onset = e.envOnsetMs;
   113	  if (lineIdx > 0 && cfg.ownershipPolicy === "clamp-and-print") {
   114	    for (var i = 0; i < ownership.clamps.length; i++) {
   115	      if (ownership.clamps[i].word === w.text && ownership.clamps[i].requestedOnset === e.envOnsetMs) onset = ownership.clamps[i].clampedOnset;
   116	    }
   117	  }
   118	  return onset;
   119	}
   120	function envelopeAt(cfg, e, onset, t){
   121	  var ease = EASINGS[cfg.easingName] || EASINGS.easeInOut;
   122	  if (t < onset) return 0;
   123	  var peakAt = onset + e.rampUpMs;
   124	  if (t < peakAt) return e.rampUpMs > 0 ? ease((t - onset)/e.rampUpMs) : 1;
   125	  if (t < peakAt + e.peakHoldMs) return 1;
   126	  if (e.persist) return 1;
   127	  var decayStart = peakAt + e.peakHoldMs;
   128	  if (t < decayStart + e.rampDownMs) return e.rampDownMs > 0 ? 1 - ease((t - decayStart)/e.rampDownMs) : 0;
   129	  return 0;
   130	}
   131	function wordStateAt(cfg, ownership, lineIdx, w, t){
   132	  var e = resolveEnv(cfg, w);
   133	  var onset = effectiveEnvOnset(cfg, ownership, lineIdx, w);
   134	  var env = envelopeAt(cfg, e, onset, t);
   135	  var minRatio = cfg.minSizePctOfStage / cfg.baseSizePctOfStage;
   136	  var ratio = 1 + (e.sizePeak - 1) * env;
   137	  var fitFail = false;
   138	  if (ratio < minRatio) { ratio = minRatio; fitFail = true; }
   139	  return {
   140	    env: env,
   141	    sizeRatio: ratio,
   142	    sizePctOfStage: cfg.baseSizePctOfStage * ratio,
   143	    weight: Math.round(cfg.baseWeight + (e.weightPeak - cfg.baseWeight) * env),
   144	    spoken: t >= w.onsetMs,
   145	    fitFail: fitFail
   146	  };
