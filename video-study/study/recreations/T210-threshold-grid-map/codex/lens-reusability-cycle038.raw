<script id="t210-logic">

"use strict";
/* ---------- pure logic: CONFIG derivations, validation, stateAt (no DOM) ---------- */
const EASINGS = { easeInOut: p => p < 0.5 ? 2*p*p : 1 - Math.pow(-2*p + 2, 2)/2, linear: p => p };
function clamp01(x){ return x < 0 ? 0 : x > 1 ? 1 : x; }
function effStartMs(cfg, r){
  if (cfg.accumulationDirection === "outward"){
    let mn = Infinity, mx = -Infinity;
    for (const q of cfg.regions){ mn = Math.min(mn, q.startMs); mx = Math.max(mx, q.startMs); }
    return (mn + mx) - r.startMs;
  }
  return r.startMs;
}
function fillStartMs(cfg, r){ return effStartMs(cfg, r) + cfg.drawDurMs + cfg.fillDelayMs; }
function fillDurMs(cfg, r){
  const delta = effStartMs(cfg, r) - r.startMs;
  return (r.fillEndMs + delta) - fillStartMs(cfg, r);
}
function fillEndMs(cfg, r){ return fillStartMs(cfg, r) + fillDurMs(cfg, r); }
function derive(cfg){
  let latestDrawEnd = 0, latestFillEnd = 0;
  for (const r of cfg.regions){
    latestDrawEnd = Math.max(latestDrawEnd, effStartMs(cfg, r) + cfg.drawDurMs);
    latestFillEnd = Math.max(latestFillEnd, fillEndMs(cfg, r));
  }
  const postEnd = cfg.tPostMs + cfg.postDurMs;
  const completeAtMs = Math.max(cfg.tGridSettleMs, latestDrawEnd, latestFillEnd, postEnd);
  const fieldW = cfg.stageW - 2*cfg.marginPx;
  const pitch = fieldW / cfg.gridCols;
  return {
    completeAtMs, durationMs: completeAtMs + cfg.holdMs, postEnd, latestDrawEnd, latestFillEnd,
    thresholdLabel: String(cfg.threshold), postXFraction: cfg.threshold / cfg.total,
    fieldX: cfg.marginPx, fieldY: cfg.marginPx, fieldW, fieldH: pitch * cfg.gridRows,
    pitch, cellPx: pitch * (1 - cfg.gapRatio), gapPx: pitch * cfg.gapRatio
  };
}
function validateConfig(cfg){
  const errors = [];
  const nums = ["total","threshold","stageW","stageH","marginPx","gridCols","gridRows","gapRatio",
    "fillOpacity","outlineWidthPx","outlineOpacity","postWidthPx","postOverhangPx",
    "plateWPx","plateHPx","labelFontPx","labelMinPx","tGridSettleMs","drawDurMs","fillDelayMs",
    "tPostMs","postDurMs","holdMs"];
  for (const k of nums){ if (!Number.isFinite(cfg[k])) errors.push(k + " not finite"); }
  if (Number.isFinite(cfg.threshold) && Number.isFinite(cfg.total) && !(cfg.threshold < cfg.total))
    errors.push("threshold must be < total");
  if (Number.isFinite(cfg.labelFontPx) && Number.isFinite(cfg.labelMinPx) && cfg.labelFontPx < cfg.labelMinPx)
    errors.push("labelFontPx below labelMinPx floor");
  if (!(cfg.drawDurMs >= 0) || !(cfg.postDurMs >= 0) || !(cfg.holdMs >= 0) || !(cfg.fillDelayMs >= 0))
    errors.push("durations must be >= 0");
  if (!Array.isArray(cfg.regions) || cfg.regions.length === 0) errors.push("regions missing");
  const seen = new Map(); let sumA = 0, sumB = 0;
  for (const r of (cfg.regions || [])){
    if (!Number.isFinite(r.weight) || !Number.isFinite(r.startMs) || !Number.isFinite(r.fillEndMs))
      errors.push(r.id + " numeric field not finite");
    if (r.side === "A") sumA += r.weight; else if (r.side === "B") sumB += r.weight;
    else errors.push(r.id + " side must be A or B");
    const fs = fillStartMs(cfg, r), de = effStartMs(cfg, r) + cfg.drawDurMs;
    if (fs < de) errors.push(r.id + " fillStart " + fs + " before drawEnd " + de);
    if (!(fillDurMs(cfg, r) > 0)) errors.push(r.id + " fill duration must be > 0");
    for (const cell of (r.cells || [])){
      const key = cell[0] + "," + cell[1];
      if (seen.has(key)) errors.push("cell " + key + " owned by " + seen.get(key) + " and " + r.id);
      seen.set(key, r.id);
      if (cell[0] < 0 || cell[0] >= cfg.gridCols || cell[1] < 0 || cell[1] >= cfg.gridRows)
        errors.push(r.id + " cell " + key + " outside grid");
    }
  }
  if (sumA + sumB > cfg.total) errors.push("weight sums " + (sumA + sumB) + " exceed total " + cfg.total);
  return { ok: errors.length === 0, errors, sumA, sumB, ownedCells: seen.size };
}
function boundaryEdges(cells){
  const set = new Set(cells.map(c => c[0] + "," + c[1]));
  const edges = [];
  for (const [c, r] of cells){
    if (!set.has(c + "," + (r - 1))) edges.push([c, r, c + 1, r]);
    if (!set.has(c + "," + (r + 1))) edges.push([c, r + 1, c + 1, r + 1]);
    if (!set.has((c - 1) + "," + r)) edges.push([c, r, c, r + 1]);
    if (!set.has((c + 1) + "," + r)) edges.push([c + 1, r, c + 1, r + 1]);
  }
  return edges;
}
function stateAt(cfg, t){
  const d = derive(cfg);
  const ease = EASINGS[cfg.easing] || EASINGS.easeInOut;
  const regions = {}; let creditedA = 0, creditedB = 0, filledCells = 0, drawing = 0, drawn = 0;
  for (const r of cfg.regions){
    const ds = effStartMs(cfg, r), de = ds + cfg.drawDurMs;
    const fs = fillStartMs(cfg, r), fe = fillEndMs(cfg, r);
    const drawProgress = cfg.drawDurMs === 0 ? (t >= ds ? 1 : 0) : clamp01((t - ds) / cfg.drawDurMs);
    const fillRaw = clamp01((t - fs) / fillDurMs(cfg, r));
    const fillProgress = ease(fillRaw);
    const credited = t >= fe;
    if (credited){ if (r.side === "A") creditedA += r.weight; else creditedB += r.weight; }
    if (drawProgress > 0 && drawProgress < 1) drawing++;
    if (drawProgress >= 1) drawn++;
    filledCells += Math.floor(fillProgress * r.cells.length + 1e-9);
    regions[r.id] = { drawProgress, fillProgress, credited, fillStartMs: fs, fillEndMs: fe, drawStartMs: ds };
  }
  const ownedCells = cfg.regions.reduce((n, r) => n + r.cells.length, 0);
  const neverClaimed = cfg.gridCols * cfg.gridRows - ownedCells;
  const postProgress = cfg.postDurMs === 0 ? (t >= cfg.tPostMs ? 1 : 0) : clamp01((t - cfg.tPostMs) / cfg.postDurMs);
  return {
    t, regions, creditedA, creditedB, drawing, drawn,
    filledCells, pendingCells: ownedCells - filledCells, neverClaimed, ownedCells,
    gridCells: cfg.gridCols * cfg.gridRows,
    gridProgress: cfg.tGridSettleMs === 0 ? 1 : clamp01(t / cfg.tGridSettleMs),
    postProgress, postPresent: postProgress > 0,
    label: d.thresholdLabel, postXFraction: d.postXFraction,
    completeAtMs: d.completeAtMs, durationMs: d.durationMs,
    plateOpacity: 1.0, plateLayer: "top"
  };
}

</script>
<script id="t210-render">

/* ---------- renderer (DOM) ---------- */
(function(){
  const cfg = CONFIG;
  const diag = validateConfig(cfg);
  const d = derive(cfg);
  const svgNS = "http://www.w3.org/2000/svg";
  const svg = document.getElementById("scene");
  svg.setAttribute("viewBox", "0 0 " + cfg.stageW + " " + cfg.stageH);
  function el(name, attrs){ const e = document.createElementNS(svgNS, name); for (const k in attrs) e.setAttribute(k, attrs[k]); return e; }
  const ground = el("rect", {x:0, y:0, width:cfg.stageW, height:cfg.stageH, fill:cfg.palette.ground});
  svg.appendChild(ground);
  const gFill = el("g", {}), gCells = el("g", {}), gOut = el("g", {}), gPost = el("g", {});
  svg.appendChild(gFill); svg.appendChild(gCells); svg.appendChild(gOut); svg.appendChild(gPost);
  // grid cells (substrate squares)
  const cellRects = [];
  for (let r = 0; r < cfg.gridRows; r++) for (let c = 0; c < cfg.gridCols; c++){
    const x = d.fieldX + c * d.pitch + d.gapPx/2, y = d.fieldY + r * d.pitch + d.gapPx/2;
    const rect = el("rect", {x:x, y:y, width:d.cellPx, height:d.cellPx, fill:cfg.palette.cell});
    gCells.appendChild(rect); cellRects.push(rect);
  }
  // per-region fill cell rects + outline edge lines
  const regionViews = {};
  for (const r of cfg.regions){
    const fillRects = r.cells.map(([c, rr]) => {
      const x = d.fieldX + c * d.pitch, y = d.fieldY + rr * d.pitch;
      const rect = el("rect", {x:x, y:y, width:d.pitch, height:d.pitch,
        fill: r.side === "A" ? cfg.palette.sideA : cfg.palette.sideB, opacity: cfg.fillOpacity, "display":"none"});
      gFill.appendChild(rect); return rect;
    });
    const edges = boundaryEdges(r.cells).map(([x1,y1,x2,y2]) => {
      const line = el("line", {x1: d.fieldX + x1*d.pitch, y1: d.fieldY + y1*d.pitch,
        x2: d.fieldX + x2*d.pitch, y2: d.fieldY + y2*d.pitch,
        stroke: r.side === "A" ? cfg.palette.sideA : cfg.palette.sideB,
        "stroke-width": cfg.outlineWidthPx, opacity: cfg.outlineOpacity, "display":"none"});
      gOut.appendChild(line); return line;
    });
    regionViews[r.id] = { fillRects, edges };
  }
  // post + plate (top layer)
  const postX = d.fieldX + d.postXFraction * d.fieldW;
  const postFullH = d.fieldH + 2 * cfg.postOverhangPx;
  const postY = d.fieldY - cfg.postOverhangPx;
  const postRect = el("rect", {x: postX - cfg.postWidthPx/2, y: postY, width: cfg.postWidthPx, height: 0, fill: cfg.palette.post});
  gPost.appendChild(postRect);
  const plateY = d.fieldY + d.fieldH/2 - cfg.plateHPx/2;
  const plateRect = el("rect", {x: postX - cfg.plateWPx/2, y: plateY, width: cfg.plateWPx, height: cfg.plateHPx,
    fill: cfg.palette.plate, opacity: 1.0, stroke: cfg.palette.post, "stroke-width": 2, "display":"none"});
  const plateText = el("text", {x: postX, y: plateY + cfg.plateHPx/2, "text-anchor":"middle", "dominant-baseline":"central",
    "font-size": cfg.labelFontPx, "font-weight": "bold", fill: cfg.palette.plateInk, "display":"none"});
  plateText.textContent = d.thresholdLabel;
  gPost.appendChild(plateRect); gPost.appendChild(plateText);
  // No tally readouts: the specimen shows no numeric readouts on this map — the map IS the count
  // (plan §2.1/§1.3: identity and tally are carried by the fills and the post plate only).
  let clockMs = 0;
  function render(t){
    clockMs = t;
    const s = stateAt(cfg, t);
    gCells.setAttribute("opacity", s.gridProgress);
    for (const r of cfg.regions){
      const v = regionViews[r.id], st = s.regions[r.id];
      const nFill = Math.floor(st.fillProgress * r.cells.length + 1e-9);
      v.fillRects.forEach((rect, i) => rect.setAttribute("display", i < nFill ? "" : "none"));
      const nEdge = Math.floor(st.drawProgress * v.edges.length + 1e-9);
      v.edges.forEach((line, i) => line.setAttribute("display", i < nEdge ? "" : "none"));
    }
    postRect.setAttribute("height", s.postProgress * postFullH);
    const showPlate = s.postProgress > 0 ? "" : "none";
    plateRect.setAttribute("display", showPlate); plateText.setAttribute("display", showPlate);
    document.getElementById("clock").textContent = (t/1000).toFixed(1) + "s / " + (s.durationMs/1000).toFixed(1) + "s";
  }
  let playing = false, lastTs = null;
  function frame(ts){
    if (!playing) return;
    if (lastTs === null) lastTs = ts;
    clockMs = Math.min(clockMs + (ts - lastTs), d.durationMs); lastTs = ts;
    render(clockMs);
    if (clockMs < d.durationMs) requestAnimationFrame(frame); else playing = false;
  }
  document.getElementById("play").addEventListener("click", () => {
    if (clockMs >= d.durationMs) clockMs = 0;
    playing = true; lastTs = null; requestAnimationFrame(frame);
  });
  document.getElementById("pause").addEventListener("click", () => { playing = false; });
  document.getElementById("restart").addEventListener("click", () => { clockMs = 0; render(0); playing = true; lastTs = null; requestAnimationFrame(frame); });
  window.__T210 = { CONFIG: cfg, stateAt: t => stateAt(cfg, t), validateConfig: () => validateConfig(cfg),
    derive: () => derive(cfg), diagnostics: diag, seek: ms => { playing = false; render(Math.max(0, Math.min(ms, d.durationMs))); } };
  render(0);
})();

</script>
</body>
</html>


