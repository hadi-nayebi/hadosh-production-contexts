   231	/* ================= validation / normalization ========================= */
   232	function strictInt(v) { return /^-?\d+$/.test(String(v).trim()) ? parseInt(v, 10) : null; }
   233	function strictNum(v) { return /^-?\d+(\.\d+)?$/.test(String(v).trim()) ? parseFloat(v) : null; }
   234	function isColor(v) { return /^#[0-9a-fA-F]{6}$/.test(String(v).trim()) || /^#[0-9a-fA-F]{3}$/.test(String(v).trim()); }
   235	function validateInto(cfg, warnings) {
   236	  const W = function (m) { warnings.push(m); };
   237	  const clampInt = function (obj, key, lo, hi) {
   238	    const v = strictInt(obj[key]);
   239	    if (v === null) { W(key + ": non-integer value discarded"); return false; }
   240	    const c = Math.max(lo, Math.min(hi, v));
   241	    if (c !== v) W(key + ": clamped " + v + " -> " + c);
   242	    obj[key] = c; return true;
   243	  };
   244	  /* null/absent groups reset before any group is read */
   245	  if (!cfg.labels || typeof cfg.labels !== "object") { W("labels: malformed, reset to default"); cfg.labels = JSON.parse(JSON.stringify(CONFIG.labels)); }
   246	  if (!cfg.typography || typeof cfg.typography !== "object") { W("typography: malformed, reset to default"); cfg.typography = JSON.parse(JSON.stringify(CONFIG.typography)); }
   247	  if (!cfg.layout || typeof cfg.layout !== "object") { W("layout: malformed, reset to default"); cfg.layout = JSON.parse(JSON.stringify(CONFIG.layout)); }
   248	  if (!cfg.artViewBox || typeof cfg.artViewBox !== "object") { W("artViewBox: malformed, reset to default"); cfg.artViewBox = JSON.parse(JSON.stringify(CONFIG.artViewBox)); }
   249	  if (!cfg.palette || typeof cfg.palette !== "object") { W("palette: malformed, reset to default"); cfg.palette = JSON.parse(JSON.stringify(CONFIG.palette)); }
   250	  if (!cfg.limits || typeof cfg.limits !== "object") { W("limits: malformed, reset to default"); cfg.limits = JSON.parse(JSON.stringify(CONFIG.limits)); }
   251	  ["maxPanels", "maxCols", "headerMaxChars", "titleMaxChars", "numberMaxChars", "clampMaxIterations", "borderClampStep"].forEach(function (k) {
   252	    if (!Number.isInteger(cfg.limits[k]) || cfg.limits[k] < 1 || cfg.limits[k] > 100000) { W("limits." + k + ": invalid, reset to default"); cfg.limits[k] = CONFIG.limits[k]; }
   253	  });
   254	  clampInt(cfg, "dwellMs", 0, 60000); clampInt(cfg, "diveMs", 0, 10000);
   255	  clampInt(cfg, "holdZoomMs", 0, 60000); clampInt(cfg, "loopPauseMs", 0, 60000);
   256	  clampInt(cfg, "colsWide", 1, cfg.limits.maxCols); clampInt(cfg, "colsNarrow", 1, cfg.limits.maxCols);
   257	  clampInt(cfg, "narrowBreakpointPx", 200, 2000);
   258	  clampInt(cfg, "gapPx", 0, 40); clampInt(cfg, "borderPx", 0, 12);
   259	  const ds = strictNum(cfg.diveScale);
   260	  if (ds === null || ds < 1 || ds > 12) { W("diveScale: invalid, reset to default"); cfg.diveScale = CONFIG.diveScale; }
   261	  const pa = strictNum(cfg.panelAspect);
   262	  if (pa === null || pa < 0.5 || pa > 3) { W("panelAspect: invalid, reset to default"); cfg.panelAspect = CONFIG.panelAspect; }
   263	  if (typeof cfg.headerText !== "string" || !cfg.headerText.length) { W("headerText: empty, reset to default"); cfg.headerText = CONFIG.headerText; }
   264	  if (cfg.headerText.length > cfg.limits.headerMaxChars) W("headerText: truncated to " + cfg.limits.headerMaxChars + " characters");
   265	  cfg.headerText = cfg.headerText.slice(0, cfg.limits.headerMaxChars);
   266	  Object.keys(cfg.palette).forEach(function (k) {
   267	    if (!isColor(cfg.palette[k])) { W("palette." + k + ": invalid color, reset to default"); cfg.palette[k] = CONFIG.palette[k]; }
   268	    else cfg.palette[k] = String(cfg.palette[k]).trim();
   269	  });
   270	  /* the progress/ceilings groups are validated BEFORE the registry
   271	     cleaning below, because the primitive schema consumes cfg.ceilings */
   272	  if (!cfg.progress || typeof cfg.progress !== "object") { W("progress: malformed, reset to default"); cfg.progress = JSON.parse(JSON.stringify(CONFIG.progress)); }
   273	  if (typeof cfg.progress.forceFillTarget === "string") cfg.progress.forceFillTarget = cfg.progress.forceFillTarget.trim();
   274	  if (["mark", "fill"].indexOf(cfg.progress.forceFillTarget) === -1) { W("progress.forceFillTarget: invalid, reset to default"); cfg.progress.forceFillTarget = CONFIG.progress.forceFillTarget; }
   275	  const earlyGuard = function (obj, key, lo, hi, def) {
   276	    const v = strictNum(obj[key]);
   277	    if (v === null || v < lo || v > hi) { W(key + ": out of range, reset to default"); obj[key] = def; }
   278	  };
   279	  earlyGuard(cfg.progress, "targetOutlinePx", 0, 12, CONFIG.progress.targetOutlinePx);
   280	  if (!cfg.ceilings || typeof cfg.ceilings !== "object") { W("ceilings: malformed, reset to default"); cfg.ceilings = JSON.parse(JSON.stringify(CONFIG.ceilings)); }
   281	  ["maxGridCells", "maxCirclesRowCount", "maxGraphNodes", "maxGraphEdges"].forEach(function (k) {
   282	    if (!Number.isInteger(cfg.ceilings[k]) || cfg.ceilings[k] < 1 || cfg.ceilings[k] > 10000) { W("ceilings." + k + ": invalid, reset to default"); cfg.ceilings[k] = CONFIG.ceilings[k]; }
   283	  });
   284	  earlyGuard(cfg.layout, "minStagePx", 120, 2000, CONFIG.layout.minStagePx);
