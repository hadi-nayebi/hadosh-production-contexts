   140	function labelLayout(cfg, cEx, cLx){
   141	  // Both timeline labels sit on one baseline under their drop feet; if their CONFIG-box widths
   142	  // would overlap, they shift apart symmetrically (clamped to the stage) — diagram collision
   143	  // resolution driven only by CONFIG text + font keys.
   144	  const wA = cfg.timelineLabelA.length * cfg.labelFontPx * cfg.labelWidthFrac;
   145	  const wB = cfg.timelineLabelB.length * cfg.labelFontPx * cfg.labelWidthFrac;
   146	  let ax = cEx, bx = cLx;
   147	  const sep = () => (ax - wA / 2) - (bx + wB / 2);
   148	  if (sep() < 0){
   149	    const ov = -sep();
   150	    ax = Math.min(ax + ov / 2, cfg.stageW - wA / 2 - 4);
   151	    bx = Math.max(bx - ov / 2, wB / 2 + 4);
   152	    if (sep() < 0){ ax = Math.min(ax - sep(), cfg.stageW - wA / 2 - 4); }
   153	    if (sep() < 0){ bx = Math.max(bx + sep(), wB / 2 + 4); }
   154	  }
   155	  return { ax, bx, wA, wB };
   156	}
