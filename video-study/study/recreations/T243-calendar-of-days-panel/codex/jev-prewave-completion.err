   191	  }
   192	  const fx = cfg.figureCx, fs = cfg.figureScale, fy = cfg.timelineY;
   193	  const starPts = cfg.figureStarPts.map(pt => (fx + pt[0] * fs) + "," + (fy + pt[1] * fs)).join(" ");
   194	  s += `<g opacity="${st.gridP}" stroke="${P.ink}" fill="none" stroke-width="${cfg.figureStrokePx}">`;
   195	  s += `<circle cx="${fx}" cy="${fy - (cfg.figureBodyTop + cfg.figureHeadR + cfg.figureHeadGap) * fs}" r="${cfg.figureHeadR * fs}"/>`;
   196	  s += `<path d="M ${fx - cfg.figureBodyW * fs} ${fy} L ${fx - cfg.figureBodyW * fs} ${fy - cfg.figureShoulderY * fs} Q ${fx - cfg.figureBodyW * fs} ${fy - cfg.figureBodyTop * fs} ${fx} ${fy - cfg.figureBodyTop * fs} Q ${fx + cfg.figureBodyW * fs} ${fy - cfg.figureBodyTop * fs} ${fx + cfg.figureBodyW * fs} ${fy - cfg.figureShoulderY * fs} L ${fx + cfg.figureBodyW * fs} ${fy} M ${fx} ${fy - cfg.figureLegY * fs} L ${fx} ${fy}"/>`;
   197	  s += `<polygon points="${starPts}" fill="${P.ink}" stroke="none"/>`;
   198	  s += `</g>`;
   199	  const labelWithStrike = (txt, cx, strikeP) => {
   200	    const w = txt.length * cfg.labelFontPx * cfg.labelWidthFrac, y = cfg.timelineY + cfg.labelDyPx;
   201	    let g = `<text x="${cx}" y="${y}" font-size="${cfg.labelFontPx}" fill="${P.ink}" text-anchor="middle">${txt}</text>`;
   202	    if (strikeP > 0){
   203	      const x1 = cx - w / 2;
   204	      const ex = cx - w / 2 + w * strikeP;
   205	      g += `<line x1="${x1}" y1="${y - cfg.labelFontPx * cfg.labelStrikeTopFrac}" x2="${ex}" y2="${y + cfg.labelStrikeDyPx}" stroke="${P.strike}" stroke-width="${cfg.labelStrikeStrokePx}"/>`;
   206	      g += `<line x1="${x1}" y1="${y + cfg.labelStrikeDyPx}" x2="${ex}" y2="${y - cfg.labelFontPx * cfg.labelStrikeTopFrac}" stroke="${P.strike}" stroke-width="${cfg.labelStrikeStrokePx}"/>`;
   207	    }
   208	    return g;
   209	  };
   210	  const lay = labelLayout(cfg, cE.x, cL.x);
   211	  s += `<g opacity="${st.labelAO}">${labelWithStrike(cfg.timelineLabelA, lay.ax, st.labelAStrikeP)}</g>`;
   212	  s += `<g opacity="${st.labelBO}">${labelWithStrike(cfg.timelineLabelB, lay.bx, st.labelBStrikeP)}</g>`;
